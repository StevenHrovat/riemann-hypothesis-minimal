he determinant are l-adic units. -/\n\n\nvariable {E} [Field E] [CMType E] {q l c d k : ℕ} {n} [Fintype n] [Fact l.Prime] {ι : ℂ →+* ℂ_[l]}\n  {g : Gf E n}\n\nlemma div_mem_integralAway (h : c ∣ d * q ^ k) : (d / c : ℂ) ∈ integralAway q := fun l _ c ↦ by\n  simp [by simpa [c.norm_natCast_eq_one] using congr(‖($h.choose_spec : ℂ_[l])‖)]; bound\n    [natCast_mem (valRingCp l)]\n\nomit [Fact l.Prime] in\nlemma localLevel_le_integralAbove_of_coprime (hl : l.Coprime q) : localLevel n {w : FinPlace E\n  | ↑q ∉ w.1} ≤ integralAbove n l := fun _ h w ↦ h w ∘ w.2.notMem_of_isCoprime_of_mem hl.cast\n\nlemma Parameters.norm_finMultiplier_eq_one [WeilData E] (hg : g ∈ integralAbove n l) : ‖ι\n  (finMultiplier g)‖ = 1 := by simp_all (maxDischargeDepth := 4) [finMultiplier, glMultiplier,\n  WeilData.norm_map_chiFin, localLevel, Gf.atPlace, (norm_adeleExtension_eq_iff _ 1).2,\n  Sat.v_det_saturatingElem rfl ∘ .of_mem, mem_subring_matrix_iff, mem_intGL]\n\nlemma AutChar.HasWeight.norm_padic_det {a : AutChar E} {e ψ s} [ha : a.HasWeight e ψ] (hg :\n  g ∈ integralAbove n l) : ‖ι (a.1 (detFin s g))‖ = 1 := by simp [ha.norm_padic_eq_prod,\n  funext_iff, ↓(norm_adeleExtension_eq_iff _ 1).2, mem_intGL_iff_det.1 (hg ..)]\n"),("src/New/Seesaw/LatticeAndTorsionDefs.lean","import Lib.CM.Sigma.PadicSeriesDefs\nimport Lib.Weil.Periods.DegreeAndUnipotent\n\n/-! Set-up for this proof: records of the data and parameters of this proof, names for its objects.\n\nPart of: Seesaw identity for a chain of theta lifts (see New.Seesaw.SeesawTheorem).\n\nThis file: Lattice basis `gradedLatticeBasis`, admissible combinations of translates with controlled\ndenominators and size. -/\n\nopen Matrix\n\n/-- A basis matrix with string rows multiplied by u: for odd s the identity with column e\nreplaced by e/π̄ + z/(ππ̄) (e last in X, z middle); for even s diag(1; a⁻¹, …, a⁻¹, ā, …,\nā). -/\nnoncomputable def gradedLatticeBasis {R X' ι : Type*} {s} [CommRing R] [StarRing R] (e :\n  (X' ⊕ Unit) ⊕ Fin s ≃ ι) (a π : Rˣ) (u : unitary R) := reindex e e (fromBlocks (ite (Odd s)\n  (diagonal (1 ⊕ᵥ fun _ ↦ (star π)⁻¹.1)) 1) 0 (of fun b ↦ 0 ⊕ᵥ fun _ ↦ ite (b = b.rev)\n  (u * (star π * π)⁻¹.1) 0) (diagonal fun b ↦ u * ite (Odd s) 1 (ite (2 * b < s) a⁻¹.1 (star a))))\n\nvariable {E X' ι : Type*} [Field E] [CMType E] (q : ℕ)\n\n/-- The condition that the finite frame x_f of V spans the same Ô-lattice as `gradedLatticeBasis`:\nx_f = gradedLatticeBasis·k for some k in GL(Ô). -/\ndef Grading.SpansLattice [Fintype ι] {ε s N} {V : Space E ι ε} (Y : Grading V N (X' ⊕ _) s) a π u :=\n  ∃ k ∈ intGL ι (Ô E), V.xFin.1 = gradedLatticeBasis Y.indexEquiv a π u * k.1\n\n/-- The subring of complex numbers whose image under every ring homomorphism ℂ → ℂ_l is\nintegral, for every prime l coprime to n. -/\ndef integralAway n := (by use! {z | ∀ l [Fact l.Prime], l.Coprime n → ∀ ι : _ →+* ℂ_[l], ‖ι z‖ ≤\n        1} <;> simp <;> grind [mul_le_one₀, IsUltrametricDist.norm_add_le_max] : Subring ℂ)\n\n/-- The conditions on a finitely supported r: support in A, each d·r(x) integral away from n\nand, if p holds, ∑|σ r(x)| ≤ B for all automorphisms σ of ℂ. -/\nstructure IsAdmissibleCoeffs {X} (A : Set X) (n d : ℕ) (p : Prop) B (r : X →₀ ℂ) where\n  support_subset : ∀ x ∈ r.support, x ∈ A\n  integral x : d * r x ∈ integralAway n\n  size_le : p → ∀ σ : ℂ ≃+* ℂ, r.sum (fun _ ↦ (‖σ ·‖)) ≤ B\n\nsection\n\nvariable {E ι : Type*} [Field E] [NumberField E] (q : ℕ)\n\n/-- The group of finite adelic vectors x such that d_i x_i is integral at every place not\ndividing q, for each index i. -/\ndef weightedTranslations (d : ι → 𝔸f E) : AddSubgroup (ι → 𝔸f E) :=\n  ⟨⟨⟨{x | ∀ i (w : FinPlace E), ↑q ∉ w.1 → Valued.v\n  ((d i * x i) w) ≤ 1}, by simp_all [-map_mul, mul_add, Valued.v.map_add_le]⟩, by simp⟩, by simp⟩\n\n/-- The group of finite adelic vectors x indexed by ι such that d·x is integral at every place\nnot dividing q. -/\nabbrev translations ι q d := weightedTranslations (E := E) q fun _ : ι ↦ d\n\nend\n\n/-- N = π·π̄ for the finite idele π, which is a uniformiser at the places of P and a unit\nelsewhere, and P is disjoint from its conjugate. -/\ndef IsSplitSquarefree (P : Finset (FinPlace E)) (N : E) (π : (𝔸f E)ˣ) := ↑N = π * star π.1 ∧ ∀ w,\n  Valued.v (π.1 w) = ite (w ∈ P) (.exp (-1)) 1 ∧ (w ∈ P → star w ∉ P)\n"),("src/New/Seesaw/LiftCharacters.lean","import New.Curve.JetDivisibility\nimport New.Columns.ChainValuation\n\n/-! Set-up for this proof: dictionaries between two encodings of the same objects.\n\nPart of: Trading denominators at the level prime for a column operator (see\nNew.Columns.TwistedHeckeType).\n\nThis file: Column level at N read as conjugated mirabolic group; restriction keeps valuation, size.\nIndex bound at N for preimage of the lattice under the Gauss-sum operator power. Splitting\ncharacters of the chain: unramified above the level prime, double splitting. -/\nseal Finset.univ Finset.sum Finset.prod\n\nopen Finset Fintype Gf IsSplitLevel Matrix NeZero Valued WithZero Equiv\n\nattribute [-simp] WithZero.inv_exp\n\nvariable {P} (D : Data P) {p : ℕ} [Fact p.Prime] [PadicPlace p]\n\nlemma Data.GaugeLe.restrictToY_of_diag {d : Gf _ _} (hs : ∀ τ, .map (adeleExtension (weightEmbedding\n  ιₚ τ)) d.1 = diagGL (ite ·.isLeft 1 (ite (star (inducedPlace τ) ∈ D.piPlaces) (.mk0 ↑D.N out) 1)))\n  {c φ} (h : GaugeLe d c φ) : GaugeLe 1 c (D.restrictToY φ) := fun g ↦\n  ((one_mul _).trans_le (h (D.borderU g))).trans' (Eq.trans_le (by\n  erw [mulVec_mulVec, D.branching.2.1 _ _ fun τ ↦ (d.1.map (adeleExtension (weightEmbedding ιₚ\n    τ))).det⁻¹, smul_mulVec, ← mulVec_mulVec, Units.smul_def, norm_smul, weylGauge_smul]\n  use congr($(?_) * ‖_ *ᵥ $(funext (by simp [mulVec_eq_sum]))‖)\n  simpa [hs, apply_ite, @starRingEnd_apply D.E, branchExp] using congr(∏ τ :\n    D.Φ, $((isEquiv_placeOfEmb\n    (weightEmbedding ιₚ τ)).eq_iff (s := ite _ D.N 1) |>.2 (by split <;> simp_all\n    [inducedPlace, placeOfEmb_comp_star, ← v_algebraMap_eq_valuation, v_algebraMap_eq_intValuation,\n    i