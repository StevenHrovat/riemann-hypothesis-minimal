xProd hs (V₁.integrated v₁ f₁)\n  (V₂.integrated v₂ f₂) = V.integrated (realBoxProd (realSigns_comp_split hs) v₁ v₂)\n  (boxProd hs f₁ f₂) := by erw [map_integrated _ ((boxProd hs).flip _),\n  map_integrated _ (boxProd hs _), eq_comm, integrated_tmul] <;>\n  simp [left, right, rho_boxProd, realVec, realCoordSum, comp_def, ← Pi.zero_def, ← Prod.zero_eq_mk]\n\ninclude hs h\n\n/-- The multiplier Δ is multiplicative on blocks: if the coordinates split compatibly with the\nsigns and g is block diagonal with blocks g₁, g₂ in the adelic unitary groups of the parts,\nthen Δ(g) = Δ(g₁)Δ(g₂). -/\nlemma weilMultiplier_fromBlocks : weilMultiplier g = weilMultiplier g₁ * weilMultiplier g₂ := by\n  erw [mul_mul_mul_comm, ← Finset.prod_mul_distrib, ← glMultiplier_fromBlocks _ _ e.symm]\n  simp [weilMultiplier, realMultiplier, ← principalMinor_submatrix e,\n    ← map_mul]; congr!; convert principalMinor_fromBlocks <;> try infer_instance\n  repeat simp_all [← ext_iff, Prod.ext_iff, _root_.funext_iff, reindex_equiv e]\n\n/-- If the matrix of g is block diagonal with blocks g₁, g₂ for a sign-compatible splitting of\nthe coordinates, then ω(g)(f₁ ⊠ f₂) = ω(g₁)f₁ ⊠ ω(g₂)f₂. -/\nlemma Space.omega_boxProd f₁ f₂ : V.ω g (boxProd hs f₁ f₂) =\n  boxProd hs (V₁.ω g₁ f₁) (V₂.ω g₂ f₂) := by\n  apply_rules [weilRep_tmul, weilMultiplier_fromBlocks]\n  ext1; erw [e.eq_comp_symm, ← submatrix_mulVec_equiv, h, fromBlocks_mulVec]; aesop\n"),("src/Lib/Weil/Construction/FiniteHeisenberg.lean","import Lib.Weil.Construction.AdelicHeisenberg\n\n/-! Part of: Adelic Weil representation of a unitary group and the invariant theta functional (known\nresult; see Lib.Weil.DualPair.PairSplitting).\n\nThis file: Finite adelic Heisenberg group, self-dual lattice, additive character, semicharacter and\nvacuum. -/\n\nnoncomputable section\n\nnamespace stdLattice\n\nopen NumberField Matrix AddChar Circle WeilData\nvariable (E ι : Type _) [Field E] [CMType E] [WeilData E] [Fintype ι]\n\n/-- The standard lattice Ô^ι, as an additive subgroup of the finite adelic vectors indexed by ι. -/\ndef _root_.stdLattice (E ι : Type _) [Field E] [NumberField E] :\n    AddSubgroup (ι → 𝔸f E) := (intVectors (Ô E) ι).toAddSubgroup\n\n/-- The complex-valued additive character u ↦ ψ_f(ȷαᾱu) of the finite adeles of E, with ȷ and α\nfrom the Weil data. -/\ndef psi₀ := coeHom.compAddChar ((ψf E).mulShift (algebraMap E _ j * α.1 * star α.1))\n\nvariable {E ι}\n\n/-- The integer c₀ of the Weil data (c₀ + c̄₀ = 1), viewed as a finite adele of E. -/\ndef traceOneAdele : 𝔸f E := (WeilData.traceOne : E)\n\n/-- The number ½, viewed as a finite adele of E. -/\ndef half {E : Type _} [Field E] [NumberField E] : 𝔸f E := (2⁻¹ : E)\n\nlemma psi₀_apply z : psi₀ E z = ψf E (algebraMap E _ j * α.1 * star α.1 * z) := rfl\n\n@[simp] lemma norm_psi₀ z : ‖psi₀ E z‖ = 1 := norm_coe _\n\n@[fun_prop] lemma continuous_psi₀ : Continuous (psi₀ E) :=\n  continuous_ψf.subtype_val.comp (continuous_const_mul _)\n\nlemma psi₀_star z : psi₀ E (star z) = psi₀ E (-z) := by simp [psi₀, ψf_star (-_), mul_right_comm]\n\n/-- Self-duality of Ô: a finite adele z satisfies ψ₀(zu) = 1 for all u in Ô if and only if z\nlies in Ô, where ψ₀ = ψ_f(ȷαᾱ·). -/\nlemma forall_psi₀_mul_eq_one_iff z : (∀ u ∈ Ô E, psi₀ E (z * u) = 1) ↔\n  z ∈ Ô E := by simpa [psi₀_apply, ← mul_rotate' _ _ z, coe_eq_one, forall_ψf_mul_eq_one] using\n  ((exists_reduction_and_idele_generator differentIdeal_ne_bot).elim fun _ ⟨_, _, t,\n  _, h, H⟩ ↦ (H _).trans (by simp [mem_Ô, h, -WithZero.inv_exp, WithZero.exp_neg,\n    by simpa using ‹WeilData E›.self_dual]))\n\nlemma traceOneAdele_mem : traceOneAdele ∈ Ô E := algebraMap_mem_Ô.2 isIntegral_traceOne\n\n/-- The element c₀ of the Weil data, viewed as a finite adele, satisfies c₀ + c̄₀ = 1. -/\n@[simp] lemma traceOneAdele_add_star : traceOneAdele + star traceOneAdele = (1 :\n  𝔸f E) := by simp [traceOneAdele, WeilData.traceOne, ← map_add, ← add_div]\n\nomit [WeilData E] in\nlemma two_mul_half : 2 * half = (1 : 𝔸f E) := by norm_num [half, two_mul, ← map_add]\n\nomit [WeilData E] in\nlemma star_half : star half = @half E .. := by simp [half]\n\nattribute [grind .] traceOneAdele_add_star two_mul_half star_half\n\nlemma psi₀_eq_one_of_mem {o} : o ∈ Ô E →\n  psi₀ E o = 1 := by grind [forall_psi₀_mul_eq_one_iff, (Ô E).one_mem]\n\nlemma psi₀_congr {a b o} t : o ∈ Ô E → a = b + (t + star t) + o → psi₀ E a = psi₀ E b := by\n  simp_all [map_add_eq_mul, psi₀_star, ← map_add_eq_mul _, psi₀_eq_one_of_mem]\n\n/-- For a finite adelic vector x, the complex number sc(x) = ψ_f(½c₀ȷαᾱ x*x). -/\ndef semichar (x : ι → _) := psi₀ E (traceOneAdele * half * star x ⬝ᵥ x)\n\n/-- The finite vacuum: the function on finite adelic vectors equal to ψ_f(½c₀ȷαᾱ x*x) for x in\nÔ^ι and to 0 otherwise. -/\ndef finVac x := ite (x ∈ stdLattice E ι) (delta% semichar x) 0\n\nvariable (E ι)\n\n/-- The Heisenberg datum on finite adelic vectors indexed by ι with bicharacter β(x,y) =\nψ_f(½ȷαᾱ y*x). -/\ndef finHeis : Heisenberg (ι → 𝔸f E) := by refine ⟨fun x y ↦ psi₀ E (half * star y ⬝ᵥ x), ?_, ?_,\n  fun x ↦ (psi₀ E).2 ▸ psi₀_congr (traceOneAdele * half * star x ⬝ᵥ x) (zero_mem\n  _) ?_, ?_, by fun_prop⟩ <;> simp [mul_add, map_add_eq_mul, half, ← star_dotProduct, ← add_mul]\n"),("src/Lib/Weil/Construction/FiniteMultiplier.lean","import Lib.Weil.Unramified.HeckeGL\nimport Lib.Adelic.Witt.SpaceOperations\nimport Lib.Weil.Construction.FiniteVacuum\n\n/-! Part of: Adelic Weil representation of a unitary group and the invariant theta functional (known\nresult; see Lib.Weil.DualPair.PairSplitting).\n\nThis file: Finite multiplier of the splitting through saturating matrices; multiplicativity, phase,\nlattice index. -/\n\nnoncomputable section\n\n\nsection\n\nvariable {E ι κ B B' : Type*} [Ring B] [Ring B'] (S : Subring B) (g u : Bˣ)\n\n/-- For a subring S and units g, u of a ring: u and gu lie in S and lu + m·gu = 1 for some l, m\nin S. For matrices this says uΛ = Λ ∩ g⁻¹Λ. -/\ndef Sat := ↑u ∈ S ∧ g.1 * u ∈ S ∧ ∃ l ∈ S, ∃ m ∈ S, u⁻¹ = l + m * g\n\nvariable {S g u}\nattribute [local simp] Sat add_mul mul_assoc Circle.norm_coe RingHom.map_det IsConcreteLE.le_iff\n\nlemma Sat.inv_mul_mem x p : Sat S g u → x ∈ S ∧ g * x ∈ S ∧ p → u⁻¹ * x ∈ S := by aesop\n\nlemma Sat.map_of_le_comap (h : Sat S g u) (f : B →+* B') {S'} : S ≤ .comap f S' → Sat S' (g.map f)\n    (u.map f) := by simp_all; grind\n\nlemma Sat.of_mem : ↑g ∈ S → Sat S g 1 := by aesop\n\nopen MeasureTheory Matrix ComplexConjugate NumberField GeneralLinearGroup WeilData stdLattice Valued\n  Sat\nvariable [Field E] [NumberField E] [Fintype ι] [Fintype κ] {g u b b' k k' : GL ι (𝔸f E)} (w :\n  FinPlace E)\n\n@[local simp] lemma mem_subring_matrix_iff {x} : x ∈ S.matrix ↔ ∀ i j : ι, x i j ∈ S := .rfl\n\nlemma ideleAbs_locFullIdele x : ideleAbs (locFullIdele w x) = ‖x.1‖ := finIdeleAbs_locIdele x\n\nvariable {w} (g)\n\n/-- Every invertible matrix g over the finite adeles has an invertible u related to it by\n`Sat` over integral matrices, the relation expressing uÔ^ι = Ô^ι ∩ g⁻¹Ô^ι. -/\nlemma Sat.exists_saturating : ∃ u, Sat (Ô E).matrix g u :=\n  (isValuationPair_Ohat.exists_isPrimitiveMatrix_mul (X := (diagonal 1).fromRows\n  g.1) ⟨fromCols 1 0, by simp⟩).imp fun u ⟨_, _, L, _⟩ ↦ by use ?_, ?_, L.toCols₁, ?_, L.toCols₂,\n  ?_, (u.inv_eq_of_mul_eq_one_left ?_) <;> simp_all [IsIntMatrix, ← fromCols_mul_fromRows]\n\n/-- For g in GL_ι(𝔸_f), a chosen u in GL_ι(𝔸_f) with u and gu integral and u⁻¹ = l + mg for some\nintegral matrices l, m (`Sat`). -/\ndef saturatingElem := (nonempty_subtype.2 (Sat.exists_saturating g)).some\n\nlemma Sat.map_evalAt (h : Sat (Ô E).matrix b u) w : Sat (LocInt w).matrix (b.map (evalAt w))\n    (u.map (evalAt w)) := h.map_of_le_comap (evalAt w).mapMatrix (by simp_intro _ _ [Ô])\n\nend\n\nattribute [local simp] Sat add_mul mul_assoc Circle.norm_coe RingHom.map_det IsConcreteLE.le_iff\n\nopen MeasureTheory Matrix ComplexConjugate NumberField GeneralLinearGroup WeilData stdLattice Valued\n  Sat\n\nattribute [local simp] mem_subrin