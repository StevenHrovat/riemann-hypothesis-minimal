he O-submodule M into itself. -/\ndef endPreserving {W} [AddCommGroup W] [Module ℂ W] [Module EllAdicIntegers W]\n  [IsScalarTower EllAdicIntegers ℂ W] (M : Submodule EllAdicIntegers W) :\n  Subalgebra EllAdicIntegers (Module.End ℂ W) := by use! {T | ∀ f ∈ M, T f ∈ M} <;> aesop\n\nvariable {E n} [Field E] [CMType E] [Fintype n] {V : Space E n 1} {κ}\n\n/-- The O-algebra of operators on forms generated by the right translations by elements of G_f\nsupported at w and w̄. -/\ndef localGroupAlgebra (w : FinPlace E) :=\n  adjoin EllAdicIntegers (V.formTranslation κ '' supportedOn n {w})\n\nvariable (V κ)\n\n/-- The forms that, if w is split, are spherical at w with T_{w,j} f = t_j f for all j; all\nforms if w is not split. -/\ndef eigenformsAt w (t : ℕ → ℂ) := ⨅ hw, sphericalAt (V.formTranslation κ) w ⊓ ⨅ j,\n  (heckeSplit (V.formTranslation κ) (w := w) hw j).eqLocus (t j • .id)\n\n/-- Isotypic spaces: for a system t of eigenvalues at all places, the space (possibly zero) of\nforms that are spherical eigenforms with eigenvalues t_w at almost all split w. -/\ndef Isotypic :=\n  {x : Submodule ℂ _ // ∃ t : _ → _, ∀ f, f ∈ x ↔ ∀ᶠ w in cofinite, f ∈ eigenformsAt V κ w (t w)}\n\nvariable {V κ S a f v w t} (x : Isotypic V κ)\n\n/-- A chosen system of Hecke eigenvalues, one sequence for each finite place, whose isotypic\nspace is x. -/\nabbrev Isotypic.heckeEigenvalues := x.2.choose\n\n/-- The Hecke polynomial at w, of degree the rank n, formed from the chosen eigenvalues of the\nisotypic space x at w. -/\nabbrev Isotypic.heckePolyAt w := heckePoly w.q (card n) (x.heckeEigenvalues w)\n\n/-- A chosen representation Gal(Ω/E) → GL_n(Q̄_ℓ) attached to the Hecke polynomials of the\nisotypic space x; arbitrary if none exists. -/\ndef Isotypic.galRep [Algebra E Ω] := epsilon (Attached (n := n) x.heckePolyAt)\n\nvariable {x}\n\nlemma commute_of_mem_localGroupAlgebra (ha : a ∈ localGroupAlgebra w) {y} (h : y ∈ trivialOn n\n  {w}) : Commute (V.formTranslation κ y) a := commute_of_mem_adjoin_of_forall_mem_commute ha\n  fun | _, ⟨_, m, rfl⟩ => (commute_supportedOn_trivialOn m h).symm.map _\n\nlemma heckeFun_mem_localGroupAlgebra {G} [Group G] hw (θ : G →* _) {K s} :\n  heckeFun (((V.formTranslation κ).comp\n  (atSplit (w := w) hw)).comp θ) K (indicator s 1) ∈ localGroupAlgebra w := by\n  apply finsum_induction <;> simp_all [indicator, localGroupAlgebra, ← range_atSplit] <;> bound\n\nlemma hasHeckePolyAt_of_mem_eigenformsAt (h : f ∈ eigenformsAt V κ w t) hw : HasHeckePolyAt f.1 w hw\n  (heckePoly w.q (card n) t) := by simp_all [hasHeckePolyAt_iff, eigenformsAt]; lia\n\nlemma Isotypic.mem_iff_eventually : f ∈ x.1 ↔ ∀ᶠ w in cofinite,\n  f ∈ eigenformsAt V κ w (x.heckeEigenvalues w) := by grind\n\nlemma Isotypic.map_mem (ha : a ∈ localGroupAlgebra v) (h : f ∈ x.1) : a f ∈ x.1 :=\n  mem_iff_eventually.2 (by\n  peel (mem_iff_eventually.1 h).and (eventually_notMem_star_notMem 1 {star v}); have C g (m :\n    g ∈ supportedOn n {‹_›}) : _ = V.formTranslation κ g\n    _ := congr($(commute_of_mem_localGroupAlgebra ha (by simp_all [eq_comm])) f).symm\n  simp_all [eigenformsAt, ← map_heckeSplit _ _ a, ← C])\n\nlemma Isotypic.isEigenform [StablyUnram E] (h : f ∈ x.1) (h0 : f ≠ 0) :\n  IsEigenform f.1 x.heckePolyAt := ⟨by simpa, (mem_iff_eventually.1 h).mono fun _ h ↦\n  (⟨isSplit_of_q_prime ·, hasHeckePolyAt_of_mem_eigenformsAt h _⟩)⟩\n\n/-- A nonzero form of maximal level off S that is a spherical Hecke eigenform at every split w\nwith w, w̄ not in S lies in some isotypic space. -/\nlemma exists_isotypic_of_isSphericalOff {P} (h : IsSphericalOff S f.1 P) : ∃ x : Isotypic V κ,\n  f ∈ x.1 ∧ f ≠ 0 := by\n  choose! _ _ _ t _ using by simpa [IsSphericalOff, hasHeckePolyAt_iff, -mem_levelSpace] using h\n  use ⟨.ofLinearComb {f | ∀ᶠ w in cofinite, f ∈ eigenformsAt V κ w (t w)} ⟨0, by simp⟩ fun _ a _ b _\n    _ ↦ a.out.mp (.mono b (by bound)), t, by tauto⟩, (eventually_notMem_star_notMem 1 S).mono\n    (by simp_all [eigenformsAt, -mem_levelSpace])\n\nlemma Isotypic.iSupIndep_val {s : Set (Isotypic V κ)} : iSupIndep (·.1.1 : s → _) :=\n  let I := iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero; (I _).2 fun s v h ↦ (I _).1 (.comp (.iInf _\n  fun w : Subtype _ ↦ .iInf _ (heckeSplit (V.formTranslation κ) w.2.1 · |>.eigenspaces_iSupIndep))\n    (f := (·.1.heckeEigenvalues ·.1)) fun x y e ↦\n    x.ext (x.1.ext (ext fun _ ↦ (mem_iff_eventually.iff mem_iff_eventually).2 (eventually_congr\n  ((s.eventually_all.2 (mem_iff_eventually.1 ∘ h ·)).mono fun w h ↦ congr(_ ∈ $(iInf_congr\n    (congrFun e ⟨w, And.intro · h⟩ ▸ rfl)))))))) s v (by simp_all [eigenformsAt])\n\nlemma Isotypic.attached_galRep [Algebra E Ω] [Nonempty n] [V.IsStd] [WeilData E] (h : f ∈ x.1) (h0 :\n  f ≠ 0) : Attached x.heckePolyAt x.galRep :=\n  epsilon_spec (sphericalCompat_std ofNonempty (‹V.IsStd›.eq_stdSpace ▸ f.2) (isEigenform h h0)).1\n\nend\n\nvariable {ℓ} [ThePrime ℓ] [PadicIso ℓ] (E J : Type) {n} [Field E] [CMType E]\n  [Fintype n] (V : Space E n 1) (κ m)\n\n/-- Auxiliary places: a family x_j (j in J) of `FrobeniusDatum` data at distinct places w_j of prime\nnorm q_j ≡ 1 mod m, no conjugate w̄_i being among the w_j. -/\nstructure TaylorWilesPlaces (E J : Type) [Field E] [NumberField E] [IsCMField E] (m : _)\n    [Algebra E Ω] where\n  frobData : J → FrobeniusDatum E\n  apart : IsConjApart (frobData · |>.w)\n  dvd_q_sub_one j : m ∣ (frobData j).w.q - 1\n\nvariable {E J}\n\n/-- The auxiliary place w_j of Q with index j. -/\nabbrev TaylorWilesPlaces.w {E J : Type} [Field E] [NumberField E] [IsCMField E]\n    {m} [Algebra E Ω] (Q : TaylorWilesPlaces E J m) j := (Q.frobData j).w\n\nattribute [instance] TaylorWilesPlaces.apart\n\n/-- Base data: places S; a space Y of forms with an open-level character above S ∪ S̄, stable\nunder operators commuting with K₀ there; all orders |Γ ∩ gK₀g⁻¹| divide m. -/\nstructure BaseLevel where\n  S : Finset (FinPlace E)\n  Y : Submodule ℂ (V.forms κ)\n  map_mem_Y T : (∀ k : Kf E n, Commute (V.formTranslation κ (componentOn n S k)) T) → Y ≤ Y.comap T\n  exists_level : ∃ K χ, K.IsOpen ∧ Y ≤\n    levelSpace (.comp (V.formTranslation κ) (componentOn n S)) K χ\n  card_aut_dvd g : Nat.card (classAut V.Γf (Kf ..) g) ∣ m\n\nvariable {V κ m} {D : BaseLevel V κ m} (L : J → _)\n\nnamespace BaseLevel\n\n/-- Integral forms: the O-module of forms whose values at all points integral above ℓ have\ncoordinates that ι sends to ℓ-adic integers. -/\ndef ellIntegralForms : Submodule EllAdicIntegers (V.forms κ) := by\n  use! {f | ∀ g ∈ integralAbove n ℓ, ∀ i, ιℓ (f.1 g i) ∈ valuation.integer} <;> simp_all [add_mem,\n    Algebra.smul_def, iota_ell_algebraMap]; exact fun c _ _ h _ m _ ↦ mul_mem c.2 (by tauto)\n\nlemma localGroupAlgebra_le_endPreserving {w} (l : ↑ℓ ∉ w.1) : localGroupAlgebra w ≤\n  endPreserving (W := V.forms κ) ellIntegralForms := adjoin_le\n  fun | _, ⟨_, _, rfl⟩, _, h, _ => h _ ∘ by simp_all [localLevel, (· ▸ l : _ = w → _).mt]\n\n/-- The action of G_f on forms of weight κ on V by right translation through the components at\nthe places outside S ∪ S̄. -/\nabbrev repOff := (V.formTranslation κ).comp (componentOn n (.conjClosure D.S)ᶜ)\n\n/-- The forms in Y that are fixed by the components off S ∪ S̄ of the principal level subgroup\nof K₀ at the places L. -/\nabbrev formsOfLevel := D.Y ⊓ levelSpace D.repOff (levelOf L ⊥)\n\n/-- Systems of eigenvalues of level L: the isotypic spaces that contain a nonzero form of\n`BaseLevel.formsOfLevel`. -/\ndef Eigensystem := {x : Isotypic .. | ∃ f ∈ x.1 ⊓ D.formsOfLevel L, f ≠ 0}\n\n/-- Neither w nor w̄ is in S, w ∤ ℓ, and, if w splits, each isotypic form in\n`BaseLevel.formsOfLevel` L is spherical at w with the chosen eigenvalues of its system. -/\ndef IsOffLevel {ℓ} [ThePrime ℓ] w := w ∉ D.S ∧ star w ∉ D.S ∧ ↑ℓ ∉ w.1 ∧ ∀ x ∈ D.Eigensystem L,\n  x.1 ⊓ D.formsOfLevel L ≤ eigenformsAt V κ w (x.heckeEigenvalues w)\n\nlemma repOff_eq_of_mem_trivialOn k (h : k ∈ trivialOn n D.S) : D.repOff k = V.formTranslation κ k :=\n  .symm (congrArg _ (k.ext (by simp_all [← supportedOn_compl])))\n\n/-- The O-algebra of ℂ-linear endomorphisms of the space of forms `BaseLevel.formsOfLevel` attached\nto the base data D and the family of finite places L. -/\n@[reducible] def FormEnd {ℓ} [ThePrime ℓ] [PadicIso ℓ] := End ℂ (D.formsOfLevel L)\n  deriving Semiring, Ring, Algebra EllAdicIntegers\n\n/-- The O-algebra of ℂ-linear endomorphisms of the space of forms `BaseLevel.formsOfLevel` that\npreserve its integral forms. -/\nabbrev integralEnd : Subalgebra EllAdicIntegers (D.FormEnd L) :=\n  endPreserving (ellIntegralForms.comap ((formsOfLevel L).subtype.restrictScalars EllAdicIntegers))\n\nlemma formsOfLevel_base_le : D.formsOfLevel ![] ≤\n  D.formsOfLevel L := by aesop_cat (add simp mem_levelOf)\n"),("src/Lib/Adelic/CuspForms/ClassReps.lean","import Lib.GLn.SchurModule.WeightRepBasic\nimport Lib.Adelic.Landherr.WeakApprox\n\n/-! Part of: Cusp forms: rapid decay, finite dimension, Poincaré series; algebraic modular forms\n(known result; see Lib.Adelic.CuspForms.Petersson).\n\nThis file: p-adic gauge on algebraic forms: invariance, ultrametric, integral module, weak\napproximation. Norm bounded by dual functionals; triangle inequality for finite sums. Class sets,\np-integral representatives, integrality of forms supported on one class. -/\n\nopen NormedField Space IsUltrametricDist Matrix Function PolyRep\nvariable {E n} [Field E] [CMType E] [Fintype n] {κ e p} [Fact p.Prime] (g d : Gf E n)\n  (σ : E →+* ℂ_[p]) {k}\n\nlemma adeleExtension_mem_intGL (hk : k ∈ integralAbove n p) : .map (adeleExtension σ) k.1 ∈ intGL n\n  valuation.integer := mem_intGL.2 (by convert mem_intGL.1 (hk (placeOfEmb σ) (by simp)) <;>\n  exact (exists_placeOfEmb_extension σ).choose_spec.2.2.2.le_one_iff_le_one)\n\nvariable (p) in /-- Weak approximation above `p`. -/\n\nlemma exists_mul_mem_integralAbove (V := stdSpace E n) : ∃ γ, V.embFin γ * g ∈ integralAbove n p ∧\n  d * (V.embFin γ * g) *\n  d⁻¹ ∈ integralAbove n p := ((V.weak_approximation (finite_natCast_mem p)).exists_mem_open\n  (