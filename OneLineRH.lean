det : G E s' → _) := continuous_mat.matrix_det.subtype_mk _\n\nlemma G.det_onHom : (onHom p).det =\n  p.2.det ^ card n₁ * p.1.det⁻¹ ^ card n' := by ext1; simp [← map_inv]\n\n@[simp↓] lemma det_fst : g.det.1.1 = fun w ↦ (g.1 w).1.1.det := funext (evalInf · |>.map_det _)\n\n@[simp↓] lemma det_atPlace w : g.det.1.2 w = (g.2.atPlace w).1.det :=\n  g.det_snd ▸ (_root_.evalAt w).map_det _\n\nend\n\nend\n\nattribute [local simp] kronecker_mulVec_eq_matToVec\n\nvariable {E : Type*} [Field E] [CMType E] {n : Type _} [Fintype n] {s : n → ℤˣ} {V : Space E n s}\n  {n₁ n' : Type} [Fintype n₁] [Fintype n'] {s₁ : n₁ → ℤˣ} {s' : n' → ℤˣ} (T : Space E n' s')\n  {m : Type*} (p : G E s₁ × G E s') (g : G E s') {n n' : Type} [Fintype n] [Fintype n'] {s : n → ℤˣ}\n  {s' : n' → ℤˣ} (S : Space E n s) (T : Space E n' s') {g : G E s} (a b : AutChar E)\n  (p : G E s × G E s₁)\n\n/-- For a rational n′ × n matrix x, the adelic vector attached to it in the space Hom(S,T) is\nthe matrix x_T⁻¹ x x_S, with x_S, x_T the points of S and T. -/\nlemma Space.vecAtPoint_hom x : (S.hom T).vecAtPoint (matToVec x) = matToVec (T.ratMap S x) :=\n  kronecker_mulVec_eq_matToVec ..\n\nlemma G.onHom_mem_Gamma {h} : g ∈ S.Γ → h ∈ T.Γ → onHom (g, h) ∈ (S.hom T).Γ := by\n  rw [← inv_mem_iff]\n  simp_all [↓mem_Γ_iff_range, Space.hom, mul_assoc, mul_mem]\n\n@[simp] lemma pairChar_apply : pairChar a b p = a.1 p.2.det * (b.1 p.1.det : ℂ)⁻¹ := mul_comm ..\n\n@[simp] lemma AutChar.apply_det_ratEmbed γ :\n    a.1 (S.ratEmbed γ).det = 1 := a.2 _ ⟨_, (map_det ..).trans (det_units_conj ..).symm⟩\n\nvariable (p : G E s × G E s') [WeilData E]\n\nsection\n\n@[local simp] lemma pairWeil_apply f : pairWeil S T a b p f = pairChar a b p • ω _ (onHom p) f :=\n  rfl\n\n@[fun_prop] lemma continuous_pairWeil : Continuous fun q ↦ pairWeil S T a b (Prod.fst q) q.2 := by\n  simp [pairChar, -circleChar_inv_apply]; fun_prop\n\n@[simp] lemma dataInner_pairWeil f f' : dataInner _ (pairWeil S T a b p f) (pairWeil S T a b p f') =\n  dataInner _ f f' := by simp [field, RCLike.mul_conj]\n\n/-- For rational points g of U(S) and h of U(T), every f in 𝒮(Hom(S,T)) and every adelic matrix\nx satisfy (ω_{a,b}(g,h)f)~(x) = f̃(h⁻¹xg). -/\nlemma pairWeil_of_mem_Gamma {h} :\n    g ∈ S.Γ → h ∈ T.Γ → ∀ f x, pairWeil S T a b (g, h) f x = f (h⁻¹.mat ⊗ₖ g.matᵀ *ᵥ x) := by\n  rintro ⟨u, ⟨⟩⟩ ⟨v, ⟨⟩⟩ f x\n  rw [← θ_ϱ, ← theta_omega_ratEmbed, (onHom_mem_Gamma S T ⟨u⁻¹, rfl⟩ ⟨v⁻¹, rfl⟩).choose_spec]\n  simp [ω_ϱ, rep_apply_apply, ← map_mul]\n\nlemma pairTheta_mul f p q : pairTheta S T a b f (p * q) =\n  pairTheta S T a b (pairWeil S T a b q f) p := by simp [pairTheta]\n\n/-- For spaces S, T and characters a, b of [U(1)], the theta kernel θ^{S,T}_{a,b}(f)(g,h) is\njointly continuous in the datum f in 𝒮(Hom(S,T)) and the adelic group elements g, h. -/\n@[fun_prop] lemma continuous_pairTheta : Continuous ↿(pairTheta S T a b) := by fun_prop [pairTheta]\n\nend\n\nattribute [local simp] AutChar.baseChange_apply_coe_toFun AutChar.spaceChar Space.conjTranspose_J\n  Space.hom_J Space.map_J Space.map_J_inv\n\n/-- For a space T with adelic frame x, the invertible adelic matrix (x⁻¹)* ε, with inverse ε x*,\nwhere ε is the standard form of its signs. -/\nnoncomputable def Space.dualFrame : GL n (𝔸 E) := by\n  use S.x⁻¹.1ᴴ * stdForm E s, stdForm E s * S.xᴴ <;> simp [conjTranspose_nonsing_inv]\n\nseal CStarMatrix\n\nvariable {n₀ p : Type} [Fintype n₀] [Fintype p] {s₀ : n₀ → ℤˣ} {V : Space E n s}\n  {V₀ : Space E n₀ s₀} (D : V.Splitting V₀ p) (T : Space E n' s') {q : Type} [Fintype q]\n  {V₁ : Space E n₁ s₁} (D' : V₀.Splitting V₁ q)\n\nlemma Space.varrho_pairWeil (T : Space E n₀ s₀) (a b : AutChar E) q x f :\n  ϱ _ x (pairWeil V T a b q f) = pairWeil V T a b q\n  (ϱ _ (matToVec (q.2⁻¹.mat * vecToMat x * q.1.mat)) f) := by simp [pairWeil, ω_ϱ, ↓mat_onHom, mat]\n\nnamespace Space.Splitting\n\n/-- From a splitting (k, l, ι) of V over V₀, the splitting of Hom(V,T) over Hom(V₀,T) with\nframes J_T⁻¹⊗(k*J)ᵀ, 1⊗(l*J)ᵀ, 1⊗(J₀⁻¹ι*J)ᵀ; the first spans the maps killing k^⊥. -/\nnoncomputable def homSource\n    : (V.hom T).Splitting (V₀.hom T) (n' × p) := by use T.J⁻¹ ⊗ₖ (D.kᴴ * V.J)ᵀ, 1 ⊗ₖ (D.lᴴ * V.J)ᵀ,\n      1 ⊗ₖ (V₀.J⁻¹ * D.iᴴ * V.J)ᵀ <;> (try rw [← conjTranspose_inj]) <;> cases D <;> simp_all; ring\n\n/-- From a splitting (k, l, ι) of V over V₀, the splitting of Hom(T,V) over Hom(T,V₀) with\nframes k⊗J_Tᵀ, l⊗1, ι⊗1. -/\nnoncomputable def homTarget : (T.hom V).Splitting (T.hom V₀) (p × n') := by\n  use D.k ⊗ₖ T.Jᵀ, D.l ⊗ₖ 1, D.i ⊗ₖ 1 <;> simp [D.card_eq]; ring\n\n/-- On Hom(V,T), the zero term for the splitting with k and l exchanged is the integral over\nadelic x of the terms f[x] of the mixed model. -/\nlemma symm_homSource_zeroTerm_eq_integral f : (D.symm.homSource T).zeroTerm f = ∫ x, (D.homSource\n  T).mixedTerm x f := by set D := D.homSource T; ext y; erw [D.symm.zeroTerm_congr, ← (_ ∘L\n  _).integral_comp_comm, zeroTerm_apply, quotMean_tsum_eq_integral _ _ ((_ ∘L _).integrable_comp\n  (integrable_mixedTerm ..)) (isContPeriodic_along_k ..) fun x ↦ (Equiv.ofInjective _\n  (@toAdele E ..).injective.comp_left).hasSum_iff.1 (by simpa using! D.hasSum_theta_mixedTerm (ϱ _\n  (D.iAdelic *ᵥ y + D.lAdelic *ᵥ x) _))] <;> simp [symm, homSource, D, integrable_mixedTerm]\n\nsection\n\nattribute [local simp] homSource homTarget iAdelic iCoord kAdelic kCoord lAdelic lCoord hom ratMap\n  dualFrame map_kronecker\n\nlemma zeroTerm_homSource_congr {D' : V.Splitting _ q} (hk : D'.kᴴ * V.J * D.k = 0) (hi : D'.i =\n  D.i) :\n  (D'.homSource T).zeroTerm = (D.homSource T).zeroTerm := by apply zeroTerm_congr <;> simp [*]\n\nlemma zeroTerm_homSource_comp f : ((D.comp D').homSource T).zeroTerm f = (D'.homSource T).zeroTerm\n  ((D.homSource T).zeroTerm f) := by have := (D.comp D').gram_kk; convert zeroTerm_comp ..; apply\n  zeroTerm_congr <;> simp_all [comp, ← ext_iff]\n\nsection\n\nomit [WeilData E]\n\nlemma homSource_kAdelic : (D.homSource T).kAdelic = ↑T.dualFrame⁻¹ ⊗ₖ D.lCoordᵀ := by simp\n\nlemma homSource_lAdelic : (D.homSource T).lAdelic = ↑T.x⁻¹ ⊗ₖ D.kCoordᵀ := by simp\n\nlemma homSource_iAdelic : (D.homSource T).iAdelic = 1 ⊗ₖ D.iCoordᵀ := by simp\n\nlemma homTarget_kAdelic : (D.homTarget T).kAdelic = D.kAdelic ⊗ₖ T.dualFrameᵀ := by simp\n\nlemma homTarget_iAdelic : (D.homTarget T).iAdelic = D.iAdelic ⊗ₖ 1 := by simp\n\nend\n\nend\n\nvariable {n n' : Type} [Fintype n] [Fintype n'] {s : n → ℤˣ} {s' : n' → ℤˣ} {n₀ p : Type}\n  [Fintype n₀] [Fintype p] {s₀ : n₀ → ℤˣ} {V : Space E n s} {V₀ : Space E n₀ s₀}\n  (D : V.Splitting V₀ p) (T : Space E n' s') (a b : AutChar E) (g : G E s) (g₀ : G E s₀)\n  (m : GL p _) (hk : D.ActsOnFrame g m.1) (hi : D.iCoord * (g.mat * D.iAdelic) = mat (s := s₀) g₀)\n\n/-- For an adelic n′×p matrix x, the map f ↦ f[x]: the zero term, along maps killing k^⊥, of\nϱ(x̃)f, where x̃ ∈ Hom(V,T) has x̃k = x and kills l, ι. -/\nnoncomputable def sourceTerm x := (D.homSource T).zeroTerm ∘L ϱ _ (matToVec (x * D.kCoord))\n\nattribute [local simp] homSource_iAdelic homSource_kAdelic homSource_lAdelic homTarget_iAdelic\n  homTarget_kAdelic levi mixedTerm sourceTerm varrho_pairWeil υ_star mul_pow smul_smul chiAdelic\n\n/-- For an adelic n′×p matrix x and x_T the point of T, the map `Space.Splitting.sourceTerm` at\nx_T⁻¹x equals the mixed model of the induced splitting `Space.Splitting.homSource` of Hom(V,T) at x,\nread as a vector indexed by pairs. -/\nlemma sourceTerm_eq_mixedTerm x : D.sourceTerm T (T.x⁻¹.1 * x) =\n  (D.homSource T).mixedTerm (matToVec x) := by simp\n\n/-- For split V and any datum f on Hom(V,T), θ(f) is the convergent sum of the θ(f[x]) over\nrational n'×p matrices x, read in the adelic coordinates of T, f[x] being the term of x in\nthe mixed model. -/\nlemma hasSum_theta_sourceTerm f :\n  HasSum (fun x ↦ θ _ (D.sourceTerm T (T.x⁻¹.1 * .map x toAdele) f)) (θ _ f) :=\n  (Equiv.curry ..).hasSum_iff.1 (by simp_rw [sourceTerm_eq_mixedTerm]; apply hasSum_theta_mixedTerm)\n\nlemma sourceTerm_varrho x y f : D.sourceTerm T x (ϱ _ (matToVec y) f) =\n  (stdAddChar E (toAdele (j / 2) * ((y * D.lAdelic)ᴴ * stdForm E\n  s' * (x + x + y * D.kAdelic)).trace)).1 • ϱ _ (matToVec (y * D.iAdelic))\n  (D.sourceTerm T (x + y * D.kAdelic) f) := by simpa [adelicHeis, add_assoc, kCoord, lCoord, iCoord,\n  dualFrame] using ((D.homSource T).isMixedLaw_mixedTerm (matToVec (T.x.1 * x)) (matToVec y) f)\n\n@[simp↓] lemma chiAdelic_unitary (u : unitary (𝔸 E)) : chiAdelic (Unitary.toUnits u) =\n  upsilonU1.1 u := by simp [ideleAbs_eq_one_of_mem_unitary]; rfl\n\ninclude hk hi\n\nomit [WeilData E] in\nlemma det_eq_divStar_mul : g.det = divStar m.det * g₀.det := Subtype.ext (.trans (by\n  rw [coe_det, ← det_conj_of_mul_eq_one _ (by simpa [← fromCols_mul_fromRows] using\n    D.sum_frame_mul_coord_eq_one),\n    fromRows_mul] <;> simp [D.lCoord_mul_mat hk, ↓fromRows_mul_fromCols, *]) (mul_right_comm ..))\n\n/-- Suppose gk = km, m ∈ GL_p(𝔸), and gι = ιg₀ + kc. On Hom(V,T), ev ω_{aυ^p,b}(g,h)f = χ_T(det\nm)⁻¹ |det m|^(n′/2) ω_{a,b}(g₀,h) ev f, with n′ the rank of T and χ_T(x) =\nb(x/x̄)υ(x)^(−n′). -/\nlemma homSource_zeroTerm_pairWeil h f : (D.homSource T).zeroTerm (pairWeil V T (a * upsilonU1 ^ card\n  p) b (g, h) f) = (((b.spaceChar (card n')).1 m.det).1⁻¹ * √(ideleAbs m.det) ^ card n') • pairWeil\n  _ T a b (g₀, h) ((D.homSource T).zeroTerm\n  f) := by simp [pairWeil, D.det_eq_divStar_mul _ _ _ hk hi, iCoord, lCoord, ↓map_mul, ↓map_pow,\n  ← hi, mat_inv, -coord_mul_frame_mul, by simpa using congr($hkᴴ * stdForm E s),\n  (D.homSource T).zeroTerm_omega (.onHom (g₀, h)) _ _ (Unitary.toUnits h.det ^\n  _ * star m.det ^ _) (by rw [det_kronecker' _ mᴴᵀ, det_units_conj T.dualFrame]; aesop)]; field_simp\n\n/-- Suppose gk = km, m ∈ GL_p(𝔸), and gι = ιg₀ + kc. On Hom(T,V), ev ω_{a,bυ^p}(h,g)f = χ(det m)\n|det m|^(n′/2) ω_{a,b}(h,g₀) ev f, with n′ the rank of T and χ(x) = a(x/x̄)υ(x)^(−n′). -/\nlemma homTarget_zeroTerm_pairWeil h f : (D.homTarget T).zeroTerm (pairWeil T V a (b * upsilonU1 ^\n  card p) (h, g) f) = (((a.spaceChar (card n')).1 m.det).1 * √(ideleAbs m.det) ^ card n') • pairWeil\n  T _ a b (h, g₀) ((D.homTarget T).zeroTerm f) := by simp [pairWeil, ↓map_mul, ↓map_pow,\n  D.det_eq_divStar_mul _ _ _ hk hi, iCoord, -coord_mul_frame_mul, ← hi, *,\n  (D.homTarget T).zeroTerm_omega (.onHom (h, g₀)) _ _ (m.det ^ _ * Unitary.toUnits h⁻¹.det ^ _) (by\n  rw [det_kronecker' m, det_transpose, h⁻¹.mat.det_units_conj T.dualFrame]; rfl)]; field_simp\n\nomit hk hi\n\n/-- For the Levi element g with gk = km, gι = ιg₀: (ω_{aυ^p,b}(g,h)f)[x] = χ_T(det m)⁻¹ |det\nm|^(n′/2) ω_{a,b}(g₀,h) f[h⁻¹xm], with n′ the rank of T and χ_T(y) = b(y/ȳ)υ(y)^(−n′). -/\nlemma sourceTerm_levi g₀ h x f :\n  D.sourceTerm T x (pairWeil V T (a * upsilonU1 ^ card p) b (D.levi (m, g₀), h) f) =\n  (((b.spaceChar (card n')).1 m.det).1⁻¹ * √(ideleAbs m.det) ^ card n') • pairWeil _ T a b (g₀, h)\n  (D.sourceTerm T (h⁻¹.mat * x * m.1) f) := by simp [D.homSource_zeroTerm_pairWeil _ _ _ _ g₀ m]\n\n/-- For the unipotent element u = `Space.Splitting.radicalElt` c z, z hermitian, (ω_{a,b}(u,1)f)[x]\n= ψ(½ tr(z x*ε′x)) ϱ(x c* ε₀) f[x], where ε′, ε₀ are the standard forms of T and V₀. -/\nlemma sourceTerm_radicalElt c z x f : D.sourceTerm T x (pairWeil V T a b (D.radicalElt c z, 1) f) =\n  (stdAddChar E (toAdele (2⁻¹) * (z * (xᴴ * stdForm E s' * x)).trace)).1 • ϱ _\n  (matToVec (x * cᴴ * stdForm E s₀)) (D.sourceTerm T x f) := by\n  erw [zeroTerm.comp_apply, varrho_pairWeil, ← div_mul_cancel a, homSource_zeroTerm_pairWeil _ _ _ _\n    _ 1 1, (by simpa [-conjTranspose_mul] using D.sourceTerm_varrho T 0 :)] <;> simp [radicalElt]\n  rw [← stdAddChar_half, eq_comm, ← stdAddChar_half]; congr 3\n  simp [← trace_conjTranspose, cᴴ.trace_mul_comm, (stdForm E _).trace_mul_comm,\n    z.trace_mul_comm]; grind\n"),("src/Lib/Weil/DualPair/PairSumNegation.lean","import Lib.Weil.DualPair.PairSplitting\n\n/-! Part of: Theta kernels of unitary dual pairs: functoriality, seesaw, growth, rapid decay (known\nresult; see Lib.Weil.DualPair.KernelDecay).\n\nPart of: Adelic Weil representation of a unitary group and the invariant theta functional (known\nresult; see Lib.Weil.DualPair.PairSplitting).\n\nThis file: Finite-place action of a dual pair on data; explicit scalars at split places. Theta\nfunctional is canonical, transported by isometries, multiplicative on orthogonal sums. Theta kernels\nunder orthogonal sums (seesaw factorisation) and negation of the form. -/\n\nsection\n\nopen Fintype G Gf Kronecker Matrix NumberField Space Unitary\n\nsection\n\nattribute [local simp] onHom_snd mem_Kf_iff pairWeil\n\nsection\n\nvariable {E : Type*} [Field E] [NumberField E] [IsCMField E] {n n' : Type} [Fintype n] [Fintype n']\n  {s : n → ℤˣ} {s' : n' → ℤˣ} {A : Set (FinPlace E)} (hA : A.IsConjDisjoint)\n  {Ψ : (n' × n → 𝔸f E) → ℂ} [hΨ : IsSchwartzBruhat (E := E) (n := n' × n) A Ψ]\n  {p : G (n := n) E s × G (n := n') E s'} {w : FinPlace E} (g : Gf E n)\n\nlemma detOn_star : detOn (star ⁻¹' A) g.1 = star (detOn A g.1)⁻¹ := by\n  ext <;> simp [detOn, cutGL, star_idem, ← det_conjTranspose, inv_eq_left_inv g.2]\n\n@[simp↓] lemma onHom_snd_inv_mulVec x : (onHom p).2⁻¹.1.1 *ᵥ x =\n  matToVec (p.2.2⁻¹.1.1 * vecToMat x * p.1.2.1.1) := kronecker_mulVec_eq_matToVec ..\n\n@[simp] lemma G.onHom_atPlace : ((onHom p).2.atPlace w).1 =\n  (p.2.2.atPlace w).1 ⊗ₖ (p.1.2⁻¹.atPlace w).1ᵀ := rfl\n\n@[simp↓] lemma G.onHom_mem_supportedOn : p.1.2 ∈ supportedOn n A → p.2.2 ∈ supportedOn _ A →\n  (onHom p).2 ∈ supportedOn _ A := by aesop\n\n@[simp] lemma G.onHom_atPlace_mem : p.1.2.atPlace w ∈ Kw .. → p.2.2.atPlace w ∈ Kw .. →\n  (onHom p).2.atPlace w ∈ Kw .. := by simp_all [mem_intGL, ← map_inv, ← Prod.snd_inv, mul_mem]\n\n/-- The homomorphism sending a norm-one finite adele to the corresponding scalar matrix in the\nfinite adelic unitary group of rank n. -/\nnoncomputable def scalarFin (n : Type) [Fintype n] : unitary (𝔸f E) →* Gf E n := .codRestrict\n    (.comp (GeneralLinearGroup.scalar n) toUnits) _ (by simp [star_mul_self_of_mem, U])\n\nlemma commute_scalarFin {ν} : Commute (scalarFin n ν) g :=\n  Subtype.ext (GeneralLinearGroup.scalar_commute ..)\n\nlemma G.det_of_supportedOn (hA : A.IsConjDisjoint) {g} (hg : g ∈ supportedOn n A) : detFin s g =\n  divStar (detOn A g.1) := by\n  ext1; convert! congr(_ * $(detOn_star _).1); ext <;> simp_all\n  split_ifs <;> simp_all; grind\n\nlemma G.mat_scalarFin ν : mat (s := s) (1, scalarFin n ν) =\n  ((1, ν.1) : 𝔸 E) • 1 := by simp [scalarFin]; aesop\n\nlemma G.onHom_scalarFin ν ν' : (onHom ((1, scalarFin n ν), 1, scalarFin _ ν') : G E (homSigns s\n  s')) = (1, scalarFin _ (ν' / ν)) := ext_mat (by simp [← map_inv, ↓mat_scalarFin]; aesop)\n\nend\n\nvariable {E : Type*} [Field E] [CMType E] {n n' : Type} [Fintype n] [Fintype n'] {s : n → ℤˣ}\n  {s' : n' → ℤˣ} {A : Set (FinPlace E)} (hA : A.IsConjDisjoint) {Ψ : (n' × n → 𝔸f E) → ℂ}\n  [hΨ : IsSchwartzBruhat (E := E) (n := n' × n) A Ψ] {p : G (n := n) E s × G (n := n') E s'}\n  {w : FinPlace E} (g : Gf E n) [WeilData E] {S : Space E n s} {T : Space E _ s'} {a : AutChar E}\n  {b : AutChar E} {g : _} {h} {f : 𝒮 (S.hom T)}\n\n/-- The finite multiplier Δ_f of (g, 1), acting on Hom(S,T) by x ↦ x g⁻¹, is Δ_f(g_f⁻¹)^(n'),\nwhere n' is the rank of the second space. -/\nlemma finMultiplier_onHom_left {g : G E s} : finMultiplier (onHom (s' := s') (g, 1)).2 =\n  finMultiplier g.2⁻¹ ^ card n' := by erw [finMultiplier, Sat.glMultiplier_transpose\n  ((saturatingElem _).2.map_of_le_comap (by use! (1 ⊗ₖ ·) <;> simp [kronecker_add]) fun _ _ _ ↦ _),\n  ← map_pow] <;> congr <;> aesop\n\nlemma pairWeil_eq_smul_of_projOn_eq A (hf : projOn _ A f = f) (hg : g ∈ Kf .. ⊓ supportedOn n A)\n  (hh : h ∈ Kf .. ⊓ supportedOn _ A) : pairWeil S T a b (g, h) f = (a.1 (detFin s' h) *\n  (b.1 (detFin s g))⁻¹).1 • f := by simp; rw [onHom_fin, ω_of_mem_Kf _ _ hf] <;> aesop\n\nlemma projOn_pairWeil (hf : projOn _ A f = f) p (h : ∀ w ∈ A, (onHom p).2.atPlace w ∈ Kw .. := by\n  aesop) : projOn _ A (pairWeil S T a b p f) = pairWeil S T a b p f := by simp_all [← ω_projOn]\n\ninclude hA\n\n/-- For A ∩ Ā = ∅, Ψ Schwartz–Bruhat above A, and finite g, h supported on A ∪ Ā:\nω_{a,b}(g,h)(Ψ⊗f) = χ_S(det h_A) χ_T(det g_A)⁻¹ |det g_A|^{n′/2} |det h_A|^{−n/2} ·\nΨ(h⁻¹·g)⊗f, with n = rk S, n′ = rk T, and χ_S, χ_T given by `AutChar.spaceChar`. -/\nlemma pairWeil_name_on (hg : g ∈ supportedOn n A) (hh : h ∈ supportedOn n' A) f : pairWeil S T a b\n  (g, h) (name _ A Ψ f) = ((a.spaceChar (card n)).1 (detOn A h.1) / (b.spaceChar (card n')).1\n  (detOn A g.1) * √(ideleAbs (detOn A g.1)) ^ card n' / √(ideleAbs (detOn A h.1)) ^ card n : ℂ) •\n  name _ A (Ψ <| matToVec <| h⁻¹.1.1 * vecToMat · * g.1.1) f := by\n  rw [pairWeil_apply, onHom_fin, ω_name_on, smul_smul, eq_div_of_mul_eq'\n    (by aesop : detOn A _ * detOn A g.1 ^ card n' = detOn A h.1 ^ card n)] <;>\n    simp [det_of_supportedOn hA, AutChar.spaceChar, AutChar.baseChange_apply_coe_toFun, *]\n  congr 1; simp [chiAdelic, mul_pow, field, ← Complex.inv_eq_conj]\n\n/-- Let A ∩ Ā = ∅, Ψ be Schwartz–Bruhat above A, and g, h adelic with finite parts g_f, h_f\nintegral at all finite places (in K₀). Then ω_{a,b}(g,h)(Ψ ⊗ f) = Ψ′ ⊗ ω_{a,b}(g,h)f, with\nΨ′(x) = Ψ(h_f⁻¹xg_f). -/\nlemma pairWeil_name_of_mem (hg : g.2 ∈ Kf ..) (hh : h.2 ∈ Kf ..) f : pairWeil S T a b (g, h)\n    (name _ A Ψ f) = name _ A (Ψ <| matToVec <| h.2⁻¹.1.1 * vecToMat · * g.2.1.1) (pairWeil S T a b\n  (g, h) f) := by rw [pairWeil_apply, (omega_name ..).2, (funext _ : (boxIndicator _ _ <| _ *ᵥ ·) =\n  _), name_boxIndicator, ω_projOn] <;> simp_all [name_projOn, mulVec_mem_integralBox, -onHom_snd]\n\nend\n\nvariable {E : Type} [Field E] [CMType E] [WeilData E] {n n₁ n₂ : Type _} [Fintype n] [Fintype n₁]\n  [Fintype n₂] {s : n → ℤˣ} {s₁ : n₁ → ℤˣ} {s₂ : n₂ → ℤˣ} {σ : ℂ →+* ℂ} [RingHomIsometric σ]\n  (D : Std (n₁ := n₁) E σ s₁ s) {W V : Space E n s} (V₁ : Space E n₁ s₁)\n\n/-- Let φ be a vacuum-preserving change of coordinates with twist σ, and let g send every x with\nφx rational for V₁ to a rational vector of V. Then some c of modulus one has θ_V(c ω(g) f^φ)\n= σ(θ_{V₁}(f)) for all f. -/\nlemma Std.exists_theta_omega_map [RingHomInvPair σ σ] V g (hΓ : ∀ x, D.φ x ∈ Space.ratVectors V₁ →\n  g • x ∈ Space.ratVectors V) : ∃ c, ‖c‖ = 1 ∧ ∀ f, V₁.θ f = c * σ (V.θ (V.ω g (D.map f))) := by\n  obtain ⟨h, k⟩ := V.isThetaFunctional_rawTheta.comp _ (_ ∘SL _) (D.φ.symm.trans (.mk' (.smul g) _))\n    (by aesop) (by simp_intro ..; erw [← Space.ω_ϱ, ← D.map_ϱ]; aesop)\n    (D.map_vacElem ▸ (Space.dataInner_omega ..).trans\n    V.dataInner_vacElem_vacElem), congr(√‖$(V₁.isThetaFunctional_rawTheta.2)‖)\n  peel h.eq_smul V₁.isThetaFunctional_rawTheta.1; simp_all [Space.theta_eq_rawTheta,\n    mul_mul_mul_comm ‹ℂ›, h.2, -ContinuousLinearMap.comp_apply]; tauto\n\nattribute [local simp] Function.comp_def blockEmb diagonal Space.vecAtPoint dotProduct funext_iff\n  mem_ratVectors\n\n/-- For two spaces V, W with the same signs, some element g of the adelic unitary group G\ncarries the rational vectors of V (in standard adelic coordinates) into those of W. -/\nlemma Space.exists_mapsTo_ratVectors : ∃ g : G E s, ∀ γ ∈ V.ratVectors, g • γ ∈ W.ratVectors :=\n  (W.exists_eq_move V).elim\n  (.imp fun | _, e, _, ⟨y, rfl⟩ => ⟨· *ᵥ y, by simp [e.2, mat, RingHom.map_mulVec]⟩)\n\n/-- If g carries the rational points of the sum of lines with signs s into those of V, then\nθ_V(ω(g)ϱ(x)vac) = ∏_i θ_i(ϱ(x_i)vac) for all adelic x, θ_i the chosen theta functional of\nthe line of sign s_i. -/\nlemma Space.theta_vacElem_eq_prod_lineTheta {g} (h : ∀ γ ∈ (signedSpace E s).ratVectors, g • γ ∈\n  V.ratVectors) x : V.θ (V.ω g (V.ϱ x V.vacElem)) = ∏ i, lineTheta (s i) (x i) := (V.mem_Γ_iff_range\n  (g := g * _).2 (Function.swap (by simpa [-Pi.single_apply, Pi.apply_single fun _ ↦ @toAdele E ..]\n  using! (V.mem_ratVectors_iff.1 <| h _ <| exists_mapsTo_ratVectors.choose_spec _ ⟨Pi.single · 1,\n  rfl⟩)))).elim fun γ ↦ by erw [← theta_omega_ratEmbed γ⁻¹, theta_eq_rawTheta, rawTheta,\n  dite_eq_left exists_mapsTo_ratVectors, ← exists_isThetaFunctional_signedSpace.choose_spec.2,\n  ContinuousLinearMap.comp_apply, rep_apply_apply, rep_apply_apply]; aesop\n\nlemma Space.vacElem_apply_eq_prod_lineTheta (h : ∀ y, V.vecAtPoint y =\n  (signedSpace E s).vecAtPoint y) x : V.vacElem x = ∏ i,\n  lineTheta (s i) (x i) := by simp_all [← V.theta_vacElem_eq_prod_lineTheta (g := 1), ratVectors]\n\n/-- Suppose the coordinates of V split into two parts with signs s₁, s₂ and the point of V is\nblock diagonal with blocks the points of V₁, V₂. Then θ of the product of f₁ and f₂ is\nθ(f₁)θ(f₂). -/\nlemma Space.theta_boxProd {e : n₁ ⊕ n₂ ≃ n} (hs : s ∘ e = s₁ ⊕ᵥ s₂) {V₁ V₂} (h : V.x.1.submatrix e\n  e = fromBlocks V₁.x 0 0 V₂.x) f₁ f₂ : V.θ (V.boxProd hs f₁ f₂) = θ V₁ f₁ * θ V₂ f₂ := by\n  obtain ⟨⟨g, a⟩, ⟨k, b⟩, _⟩ := V₁.exists_mapsTo_ratVectors, V₂.exists_mapsTo_ratVectors, id hs\n  congrm($((V₁.ext_of_vacElem g fun _ ↦ V₂.ext_of_vacElem k fun _ ↦ ?_ :\n    .postcomp _ V.θ ∘L boxProd _ = .smulRight V₁.θ _)) _ _); simp [-θ_apply]\n  rw [theta_vacElem_eq_prod_lineTheta a, theta_vacElem_eq_prod_lineTheta b, ← omega_boxProd (g :=\n    blockEmb hs (g, k)), boxProd_rho, boxProd_vacElem, theta_vacElem_eq_prod_lineTheta] <;> simp_all\n    [mem_ratVectors_iff, reindex_equiv e, signedSpace, entrywise]\n\nend\n\nattribute [-simp] map_zero\n\nopen NumberField Matrix WeilData Space Equiv Std Fintype G ComplexConjugate Weil Int\nvariable {E : Type} [Field E] [CMType E] [WeilData E]\n  {n n' n₁ n₂ : Type} [Fintype n] [Fintype n'] [Fintype n₁] [Fintype n₂] {s : n → ℤˣ} {s' : n' → ℤˣ}\n  {s₁ : n₁ → ℤˣ} {s₂ : n₂ → ℤˣ} {e : n₁ ⊕ n₂ ≃ n} (hs : s ∘ e = s₁ ⊕ᵥ s₂) {S V : Space E n s}\n  {V₁ : Space E n₁ s₁} {V₂ : Space E n₂ s₂} {T : Space E n' s'} (a b b' : AutChar E) {g : G E s}\n  {g₁ : G E s₁} {g₂ : G E s₂}\n\nomit [WeilData E] in\nlemma Space.mem_ratVectors_hom {x} : x ∈ (S.hom T).ratVectors ↔\n  T.x.1 * vecToMat x * S.x⁻¹.1 ∈ ratMatrices .. := by simp [mem_ratVectors_iff, hom,\n  kronecker_mulVec_eq_matToVec, mem_ratVectors, mem_ratMatrices, matToVec]\n\nattribute [local simp] funext_iff pairSign pairWeil mat_inv stdForm mem_ratVectors_hom\n  weilMultiplier realMultiplier U.principalMinor_compl ContinuousAddEquiv.mk' Subtype.ext_iff\n\nattribute [local simp ←] ext_iff Complex.inv_eq_conj AddChar.map_neg_eq_inv\n\nomit [Fintype n] [Fintype n'] [Fintype n₁] [Fintype n₂] in\nlemma homSigns_sum_target (hs : s ∘ e = s₁ ⊕ᵥ s₂ := by exact signs_comp_refl) :\n  homSigns s' s ∘ (sumProdDistrib ..).symm.trans\n  (e.prodCongr (.refl _)) = homSigns s' s₁ ⊕ᵥ homSigns s' s₂ := by aesop\n\nomit [Fintype n'] [Fintype n₁] [Fintype n₂] in\nlemma homSigns_sum_source : homSigns (s₁ ⊕ᵥ s₂) s' ∘ (prodSumDistrib ..).symm =\n  homSigns s₁ s' ⊕ᵥ homSigns s₂ s' := by simp\n\nlemma normNegOne_inv : normNegOne⁻¹.1.1 = -star (normNegOne.1.1 : 𝔸f E) := rfl\n\n/-- The negation change of coordinates from Hom(S⁻,T) to Hom(S,T): x ↦ (1, c⁻¹)x, c the chosen\nelement of Ô of norm −1; it conjugates β. -/\nnoncomputable def negSource : Std E conj (homSigns s s') (homSigns (-s) s') := by\n  use .mk' (.smul (normNegOneIdele E)⁻¹) ?_, .refl _, .mk' (.smul (normNegOne (E := E))⁻¹)\n    (by simp) <;> simp [adelicSum, dotProduct, ↓Heisenberg.conj_β, neg_add_eq_sub, Units.smul_def,\n    intVectors, mem_Ô, isUnit_Ô.1, Subring.smul_def, normNegOneIdele, mul_left_comm, realHeis,\n    stdLattice, signMatrix, normNegOne_inv, mul_comm normNegOne.1.1, mul_assoc]\n\nlemma weilMultiplier_neg {t} {g₁ : G E t} : s = -t → g.mat = g₁.mat → conj (weilMultiplier g₁) =\n  upsilonU1.1 g₁.det * weilMultiplier g := by rintro ⟨⟩ h; erw [ext_mat (h.trans g₁.mat_neg.symm),\n  upsilon_eq_prod_mul_of_v_eq, G.neg] <;> simp -implicitDefEqProofs\n [MulEquiv.prodCongr, field, -coe_det, ← units_ne_iff_eq_neg, ← upsilon_mul_finMultiplier]\n\nomit [WeilData E] in\n@[simp] lemma G.det_neg : g.neg.det = g.det := by simp\n\n/-- The negation map from data on Hom(S,T) to data on Hom(S⁻,T) carries ω_{a,b}(g,h) to ω_{a⁻¹υ^n,\nb⁻¹υ^(n')}(g.neg,h), with n, n' the ranks of S, T. -/\nlemma pairWeil_negSource h f : pairWeil 