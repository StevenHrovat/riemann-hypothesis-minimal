 (g, h))).firstMinimum := by\n  simp [↓le_firstMinimum_iff, ne_iff]\n  use fun y a ↦ .imp ?_ ?_ <;> intro <;> grw [firstMinimum_le _ (ne_iff.2 ‹_›)] <;> simp_all\n    [norm_eq, archCoords, baseLattice, ↓move_vecAtPoint, vecAtPoint, sum, comp_def, ← map_inv,\n    Fintype.sum_prod_type, Matrix.fromBlocks_mulVec] <;> gcongr <;> simp <;> positivity\n\nnamespace Space\n\nvariable {E n : Type} [Field E] [CMType E] [Fintype n] {s} {V : Space E n s} {F M B K}\n\nlemma one_le_height g : 1 ≤ V.height g := by simp [height, one_le_inv₀, firstMinimum_pos]\n\n@[simp] lemma height_pos g : 0 < V.height g := by grind [one_le_height]\n\nattribute [local simp] le_of_lt mul_assoc\n\n/-- For compact K ⊆ G there is C ≥ 1 with ht(k) ≤ C·ht(g) whenever g⁻¹γk ∈ K for some γ ∈ Γ. -/\nlemma exists_height_le_mul (h : IsCompact K) :\n    ∃ C ≥ 1, ∀ γ g k, g⁻¹ * V.ratEmbed γ * k ∈ K → V.height k ≤ C * V.height g := by\n  obtain ⟨⟨c, hc, H⟩, R, hR⟩ := V.exists_smul_mulVec_mem_latticeBall (h.image_auto (·.2)),\n    h.exists_bound_of_continuousOn (f := (·.1 · |>.1.1)) (by fun_prop)\n  use 1 ⊔ c * R, by simp, fun γ g k m ↦ inv_le_of_inv_le₀ (by simp) ?_\n  simp [le_firstMinimum_iff, height, field]\n  use (H ⟨_, m, rfl⟩ (norm_le_pi_norm _) · · |>.elim fun p q b ↦ by grw [firstMinimum_le p (by\n    simpa [*] using! (smul_ne_zero_iff_ne γ).2 b), q, hR _ m, ← le_max_right])\n\nlemma exists_mul_height_pow_le (h : IsCompact K) C : ∃ D, ∀ᵉ (g) (γ ∈ V.Γ), γ * g ∈ K →\n  C * V.height g ^ B ≤ D :=\n  ⟨_, fun _ _ ⟨γ, _⟩ ↦ by grw [le_abs_self C, (exists_height_le_mul h).choose_spec.2 γ 1] <;> aesop⟩\n\nlemma IsRapid.bounded : V.IsRapid F → ∃ C, ∀ g, ‖F g‖ ≤ C := (by simpa using · 0)\n\nlemma IsRapid.mul : V.IsRapid F → V.IsModerate M → V.IsRapid (M * F) | h, ⟨C, _, b⟩, _ => ⟨_, (by simp; grw\n          [b ·, le_abs_self C, mul_mul_mul_comm, ← pow_add, mul_assoc, (h _).choose_spec] <;> simp)⟩\n\nlemma IsRapid.comp_mul_right (h : V.IsRapid F) {x} : V.IsRapid (F <| · * x) | B => ⟨_, (by\n  grw [(exists_height_le_mul isCompact_singleton).choose_spec.2 1 _ ·, mul_pow, mul_left_comm,\n    le_abs_self (_ ^ B), (h B).choose_spec] <;> aesop)⟩\n\nlemma IsRapid.integrable : V.IsRapid F → Continuous F → MeasureTheory.Integrable F V.quotMeasure :=\n  (IsBoundedMeasurable.of ·.bounded · |>.memLp_top.integrable le_top)\n\n/-- The automorphic functions of rapid decay for the space V, as a subrepresentation of the\ncomplex functions on G under right translation by G_f. -/\nnoncomputable def rapidFunctions : Subrepresentation (finRightRep E s) := ⟨.ofLinearComb {y |\n  V.IsAutomorphic y ∧ V.IsRapid y} ⟨0, isAutomorphic_const .., (⟨·, by simp⟩)⟩ fun _ ⟨a, c⟩ _ ⟨b,\n  d⟩ u v ↦ ⟨a.map₂ b\n  (u * · + v * ·), fun _ ↦ ⟨_, (by simp; grw [norm_add_le, add_mul] <;> simp; grw [(c _).choose_spec\n  ·, (d _).choose_spec])⟩⟩, fun _ _ ↦ .imp (·.comp_mul_right _) (·.comp_mul_right)⟩\n\nend Space\n\nvariable {E n : Type} [Field E] [CMType E] [Fintype n] {s} {V : Space E n s} {F}\n\nlemma Space.isRapid_of_isCocompact : Continuous F → V.Γ.FixesLeft F → V.Γ.Cocpt → V.IsRapid F\n  | c, h, ⟨_, K, H⟩, _ => ⟨_, (H · |>.elim fun γ _ ↦ by grw [← h γ, (K.exists_bound_of_continuousOn\n    c.continuousOn).choose_spec,\n    (exists_mul_height_pow_le K _).choose_spec _ γ] <;> simp_all [le_of_lt])⟩\n\nlemma Space.IsAutomorphic.mem_rapidFunctions (h : V.IsAutomorphic F) (d : ∀ i j, s i =\n  s j := by simp) :\n  F ∈ V.rapidFunctions := ⟨h, isRapid_of_isCocompact h.1 h.2 (V.exists_isCompact_of_definite d)⟩\n"),("src/Lib/Adelic/CuspForms/DeltaForms.lean","import Lib.Adelic.Hecke.ClassMean\nimport Lib.GLn.Branching.BranchingVector\n\n/-! Known result: Contravariant form on Weyl's lattice, Fischer product, irreducibility under U(n).\nHere the form is inverse to the Fischer product up to one positive integer, which is bounded\ncrudely, and operator norms are bounded by singular values. Irreducibility is Schur's lemma for\nU(n), which says that what commutes with the action is scalar. Source: Jantzen, Representations of\nAlgebraic Groups, 2nd ed. 2003; Goodman, Wallach, Symmetry, Representations, and Invariants, 2009,\nch. 5; Howe, Perspectives on invariant theory, 1995.\n\nPart of: Cusp forms: rapid decay, finite dimension, Poincaré series; algebraic modular forms (known\nresult; see Lib.Adelic.CuspForms.Petersson).\n\nThis file: Smooth vector-valued forms for a group pair and their right translation. Operator norm of\na Schur functor bounded by powers of singular values. Algebraic modular forms: delta forms, values\nat class representatives, dimension at neat level. -/\n\nopen Complex HasFiniteType ComplexOrder Finset Function PolyRep Matrix MatrixOrder\n\nvariable {G Γ W : Type*} [Group G] [Group Γ] {K : Subgroup G} [AddCommGroup W] [Module ℂ W] {e : Γ\n  →* G} {ρ : Representation ℂ Γ W} {χ : K →* ℂ} [TopologicalSpace G] [IsTopologicalGroup G] {Φ :\n  Type} [Fintype Φ] {n n' : Φ → Type} [∀ τ : Φ, Fintype (n τ)] [∀ τ, Fintype (n' τ)] {κ : Φ → ℕ → ℕ}\n\n/-- Smooth forms: functions φ : G → W with φ(e(γ)g) = ρ(γ)φ(g) whose stabiliser under right\ntranslation is open. -/\ndef SmoothForm (e : Γ →* G) (ρ : Representation ℂ Γ W) := (smoothFunctions ℂ).1 ⊓ ρ.coindV e\n\n/-- The representation of G on smooth forms by right translation. -/\n@[simps! -fullyApplied apply_apply_coe] def smoothFormRep (e : Γ →* G) (ρ : Representation ℂ Γ W) :=\n  (rightRegular ..).subrepresentation (SmoothForm e ρ) fun a _ ↦\n  .imp ((smoothFunctions ℂ).2 a ·) (by simp [mul_assoc, · _])\n\n/-- If the sizes fit κ (`FitsRanks`), then for complex n'_τ×n_τ matrices w_τ, z_τ: S_κ(w)* G'\nS_κ(z) = ∏_τ det(w_τ* z_τ)^{d_τ} · G S_κ(w*z), with G', G the Gram matrices for n', n and\nd_τ given by `schurDetExp`. -/\nlemma PolyRep.schur_conjTranspose_weylGram_schur (hF : FitsRanks n n' κ) (w z : ∀ τ,\n  Matrix (n' τ) (n τ) ℂ) : (schur κ w)ᴴ * ((weylGram n' κ).map (@Int.cast ℂ _) * schur κ z) = (∏ τ,\n  ((w τ)ᴴ * z τ).det ^ schurDetExp n n' κ τ) • (weylGramOver * schur κ fun τ ↦ (w τ)ᴴ * z τ) :=\n  ext_iff_mulVec.2 (by simp [conjTranspose, hF, transpose_map, vecMul_schur_eq_iff,\n  nablaCombination_weylGramOver_mulVec, rowSubst_rowSubst, ← mulVec_mulVec,\n  mulVec_transpose, ↓← det_transpose (_ᴴ * _)])\n\n/-- If the sizes fit κ (`FitsRanks`), there are reals ρ_{τ,i} ≥ 0 with ∑_{i<|n_τ|} ρ_{τ,i} ≤\n∑_{a,b}|z_τ(a,b)|² and ‖S_κ(z)ξ‖² ≤ ∏_τ∏_{i<|n_τ|} ρ_{τ,i}^{λ(τ,i)}·‖ξ‖² for all ξ, where\nλ(τ,i) = ∑_{i<h<|n'_τ|} κ_τ(h) and the norms come from the Gram matrices. -/\nlemma weylNormSq_schur_le (hF : FitsRanks n n' κ) (z : ∀ τ, Matrix (n' τ) (n τ) ℂ) : ∃ ρ :\n  Φ → ℕ → NNReal, (∀ τ, (range (rankAt n τ)).sum (ρ τ) ≤ ∑ a, ∑ b, ‖z τ a b‖ ^ 2) ∧ ∀ ξ, weylNormSq\n    (schur κ z *ᵥ ξ) ≤\n  (∏ τ, ∏ i ∈ range (rankAt n τ), ρ τ i ^ diagramWeight (rankAt n') κ (τ, i)) * weylNormSq ξ := by\n  let := Prop.linearOrder\n  have hA τ := (z τ).posSemidef_conjTranspose_mul_self\n  choose d h2 using (NNReal.canLift.1 _ <| hA · |>.eigenvalues_nonneg ·)\n  choose ρ hρ P using fun τ ↦ univ.induction_on_max_value (d τ) (motive := fun S ↦ ∃ ρ, (range\n    #S).sum ρ = S.sum (d τ) ∧ ∀ A ⊆ S, A.prod (d τ) ≤ (range #A).prod ρ) (by simp) fun a s h _ ⟨ρ,\n    _⟩ ↦ ⟨(·.casesOn (d τ a) ρ), by simp_all [sum_range_succ', add_comm], (·.induction_on_max_value\n    (Eq a) (by simp) (by simp_all [prod_range_succ', mul_comm]; grind [mul_le_mul']))⟩\n  use ρ, (hρ · ▸ by simpa [← real_le_real, h2, conj_mul'] using\n    (hA _).1.trace_eq_sum_eigenvalues.ge.trans_eq sum_comm)\n  have k (M : ℝ) (c : ℂ) h ξ := (Commute.mul_nonneg weylGram_posDef.posSemidef.nonneg (b :=\n    M • 1 - c • schur κ fun τ ↦ diagonal (ofReal ∘ (hA τ).1.eigenvalues)) h (by\n    simp [commute_iff_eq, mul_sub, sub_mul, weylGram_mul_schur]; simp [schur_diagonal_eq_prod])\n    ).posSemidef.re_dotProduct_nonneg (schur κ (star (hA · |>.1.eigenvectorUnitary.1)) *ᵥ ξ)\n  simp [weylNormSq, star_mulVec_dotProduct, schur_conjTranspose_weylGram_schur, hF, mul_assoc,\n    ← star_eq_conjTranspose (star _), mul_sub,\n    sub_mul, ← by simpa [mul_assoc] using (hA · |>.1.spectral_theorem)] at k ⊢; apply k\n  simp [schur_diagonal_eq_prod, ← diagonal_one, le_iff, ← diagonal_smul, ← h2,\n    (hA _).1.det_eq_prod_eigenvalues]\n  norm_cast; grw (transparency := default) [diagramWeight_eq_of_fitsRanks hF, P,\n    (prod_map _ ⟨_, tableau_col_injective ..⟩ _).ge, P] <;> simp +contextual [pow_add,\n    diagramWeight, ← prod_pow_eq_pow_sum, ite_and, prod_pow, field,\n    Finsupp.single_apply, prod_comm, -mem_range]; simp [prod_range (n := rankAt ..)]\n\nattribute [-simp] MonoidHom.coe_range mem_classAut\n\nattribute [local simp] DFunLike.dite_apply classSum mul_assoc\n\nlemma levelSpace_smoothFormRep_apply {φ} (h : φ ∈ levelSpace (smoothFormRep e ρ) K χ) γ g (k : K) :\n    φ.1 (e γ * g * k) = χ k • ρ γ (φ.1 g) := φ.2.2 .. ▸ congr($(h k).1 _)\n\n/-- Two algebraic forms G → W for (Γ, ρ) of level (K, χ) that agree on a system of\nrepresentatives r of the double cosets e(Γ)\\G/K are equal. -/\nlemma eq_of_eq_on_class_reps {r : _ → G} (hr : ∀ c, DoubleCoset.mk e.range K (r c) = c) : Injective\n  (((LinearMap.funLeft ℂ W r).domRestrict _).domRestrict (levelSpace (smoothFormRep e ρ) K χ)) := by\n  simp_intro _ _ _ [funext_iff]; ext; choose _ _ _ _ using exists_eq_map_mul_rep_mul e K hr ‹_›\n  grind [=> levelSpace_smoothFormRep_apply]\n\ninstance : Fact ((1 : K →* ℂ) =ᶠ[nhds 1] 1) := ⟨.rfl⟩\n\n/-- Let K be an open subgroup of G and χ : K → ℂ multiplicative and equal to 1 near the\nidentity. A function f : G → W with f(xk) = χ(k)f(x) for k in K is smooth. -/\nlemma mem_smoothFunctions_of_eigen (χ : K →* ℂ) [o : Fact (χ =ᶠ[nhds 1] 1)] (hK : @IsOpen G _ K) {f}\n    (h : ∀ k : K, rightRegular ℂ G W k f = χ k • f) : f ∈ (smoothFunctions ℂ).1 := (rightStab\n  _).isOpen_of_mem_nhds (hK.isOpenMap_subtype_val.nhds_le 1 (o.1.mono (by simp_all [funext_iff])))\n\nvariable (e ρ χ) [o : Fact (χ =ᶠ[nhds 1] 1)] [H : HasFiniteType e.range K] [i : Fact (Injective e)]\n\n/-- The linear map sending v to the form y ↦ ∑ χ(x⁻¹e(γ)⁻¹y) ρ(γ)v of level (K, χ), summed over\nγ with x⁻¹e(γ)⁻¹y in K; it vanishes off e(Γ)xK. -/\n@[local simp] noncomputable def deltaForm (x : G) : W →ₗ[ℂ] levelSpace (smoothFormRep e ρ) K χ := by\n  choose s h using exists_transporter e.range i.1 .rfl K x\n  refine have t v k := ?_; .codRestrict _ (.codRestrict _ (.pi fun y ↦ ∑ γ ∈ s y, dite _ (χ ⟨x⁻¹ *\n    e γ * y, ·⟩ • ρ γ⁻¹) fun _ ↦ 0) fun v ↦ ⟨mem_smoothFunctions_of_eigen χ H.3 (t v), by\n    simp_intro γ _; apply sum_equiv (.mulRight γ) <;> simp_all⟩) (Subtype.ext <| t · ·)\n  ext; simp [smul_sum]; apply sum_equiv 1 <;> simp_all [mul_mem_cancel_right, smul_smul,\n    ← mul_assoc, mul_comm (χ k), ← map_mul, K.mul_def]\n\n/-- If all stabilisers are trivial, evaluation at representatives r is a linear isomorphism from\nforms of level (K, χ) to W-valued functions on the double cosets e(Γ)\\G/K. -/\nnoncomputable def freeLevelEquiv (h : ∀ g, classAut e.range K g = ⊥) {r : _ → G} (hr : ∀ c,\n  DoubleCoset.mk e.range K (r c) = c := by exact (·.out_eq)) :\n  levelSpace (smoothFormRep e ρ) K χ ≃ₗ[ℂ] DoubleCosets e.range K → W := by\n  refine ⟨_, fun f ↦ ∑ c, deltaForm e ρ χ (r c) (f c), fun _ ↦ eq_of_eq_on_class_reps hr (?t _), ?t⟩\n  intro; ext d; simp [h]\n  rw [sum_eq_single d, sum_eq_single 1]; simp [← K.one_def]\n  repeat grind [card_le_one, sum_eq_zero, e.map_one, one_mem, inv_mul_cancel]\n\nvariable {e ρ χ}\n\n/-- Let e be injective and `HasFiniteType` hold. If additive maps L(g): W → ℂ satisfy\nL(e(γ)xk)(χ(k)ρ(γ)v) = L(x)(v) for all γ, k, the class sum of g ↦ L(g)(δ(g)) is L(x)(v),\nwhere δ is `deltaForm` at x, v. -/\nlemma classSum_deltaForm (L : G → W →+ ℂ) {x v} (hL : ∀ γ (k : K), L (e γ * x * k) (χ k • ρ γ v) =\n  L x v) : classSum e.range K (fun g ↦ L g ((deltaForm e ρ χ x v).1.1 g)) = L x v := by\n  have t y γ := (hL γ⁻¹ ⟨x⁻¹ * e γ * y, ·⟩)\n  simp_all [-Nat.card_eq_fintype_card, Rat.smul_def]\n  rw [sum_eq_single (DoubleCoset.mk _ _ x), sum_eq_card_nsmul (b := L x v), inv_mul_eq_iff_eq_mul₀\n    (by simp)] <;> grind [card_classAut_out, DoubleCoset.out_eq', sum_eq_zero]\n\nvariable [Module.Finite ℂ W]\n\ninstance finite_levelSpace_smoothFormRep : Module.Finite ℂ (levelSpace (smoothFormRep e ρ) K χ) :=\n  .of_injective _ (eq_of_eq_on_class_reps Quot.out_eq)\n\nlemma finrank_levelSpace_smoothFormRep (h : ∀ g, classAut e.range K g = ⊥) :\n  Module.finrank ℂ (levelSpace (smoothFormRep e ρ) K χ) = .card (DoubleCosets e.range K) *\n  Module.finrank ℂ W := by simp [(freeLevelEquiv _ ρ χ h).finrank_eq]\n"),("src/Lib/Adelic/CuspForms/FormRepresentation.lean","import Lib.Adelic.CuspForms.SmoothFormPairing\nimport Lib.GLn.SchurModule.SchurOrthogonality\n\n/-! Part of: Cusp forms: rapid decay, finite dimension, Poincaré series; algebraic modular forms\n(known result; see Lib.Adelic.CuspForms.Petersson).\n\nThis file: Algebraic modular forms: invariant inner product, finite dimension per level. -/\n\nopen Submodule Subgroup ComplexOrder\n\nnamespace Space\n\nvariable {E n} [Field E] [Fintype n] [CMType E] (V : Space E n 1) (κ)\n\n/-- The space of forms of weight κ on a positive definite V carries an inner product for which\nright translation is unitary. -/\nlemma exists_isUnitary_formTranslation : ∃ B, IsUnitary (V.formTranslation κ) B :=\n  ⟨smoothPairing _ (gramForm_conjWeylRep ∘' _), fun φ h ↦ by\n  obtain ⟨⟨l, o⟩, g, h⟩ := pairing_mem_smoothInvariants (fun _ ↦ gramForm_conjWeylRep _) φ φ,\n    Function.ne_iff.1 (h ∘ Subtype.ext)\n  refine smul_pos (by positivity [isCompact_Kf.relIndex_ne_zero o]) (classSum_pos (H :=\n    .of_le inf_le_right (o.and isOpen_Kf)) ?_ ((apply_doubleCoset_out l inf_le_left g).trans_gt ?_))\n    <;> simp [gramForm, weylGram_posDef.posSemidef, weylGram_posDef.dotProduct_mulVec_pos h],\n  smoothPairing_formTranslation _⟩\n\n/-- For an open subgroup K of the finite adelic points and a character χ of K, the forms of\nweight κ on a positive definite V on which K acts through χ form a finite-dimensional\ncomplex vector space. -/\nlemma finite_formTranslation_levelSpace {K : Subgroup _} (hK : K.IsOpen) (χ : K →* ℂ := 1) :\n  Module.Finite ℂ (levelSpace (V.formTranslation κ) K χ) :=\n  @finiteDimensional_of_le _ _ _ _ _ _ _ (finite_levelSpace_smoothFormRep (H := .of_le\n  inf_le_right (hK.and isOpen_Kf)) (χ := χ.comp (inclusion inf_le_left))) fun _ h k ↦ h ⟨k, k.2.1⟩\n"),("src/Lib/Adelic/CuspForms/HeckePolyEval.lean","import Lib.Weil.Unramified.SphericalHecke\n\n/-! Set-up used by: Cusp forms: rapid decay, finite dimension, Poincaré series; algebraic modular\nforms.\n\nThis file: Two normalisations of the Hecke polynomial are reciprocal to each other. -/\n\nlemma eval_heckePoly {E n} [Field E] [NumberField E] [Fintype n] (w : FinPlace E) t {x} (h :\n  x ≠ 0) : (heckePoly w.q (Fintype.card n) t).eval x = x ^ Fintype.card n * heckePolyEval n w t\n  x⁻¹ := by erw [Polynomial.eval_finsetSum, Finset.mul_sum]; congr!; simp_all [pow_sub₀]; ring\n"),("src/Lib/Adelic/CuspForms/LevelForms.lean","import Lib.GLn.Dual.ClassSum\nimport Lib.Adelic.CuspForms.ClassReps\nimport Lib.Adelic.CuspForms.SmoothFormPairing\nimport Lib.Weil.Unramified.UniformiserScalar\nimport Lib.DiscreteSeries.Holomorphic.HolomorphicChamber\n\n/-! Part of: Cusp forms: rapid decay, finite dimension, Poincaré series; algebraic modular forms\n(known result; see Lib.Adelic.CuspForms.Petersson).\n\nThis file: Algebraic modular forms on definite unitary groups: inner product, conjugate norms,\nintegral lattice. -/\n\nnoncomputable section\n\n\nopen Matrix NumberField MvPolynomial ComplexConjugate ComplexOrder Subgroup Real PolyRep Finset\nsection\n\nvariable {E r n : Type} [Field E] [NumberField E] [IsCMField E] [Fintype r] [Fintype n]\n\nvariable (E) in\n/-- The chosen places (`chosenPlace`) and the places over the primes of a twist (`twistPlace`). -/\nstructure LevelPlaces where\n  (ChosenIndex TwistIndex) [fintypeChosen : Fintype ChosenIndex] [fintypeTwist : Fintype TwistIndex]\n  chosenPlace : ChosenIndex → _\n  twistPlace : TwistIndex → FinPlace E\n  apart : IsConjApart (chosenPlace ⊕ᵥ twistPlace)\n\nlemma maxCompactAt_le_levelOf {ι} {u : ι → FinPlace E} {w H} (h : w ∉ (Set.range u).conjClosure) :\n  maxCompactAt n w ≤ levelOf u H :=\n  .trans (by simp_all [LE.le]; grind [star_star]) inf_trivialOn_le_levelOf\n\n/-- The algebra map sending the variable (τ, i, h) to the sum of the variables (τ, i, a) over\nthe indices a with sign s(a) = c and ord(a) = h. -/\ndef fockLetters {Φ} (s : r → ℤˣ) (ord : r → ℕ) (c : ℤˣ) : MatrixPoly (Σ _ : Φ, n) ℂ →ₐ[ℂ]\n    MvPolynomial (Φ × n × r) ℂ := aeval fun x ↦ ∑ a with s a = c ∧ ord a = x.2, X (x.1.1, x.1.2, a)\n\n/-- The linear map sending ξ of weight κ to its polynomial `toPoly` ξ, with each variable\n(τ, i, h) replaced by ∑ X(τ, i, a) over s(a) = c, ord(a) = h. -/\ndef letterPoly {Φ} [Fintype Φ] s ord c κ := (@fockLetters r n _ Φ s ord c).toLinearMap ∘ₗ toPoly _ κ\n\nend\n\nvariable {E n : Type} [Field E] [CMType E] [Fintype n] (P : LevelPlaces E)\n\n/-- The class sum `classSum` for the rational points of the standard definite space I_n, as\na function of the level K and the summand. -/\nabbrev stdClassSum {X} [AddCommMonoid X] [Module ℚ X] := classSum (W := X) (stdSpace E n).Γf\n\nnamespace LevelPlaces\n\nattribute [instance] fintypeChosen fintypeTwist apart\n\nsection\n\nvariable {E : Type} [Field E] [NumberField E] [IsCMField E] (P : LevelPlaces E)\n\ninstance isConjApart_chosenPlace : IsConjApart P.chosenPlace :=\n  ⟨P.apart.1.comp Sum.inl_injective, fun _ _ ↦ P.apart.2 (.inl _) (.inl _)⟩\n\n/-- All places of P: those of `chosenPlace` and of `twistPlace`, indexed by the disjoint union. -/\nabbrev placeAt := P.chosenPlace ⊕ᵥ P.twistPlace\n\n/-- The set of finite places that occur in the families `chosenPlace` or `twistPlace` of P. -/\nabbrev places := Set.range P.placeAt\n\nend\n\nvariable (S : LevelPlaces E) (H : Subgroup (∀ i, GL n (ResField (S.placeAt i)))) (χ : H →* ℂ)\n  (κ : NumberField.InfinitePlace E → ℕ → ℕ) (e : NumberField.InfinitePlace E → ℤ)\n\n/-- The space of algebraic forms of weight (κ, e) on I_n on which the level cut out by H at the\nplaces of S acts through the character χ. -/\ndef LevelForm : Type := levelSpace (algFormRep κ e) _ (χ.comp (levelOf.reduction ..))\n  deriving AddCommGroup, Module ℂ, Module ℚ\n\ninstance : CoeFun (S.LevelForm H χ κ e) fun _ ↦ Gf E n → WeylIndex n κ → ℂ := ⟨(·.1.1)⟩\n\nattribute [local simp] map_classSum mul_classSum mul_sum Rat.smul_def mul_nonneg gramForm_apply\n  toLinearMapₛₗ₂'_apply dotProduct mulVec\nvariable {S H χ κ e} (σ : ℂ ≃+* ℂ) (φ φ' : S.LevelForm H χ κ e)\n\nlemma LevelForm.algFormRep_eq_self_of_mem {k} (hk : k ∈ levelOf S.placeAt ⊥) :\n  algFormRep κ e k φ.1 = φ.1 := by simp [levelSpace_levelOf_apply φ.2 _ 1 (mem_levelOf.1 hk).2]\n\nlemma LevelForm.mem_sphericalAt {w} (hS : w ∉ S.places.conjClosure) : φ.1 ∈ sphericalAt\n  (algFormRep ..) w := by simp [↓algFormRep_eq_self_of_mem, maxCompactAt_le_levelOf hS _]\n\n/-- Evaluation at g, as a complex-linear map on the level forms `S.LevelForm H χ κ e`. -/\ndef _root_.evalForm g := (⟨⟨(· g), by tauto⟩, by tauto⟩ : S.LevelForm H χ κ e →ₗ[ℂ] _)\n\nlemma _root_.apply_eq_evalForm g : φ g = evalForm g φ := rfl\n\n/-- An algebraic form φ on I_n of level H, viewed as a smooth form: it is fixed by a subgroup of\nfinite index in K₀. -/\ndef LevelForm.toSmoothForm : S.LevelForm H χ κ e →ₗ[ℂ] (stdSpace E n).forms (κ, e) :=\n  Submodule.subtype _\n\n/-- For σ ∈ Aut ℂ, the index of the level in K₀ times the pairing `smoothPairing` of smooth forms\nfor the Gram form with σ⁻¹ ∘ conj ∘ σ as conjugation. -/\n@[irreducible] def LevelForm.innerAt := ((stdLevelIndex (levelOf _ H) : ℂ) • smoothPairing\n  (toLinearMapₛₗ₂' ℂ (.comp ↑σ⁻¹ ((starRingEnd ℂ).comp σ)) _ (weylGramOver (κ := κ)))\n  (σ.injective <| by simpa [Int.cast_comm] using\n  gramForm_map_weightRep σ · · ·)).compl₂ (toSmoothForm (χ := χ)) ∘ₛₗ toSmoothForm (χ := χ) (e := e)\n\n/-- The pairing `LevelPlaces.LevelForm.innerAt` σ of φ and φ′ is σ⁻¹ of the class sum, over the\nlevel, of conj(σφ(g))ᵀ G σφ′(g), with G the integral Gram matrix of weight κ. -/\nlemma LevelForm.innerAt_eq_stdClassSum : innerAt σ φ φ' =\n  σ⁻¹ (stdClassSum (levelOf _ H) fun g ↦ gramForm (σ ∘ φ g) (σ ∘ φ' g)) := by\n  unfold innerAt; generalize_proofs; dsimp [smoothPairing]\n  rw [classIntegral_eq_of_le (pairing_mem_smoothInvariants ‹_› ..).1 (fun k hk g ↦ σ.injective (by\n    simp [← mul_assoc, RCLike.mul_conj, ← map_pow, @Complex.norm_eq_one_of_pow_eq_one _\n    (.card H), ne_of_gt, fun φ : LevelForm .. ↦ (congr($(φ.2 ⟨_, hk⟩).1 g) : φ.toSmoothForm.1 _ =\n    χ _ • φ.toSmoothForm.1 g)])) (levelOf_le_Kf (H := H))]; simp [mul_comm]; rfl\n\nlemma LevelForm.conj_innerAt : σ⁻¹ (conj (σ (φ'.innerAt σ φ))) = φ.innerAt σ φ' := by\n  simp [innerAt_eq_stdClassSum, starRingEnd_apply, star_form weylGram_posDef.1, -dotProduct]\n\n/-- Definiteness of the σ-conjugate pairing: if an algebraic form φ of weight (κ, e), level H\nand character χ has `LevelPlaces.LevelForm.innerAt` σ of φ with itself equal to 0, for an\nautomorphism σ of ℂ, then φ = 0. -/\nlemma LevelForm.eq_zero_of_innerAt_self (h : φ.innerAt σ φ = 0) : φ = 0 :=\n  eq_of_eq_on_class_reps Quot.out_eq (funext fun _ ↦ by_contra fun H ↦ (classSum_pos (fun _ ↦\n  weylGram_posDef.posSemidef.dotProduct_mulVec_nonneg _) (weylGram_posDef.dotProduct_mulVec_pos\n  (by simpa [funext_iff] using! H))).ne' ((map_eq_zero _).1 (innerAt_eq_stdClassSum σ φ φ ▸ h :)))\n\ninstance : NormedAddCommGroup (S.LevelForm H χ κ e) := InnerProductSpace.Core.toNormedAddCommGroup\n  (cd := ⟨⟨⟨(·.innerAt 1)⟩, LevelForm.conj_innerAt 1, by simp [LevelForm.innerAt_eq_stdClassSum,\n  classSum, sum_nonneg, ← weylNormSq.eq_1,\n  -dotProduct], by simp, by simp⟩, LevelForm.eq_zero_of_innerAt_self 1⟩)\n\ninstance : InnerProductSpace ℂ (S.LevelForm H χ κ e) := .ofCore _\n\ninstance : FiniteDimensional ℂ (S.LevelForm H χ κ e) := finite_levelSpace_smoothFormRep\n\nattribute [local simp] LevelForm.innerAt_eq_stdClassSum\n\nlemma isOfFinOrder_level_char k : IsOfFinOrder (χ.comp (levelOf.reduction ..) k) :=\n  χ.isOfFinOrder (isMulTorsion_of_finite _)\n\nvariable {E n : Type} [Field E] [NumberField E] [IsCMField E] [Fintype n] {S : LevelPlaces E}\n  {H : Subgroup (∀ i, GL n (ResField (S.placeAt i)))} {χ : H →* ℂ} in\ninstance : Fact (χ.comp (levelOf.reduction _ H) =ᶠ[nhds 1] 1) := ⟨.mono ((isOpen_levelOf (w :=\n  S.placeAt) (H := ⊥)).preimage continuous_subtype_val |>.mem_nhds (by simp)) fun k h ↦ by\n  simp [show levelOf.reduction _ _ k = 1 from Subtype.ext (mem_levelOf.1 h).2]⟩\n\n/-- Let φ, B be forms, σ ∈ Aut ℂ, p a permutation of the infinite places carrying the weight of φ to\nthat of B. If always σ(φ(g)_i) = c·a(g)·B(g)_{p i}, conj σ(conj φ(g)_i) = c'·a'(g)·B(g)_{p i},\na(g)·conj a'(g) = 1, then σ⟨φ,φ⟩ = conj(c')·c·⟨B,B⟩. -/\nlemma map_inner_self_eq {χ' l p c c'} {B : S.LevelForm H χ' _ l} {a a' : _ → ℂ} (h : ∀ g i,\n  σ (φ g i) = c * a g * B g (Equiv.piCongrLeft' _ p i)) (h' : ∀ g i, star (σ (star (φ g i))) =\n  c' * a' g * B g (p.piCongrLeft' _ i)) (hc : ∀ g, a g * star (a' g) = 1) :\n  σ (inner ℂ φ φ) = star c' * c * inner ℂ B B := by\n  set f := p.piCongrLeft' _\n  simp_all [inner, ↓star_involutive.eq_iff, reindex_equiv f, weylGram_eq_submatrix κ p]\n  grind\n\nnamespace LevelForm\n\nvariable (σ : ℂ ≃+* ℂ) {l : ℕ} [Fact l.Prime] (j : PadicPlace l)\n\n/-- For σ ∈ Aut ℂ, the number ‖φ‖²_σ: the class sum of the squared Gram norms of the vectors\nσ(φ(g)). -/\ndef normSqAt := classSum stdRatPoints (levelOf _ H) fun g ↦ weylNormSq (σ ∘ φ g)\n\n/-- Cauchy–Schwarz for conjugates: for algebraic forms x, y and σ ∈ Aut ℂ, |σ⟨y, x⟩| ≤\n‖x‖_σ·‖y‖_{σ′}, where σ′ is σ conjugated by complex conjugation. -/\nlemma norm_map_inner_le : ‖σ\n  (inner ℂ φ' φ)‖ ≤ √(φ.normSqAt σ) * √(φ'.normSqAt ((starRingAut.trans σ).trans starRingAut)) := by\n  simp_rw [inner, innerAt_eq_stdClassSum, normSqAt, classSum, finsum_eq_sum_of_fintype, map_sum]\n  grw [norm_sum_le, ← sum_sqrt_mul_sqrt_le]; gcongr\n  grw [← sqrt_mul, smul_mul_smul, weylNormSq, weylNormSq, ← posDef_cauchy_schwarz weylGram_posDef]\n  repeat simp [-mul_sum]\n\n/-- If u has gauge at most 1 for Weyl's lattice at g under j∘conj, and v has gauge at most 1\nunder j, then the Gram pairing u*Gv is integral with respect to j: ℂ → ℂ_l. -/\nlemma _root_.gramForm_mem_embValRing {g u v} (hu :\n  weylGauge (ι := ⟨j.ιₚ.comp conj⟩) κ e g u ≤ 1) (hv : weylGauge (ι := j) κ e g v ≤ 1) :\n  gramForm (n := n) u v ∈ embValRing (ι := j) := let ⟨γ, h, _⟩ := exists_mul_mem_integralAbove l g 1\n  by erw [← @weylGauge_embFin (γ := γ), @weylGauge_le_one_iff (hk := h),\n       ← gramForm_map_weightRep 1] at *\n     exact sum_mem fun _ _ ↦ mul_mem (hu _) (sum_mem fun _ _ ↦ mul_mem (by simp) (hv _))\n\n/-- The module, over the valuation ring of j: ℂ → ℂ_l, of forms φ with every value φ(g) of gauge\nat most 1 for Weyl's lattice at g under j. -/\ndef integralForms : Submodule embValRing (S.LevelForm H χ κ e) :=\n  .copy ((integralFormsAt ⊤ 1).comap (toSmoothForm.restrictScalars _)) {φ | ∀ g,\n  weylGauge κ e g (φ g) ≤ 1} (by unfold integralFormsAt GaugeLe; aesop (add simp top_inf_eq))\n\n/-- If x is integral at j∘conj, y is integral at j, and A is divisible by the orders of all\nstabilisers at the level, then |j(A·⟨x, y⟩)| ≤ 1. -/\nlemma norm_inner_le_one {A} (hA : ∀ g, Nat.card (classAut stdRatPoints (levelOf _ H) g) ∣ A)\n    (a : φ ∈ integralForms ⟨j.ιₚ.comp conj⟩) (b : φ' ∈ integralForms j) : ‖j.ιₚ (A • inner ℂ φ\n  φ')‖ ≤ 1 := by simpa only [inner, innerAt_eq_stdClassSum] using!\n  smul_classSum_mem _ hA (gramForm_mem_embValRing j (a _) <| b ·)\n\nvariable {J : Type} [Fintype J] (y : J → S.LevelForm H χ κ e) {V β : ℝ}\n\n/-- For automorphisms σ_i of ℂ, the matrix whose (i, l) entry is the class sum over g of the\nGram pairing of σ_i(y_i(g)) with σ_l(y_l(g)), conjugate linear in the first. -/\ndef pairingMatrix (σ : J → ℂ ≃+* ℂ) :=\n  of fun i l ↦ stdClassSum (levelOf _ H) fun g ↦ gramForm (σ i ∘ y i g) (σ l ∘ y l g)\n\n/-- The squared covolume of the family y at σ: the absolute value of the determinant of the\nmatrix of products ⟨y_i, y_l⟩_σ of the σ-conjugated values. -/\ndef covolumeSq σ := ‖(pairingMatrix y fun _ ↦ σ).det‖\n\nvariable {y} {σ} {k : ℕ} {z : Fin k → S.LevelForm H χ κ e} (hz : ∀ a, (z a).normSqAt σ ≤ exp β)\n\nopen MatrixOrder in\nlemma posSemidef_pairingMatrix {σ} : (pairingMatrix y σ).PosSemidef := Eq.subst (a := stdClassSum\n  (levelOf _ H) fun g ↦ let T := of fun a i ↦ σ i (y i g a); Tᴴ * weylGramOver * T) (by\n    simp [pairingMatrix, classSum, Matrix.mul_assoc, Matrix.sum_apply, entrywise]) (finsum_nonneg\n  fun _ ↦\n  ((weylGram_posDef.posSemidef.conjTranspose_mul_mul_same _).smul (by simp)).nonneg).posSemidef\n\n/-- If the squared covolume of y is at most e^V at every automorphism of ℂ, then |σ(det G)| ≤\ne^V for the Gram matrix G of y. -/\nlemma norm_map_det_gram_le (h : ∀ σ, covolumeSq y σ ≤ exp V) : ‖σ (Matrix.gram ℂ y).det‖ ≤\n  exp V := by simpa [σ.map_det, pairingMatrix, inner, toBlocks₁₂, Matrix.map] using\n  le_of_sq_le_sq ((norm_det_sq_le_of_posSemidef ((fromBlocks_toBlocks\n  (pairingMatrix (y ⊕ᵥ y) (cond ·.isLeft ((starRingAut.trans σ).trans starRingAut)\n  σ))).substr posSemidef_pairingMatrix)).trans (by rw [sq]; gcongr <;> apply h)) V.exp_nonneg\n\ninclude hz\n\n/-- Hadamard's inequality: k forms of squared norm at most e^β at σ have squared covolume at\nmost e^(kβ) at σ. -/\nlemma covolumeSq_le : covolumeSq z σ ≤ exp (k * β) := by\n  grw [covolumeSq, hadamard_det_inequality posSemidef_pairingMatrix, exp_nat_mul,\n    ← Fin.prod_const]; gcongr\n  simpa [↓← Complex.re_eq_norm.2 posSemidef_pairingMatrix.diag_nonneg, pairingMatrix, normSqAt,\n    weylNormSq, ← Complex.reLm_coe] using hz _\n\n/-- Adjoining k forms of squared norm at most e^β at σ to a family of squared covolume at most\ne^V gives squared covolume at most e^(V + kβ). -/\nlemma covolumeSq_elim_le (h : covolumeSq y σ ≤ exp V) : covolumeSq (y ⊕ᵥ z) σ ≤\n  exp (V + k * β) := by grw [exp_add, ← h, ← covolumeSq_le hz]; exacts\n  [fischer_det_inequality posSemidef_pairingMatrix, norm_nonneg _]\n"),("src/Lib/Adelic/CuspForms/Petersson.lean","import Lib.Adelic.CuspForms.RealConvolution\n\n/-! Known result: rapid decay, finite dimension and Poincaré series for cusp forms, and algebraic\nmodular forms. Here a form is a bounded function reproduced by an integrable minimal idempotent,\nwith no differential equation. Cuspidality is a bound by the oscillation along unipotent orbits,\nwith explicit depth, and the cusp is spanned by the shortest vectors of a sorted Minkowski basis.\nSource: A. Borel, Automorphic forms on reductive groups (Park City lectures), 7.6-7.9 and 8.3-8.4;\nI. Satake, Caractérisation de l'espace des Spitzenformen, Sém. H. Cartan 10 (1957/58), exp. 9 bis;\nR. Godement, Série de Poincaré et Spitzenformen, ibid., exp. 10; R. Godement, The spectral\ndecomposition of cusp forms, Proc. Sympos. Pure Math. 9 (1966) 225-234; S. Miller and W. Schmid, On\nthe rapid decay of cuspidal automorphic forms, Adv. Math. 231 (2012), arXiv 1106.2149; G. Muić,\nSmooth cuspidal automorphic forms and integrable discrete series, arXiv 1610.05483 (cuspidality\nthrough N. Wallach, On the constant term of a square integrable automorphic form, 1984); B. Gross,\nAlgebraic modular forms, Israel J. Math. 113 (1999) 61-93.\n\nPart of: Theta kernels of unitary dual pairs: functoriality, seesaw, growth, rapid decay (known\nresult; see Lib.Weil.DualPair.KernelDecay).\n\nThis file: Every conjugate of a small ball in U(J) contains a dilation along an isotropic subspace.\nAfter a rational translation, the pair's operator norm is bounded by a height power. Bounded forms\nof integrable discrete series type are cuspidal. Petersson product: invariance, self-adjoint\nprojector, rank-one action on real translates of forms. -/\n\nopen Matrix Submodule U Norms.L2Operator MatMul Space G Prod\n\n/-- Let J be a hermitian involution, A totally isotropic, x∈U(J), c>0. Some y in U(J) has ‖y−1‖\n≤ c and g = xyx⁻¹ acts on A by the scalar 1+c and satisfies w*Jgv = w*Jv for all v, w\northogonal to A. -/\nlemma ex