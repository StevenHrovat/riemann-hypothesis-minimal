, s, t⟩ := witt_Ohat_of_orthonormal (C 1) (C (_ * (_ * 1))) (by simp [IsIntMatrix])\n    (fun _ ↦ (congr(_ *ᵥ $e) ▸ h') ·)\n  use ⟨⟨_, _, rfl⟩, rfl⟩, ⟨k, s⟩, congr($tᵀ _)\n  rintro ⟨⟨⟨_, γ, ⟨⟩⟩, H⟩, k, hk⟩\n  cases H.symm.trans congr($((mul_one _).trans (stdSpace_embFin γ)).1ᵀ _)\n  exact ⟨_, ⟨by simpa using! congr($(C γ) 0 0), (congr($hk ·).subst ((k * 1).2.isIntMatrix _ _))⟩,\n    rfl⟩\n"),("src/Lib/Adelic/Unitary/CongruenceLevel.lean","import Lib.General.Groups.CompactMean\nimport Lib.General.LinearAlgebra.ColumnLattices\nimport Lib.Adelic.Adeles.LocalComponents\n\n/-! Known result: congruence subgroups and level structures of adelic groups. Here levels are taken\nin the unitary group of the identity form. They are preimages of subgroups of the reductions at\nfinitely many split places, or principal levels of a global modulus. Source: V. Platonov, A.\nRapinchuk, ch. 3 and 5; B. H. Gross, Algebraic modular forms, Israel J. Math. 113 (1999) 61-93.\n\nKnown result: the Iwasawa–Bruhat decomposition of GL_n over a local field, and the Iwahori\nfactorisation. Row operations write every element as unitriangular times monomial times an element\nof the pro-p Iwahori group, and that group factors into upper and lower parts. Only existence is\nproved, with no double cosets of the Iwahori group and no uniqueness. Source: Iwahori–Matsumoto,\nPubl. IHES 25 (1965); Casselman, Introduction to admissible representations of p-adic groups: GL_n\n(notes), §13.\n\nPart of: Exponents, U-operators and spherical vectors at pro-p Iwahori level; conjugacy in I t I\n(known result; see Lib.LocalGL.Tadic.ChainLemma).\n\nThis file: Reduction maps, principal levels, levels cut out by reductions at split places; index.\nParahoric and pro-p Iwahori groups, dominant cone, exponents, multiplicativity of U-operators.\nPrincipal congruence subgroups: neighbourhood basis, index bound, quotients of profinite\nintegers. -/\nseal Finset.univ Finset.sum Finset.prod\n\nnoncomputable section\n\nsection\n\nopen Function Matrix NumberField IsLocalRing Subgroup Kf Gf Ideal Valued algebraMap\nvariable {n ι R S E : Type*} [Fintype n] [CommRing R] [CommRing S] [Field E] [NumberField E]\n  {w : FinPlace E} {a b : 𝓞 E}\n\nlemma GL_map_surjective (f : R →+* S) [IsLocalHom f] : Surjective f →\n    Surjective (GeneralLinearGroup.map (n := n) f) := (surjective_units_map_of_local_ringHom _\n  ·.comp_left.comp_left ⟨by simp [↓isUnit_iff_isUnit_det, ↓← f.map_det]⟩)\n\n/-- The reduction homomorphism from GL_n(O_w) to GL_n of the residue field at w. -/\ndef reduceGL := intGL.map (n := n) (O := v.integer) (S := ResField w) (residue (LocInt w))\n\nlemma reduceGL_surjective : Surjective (reduceGL (n := n) (w := w)) :=\n  (GL_map_surjective (residue (LocInt _)) residue_surjective).comp (⟨⟨_, ·, rfl⟩, rfl⟩)\n\nlemma isUnit_algebraMap_finAdele (h : a ≠ 0) : IsUnit (a : 𝔸f E) :=\n  .map (algebraMap E _) (.mk0 (a : E) (by simpa))\n\n/-- For an integer a of E, a finite adele y lies in aÔ if and only if y lies in Ô and |y|_u ≤\n|a|_u at every finite place u dividing a. -/\nlemma mem_span_iff_valuation_le {y} : y ∈ Ô E ∙ ↑a ↔ y ∈ Ô E ∧ ∀ u, a ∈ u.1 → v (y u) ≤\n  u.intValuation a := by\n  simp [↓exists_eq_mul_iff_v_le, mem_Ô, ← forall_and]; peel with u\n  erw [v_algebraMap_eq_intValuation a]; grind [u.intValuation_le_one a, u.intValuation_eq_one_iff]\n\nvariable [IsCMField E] (n a) {f : Ô E →+* S}\n\n@[simp] lemma Kf.map_apply g i j : map n f g i j = f ⟨_, mem_Kf.1 g.2 i j⟩ := rfl\n\nlemma Kf.map_eq_one {g} : map n f g = 1 ↔\n    ∀ i j, f (⟨_, mem_Kf.1 g.2 i j⟩ - ⟨_, mem_Kf.1 (one_mem _) i j⟩) = 0 := intGL.map_eq_one\n\n/-- The principal level K(a): the subgroup of g in K₀ = `Kf` with all entries of g − 1 in\naÔ, for an integer a of E. -/\ndef principalLevel : Subgroup (Gf E n) := .copy ((congruenceGL (Ô E ∙ _) id).subgroupOf _) {g ∈\n  Kf .. | ∀ i j, ∃ y ∈ _, (g.1.1 - 1) i j = algebraMap _ _ a * y} (by aesop (add simp congruenceGL))\n\nvariable {n a k} (hk : k ∈ principalLevel n a) {k : Kf E n}\n\nlemma map_eq_one_of_principalLevel (e : f a = 0) : map n f ⟨_, hk.1⟩ = 1 := (map_eq_one n).2\n  fun i j ↦ (RingHom.ker f).mem_of_dvd (by simpa [dvd_def, Subtype.ext_iff] using! hk.2 ..) e\n\nomit [IsCMField E] in\nlemma isOpen_congruenceGL_span (h : a ≠ 0) : (congruenceGL (Ô E ∙ ↑a) (@id n)).IsOpen\n  := isOpen_congruenceGL isOpen_Ô\n  (Eq.subst (by aesop) ((isUnit_algebraMap_finAdele h).isOpenMap_smul _ isOpen_Ô))\n\nlemma isOpen_principalLevel (h : a ≠ 0) : (principalLevel n a).IsOpen :=\n  (copy_eq ..).symm.subst (isOpen_congruenceGL_span h).preimage_val\n\nlemma principalLevel_le_Kf : principalLevel n a ≤ Kf .. := fun _ ↦ (·.1)\n\ninstance [Fact (a ≠ 0)] : IsLevel (principalLevel n a) :=\n  ⟨principalLevel_le_Kf, isOpen_principalLevel Fact.out⟩\n\nlemma principalLevel_le_of_dvd : a ∣ b → principalLevel n b ≤ principalLevel n a := fun ⟨c, e⟩ _ ↦\n  .imp_right (forall₂_imp\n  fun _ _ ⟨_, h, r⟩ ↦ ⟨_, mul_mem (coe_mem_Ô c) h, by simpa [e, mul_assoc] using! r⟩)\n\n/-- Known result: Congruence subgroups and level structures of adelic groups. -/\nlemma exists_principalLevel_subset {s} (h : s ∈ nhds 1) : ∃ M ≠ 0,\n  SetLike.coe (principalLevel n (Nat.cast M : 𝓞 E)) ⊆ s\n  := ((mem_nhds_induced ..).1 h).elim fun _ b ↦ (exists_congruenceGL_subset b.1).imp fun _ ↦\n  .imp_right fun c _ k ↦ b.2 (c _ (by simpa [principalLevel, congruenceGL] using! k))\n\ninstance : NonarchimedeanGroup (Gf E n) := ⟨fun _ h ↦ (exists_principalLevel_subset h).rec\n    (⟨⟨principalLevel n ·, isOpen_principalLevel (by aesop)⟩, ·.2⟩)⟩\n\nlemma Kf.reduceAt_eq_of_atPlace {t} (h : k.1.atPlace w = .map (LocInt w).subtype t) : reduceAt w k =\n  .map (residue _) t := congr(reduceGL ⟨$h, t, by aesop⟩)\n\nlemma Kf.reduceAt_eq_one_of_atPlace : k.1.atPlace w = 1 →\n  reduceAt w k = 1 := by simpa using reduceAt_eq_of_atPlace (t := 1)\n\nvariable (w : ι → FinPlace E) (H : Subgroup (∀ i, GL n (ResField (w i))))\n\n/-- The family w of finite places of the CM field E is injective and no w j is the conjugate of\nany w i; in particular no w i is its own conjugate. -/\nclass IsConjApart where\n  injective : Injective w\n  star_ne i j : star (w i) ≠ w j\n\n/-- The homomorphism from K₀ to ∏_i GL_n(k_{w_i}) given by reduction modulo each place of the\nfamily w_i. -/\ndef Kf.reduceFamily : Kf E n →* ∀ i, GL n (ResField (w i)) := .pi (reduceAt <| w ·)\n\n/-- The subgroup of G_f of elements of K₀ whose reductions modulo the places w_i form an element\nof the subgroup H of ∏_i GL_n(k_{w_i}). -/\ndef levelOf := (H.comap (reduceFamily w)).map (Kf ..).subtype\n\nvariable {w H}\n\nlemma levelOf_le_Kf : levelOf w H ≤ Kf .. := map_subtype_le _\n\nlemma mem_levelOf {g} : g ∈ levelOf w H ↔ ∃ h, reduceFamily w ⟨g, h⟩ ∈ H := by simp [levelOf]\n\nvariable (w H) in\n/-- The homomorphism from the level `levelOf` w H to H given by reduction modulo the places w_i. -/\ndef levelOf.reduction : levelOf w H →* H :=\n  ((reduceFamily w).comp (inclusion levelOf_le_Kf)).codRestrict _ (mem_levelOf.1 ·.2 |>.2)\n\nlemma inf_trivialOn_le_levelOf : Kf .. ⊓ trivialOn n (.range w) ≤ levelOf w H :=\n  fun _ k ↦ ⟨⟨_, k.1⟩, H.ker_le_comap _ (funext fun _ ↦ reduceAt_eq_one_of_atPlace (by aesop)), rfl⟩\n\nlemma principalLevel_le_levelOf (h : ∀ i, a ∈ (w i).1) : principalLevel n a ≤ levelOf w H :=\n  fun _ k ↦ ⟨_, H.ker_le_comap _ (funext fun _ ↦ map_eq_one_of_principalLevel k (by aesop)), rfl⟩\n\nvariable [Finite ι]\n\nlemma isOpen_levelOf : (levelOf w H).IsOpen :=\n  isOpen_mono (principalLevel_le_levelOf (mem_iInf.1 (absNorm_mem _))) (isOpen_principalLevel\n  (mod_cast (Finite.of_injective _ (quotientInfToPiQuotient_inj _)).card_pos.ne'))\n\ninstance : IsLevel (levelOf w H) := ⟨levelOf_le_Kf, isOpen_levelOf⟩\n\n@[simp] lemma relIndex_ne_zero_of_isLevel K [h : IsLevel K] : K.relIndex (Kf E n) ≠ 0 :=\n  isCompact_Kf.relIndex_ne_zero h.2\n\nvariable [h : IsConjApart w]\n\nomit [Finite ι] in\nlemma reduceFamily_atSplit i (k : Kw n _) : reduceFamily w ⟨atSplit (h.2 i i) k, by simp⟩ =\n    Pi.mulSingle i (reduceGL k) := eq_update_iff.2 ⟨reduceAt_eq_of_atPlace (atPlace_atSplit ..),\n  fun _ e ↦ reduceAt_eq_one_of_atPlace (atPlace_atSplit_of_ne _ _ (h.1.ne e) (h.2 _ _))⟩\n\nlemma exists_reduceFamily_eq s : ∃ k, k.1 ∈ supportedOn n (.range w) ∧ reduceFamily w k = s :=\n  (((supportedOn ..).subgroupOf _).map _).pi_mem_of_mulSingle_mem s fun i ↦ ⟨_, by simp_all\n  [eq_comm, atPlace_atSplit_of_ne], surjInv_eq reduceGL_surjective (s i) ▸ reduceFamily_atSplit ..⟩\n\n/-- Known result: Congruence subgroups and level structures of adelic groups. -/\nlemma relIndex_levelOf : (levelOf w H).relIndex (Kf ..) = H.index := (congrArg _ (comap_map_eq_self\n  (by simp))).trans (H.index_comap_of_surjective (exists_reduceFamily_eq · |>.imp (by simp)))\n\nend\n\nsection\n\nopen Finset Equiv IsLocalRing Matrix Valued WithZero\n\nattribute [-simp] _root_.map_add _root_.map_sub\n\nvariable {n R : Type*} [Fintype n] [CommRing R]\n\n/-- The homomorphism sending a permutation σ to the permutation matrix in GL_n(R) that maps e_i\nto e_{σ(i)}. -/\nabbrev permGL : Perm n →* GL n R := permMatrixHom.toHomUnits\n\nlemma permGL_mem_intGL σ {O : Subring R} : permGL σ ∈ intGL n O := ⟨permGL σ, by aesop⟩\n\nlemma diagGL_mul_permGL (t : n → Rˣ) σ : diagGL t * permGL σ = permGL σ * diagGL (t ∘ σ) := by aesop\n\nattribute [local simp] Perm.inv_def BlockTriangular diagonal_apply Matrix.single transvection\n  PEquiv.mul_toMatrix_toPEquiv PEquiv.toMatrix_mul_apply Units.val_inj mem_intGL_iff_det zero_lt_iff\n\nattribute [simp] Representation.inv_apply_eq_iff\n\nvariable (σ : Perm n) {i j : n} (h : i ≠ j) {F : Type*} [Field F] [Valued F ℤᵐ⁰]\n\nlemma permGL_mul_transvectionGL (a : R) : permGL σ * transvectionGL h a =\n  transvectionGL (σ.injective.ne h) a * permGL σ := by aesop\n\ninstance : IsLocalRing 𝒪[F] := inferInstance\n\n@[simp high] lemma residue_eq_zero_iff_lt {a} :\n    residue 𝒪[F] a = 0 ↔ v a.1 < 1 := residue_eq_iff_valuation_sub_lt_one.trans (by simp)\n\n@[local simp] lemma residue_eq_one_iff_lt {a} : residue 𝒪[F] a = 1 ↔ v (a.1 - 1) < 1 :=\n  residue_eq_iff_valuation_sub_lt_one\n\nattribute [local grind .] Valuation.zero_iff mul_lt_of_lt_of_le_one one_pos zero_le zero_lt_iff\n\nvariable {g : GL n F} [CompactSpace 𝒪[F]] (P : GL n F → Prop) [LinearOrder n]\n\ninstance : Finite 𝓀[F] := have := @integer.isPrincipalIdealRing_of_compactSpace F; inferInstance\n\n/-- The open subgroup of the g in GL_n(𝒪) satisfying P, where on GL_n(𝒪) the property P means\nthat the reduction modulo 𝔭 lies in the subgroup H. -/\ndef residuePreimage (H : Subgroup _) (e : ∀ k, intGL.map (residue 𝒪[F]) k ∈ H ↔ P k.1) :\n    OpenSubgroup (GL n F) := ⟨((H.comap (intGL.map (residue _))).map (Subgroup.subtype _)).copy {g ∈\n  intGL .. | P g} (by aesop), (congruenceGL (v.ltSubmodule 1) id).isOpen_mono (fun g ⟨a, _⟩ ↦ ⟨a, by\n  rw [← e ⟨g, a⟩, intGL.map_eq_one.2]; simp; simpa⟩)\n  (isOpen_congruenceGL (isOpen_integer F) (by simpa using! isOpen_ball F 1))⟩\n\n/-- For a level function b on the indices, the parahoric subgroup of the g in GL_N(𝒪) with g_ij\n∈ 𝔭 whenever b(j) < b(i). -/\ndef blockParahoric {N} (b : ℕ → ℕ) := (residuePreimage (fun g : GL (Fin N) F ↦ ∀ i j,\n  b j.1 < b i.1 → v (g i j) < 1) (parabolic (b ·)) (by simp [parabolic])).1\n\nvariable {P : GL n F → Prop} (ρ : Rep ℂ (GL n F)) [IsSmoothRep ρ.ρ] (ξ : (n → Fˣ) →* ℂˣ) {t : n →\n  Fˣ}\n\n/-- The monoid of dominant elements of the torus: families t of units of F with |t_i| ≤ |t_j|\nfor i ≤ j. -/\ndef dominantTorus : Submonoid (n → Fˣ) :=\n  ⟨⟨{t | Monotone (v <| t · |>.1)}, by simpa using .mul'⟩, by tauto⟩\n\nomit [LinearOrder n] in\nlemma isCompact_residuePreimage {H e} : IsCompact (residuePreimage P H e).carrier :=\n  (isCompact_intGL\n  (isCompact_iff_compactSpace.2 ‹_›)).of_isClosed_subset (residuePreimage ..).isClosed inf_le_left\n\ninstance {N b} : CompactSpace (@blockParahoric F _ _ N b) := isCompact_residuePreimage.compactSpace\n\n/-- The pro-p Iwahori subgroup I₁ of GL_n(𝒪): matrices that are upper triangular with ones on the\ndiagonal modulo the maximal ideal. -/\ndef proIwahori := (residuePreimage (fun g : GL n F ↦ (∀ i j, j < i → v (g i j) < 1) ∧ ∀ i,\n  v (g i i - 1) < 1) (unitriangular id _) (by simp [apply_ite]; grind)).1\n\ninstance : CompactSpace (proIwahori : Subgroup (GL n F)) := isCompact_residuePreimage.compactSpace\n\nomit [CompactSpace 𝒪[F]] in\nlemma isOpen_proIwahori : (proIwahori : Subgroup (GL n F)).IsOpen := (residuePreimage ..).2\n\n/-- An exponent: a linear form l invariant under the pro-p Iwahori subgroup I₁, with l(ρ(diag\nt)x) = ξ(t) l(x) for t dominant and x fixed by I₁. -/\nabbrev IsExponent (l : ρ →ₗ[ℂ] ℂ) := ∀ ⦃t⦄, t ∈ dominantTorus → ∀ x,\n  l (ρ (diagGL t) (compactMean ρ.ρ proIwahori x)) = ξ t * l x\n\n/-- x is a nonzero vector fixed by the pro-p Iwahori subgroup I₁ with U_t x = ξ(t) x for all\ndominant t, U_t of level I₁. -/\ndef IsIwahoriEigen x := x ≠ 0 ∧ x ∈ levelSpace ρ.ρ proIwahori ∧ ∀ t ∈ dominantTorus,\n  compactMean ρ.ρ proIwahori (ρ (diagGL t) x) = (ξ t).1 • x\n\n/-- The normalised absolute value on F^×, as a character with complex values: x ↦ q^{−ord x}, q\nthe order of the residue field. -/\ndef normAbsChar : Fˣ →* ℂˣ := .mk' (fun x ↦ .mk0 (Nat.card 𝓀[F]) NeZero.out ^ (v x.1).log)\n    (by simp [_root_.zpow_add])\n\n/-- The bijection sending a family (θ_i), 0 ≤ i < N, of characters of F^× to the character t ↦ ∏\nθ_i(t_i)|t_i|^{N−1−i} of the diagonal torus. -/\ndef torusChar {N} := (Equiv.mulRight fun i : Fin N ↦ normAbsChar (F := F) ^ i.rev.1).trans\n    (Pi.monoidHomMulEquiv ..).symm.1\n\n@[simp] lemma torusChar_mulSingle {N θ} (i : Fin N) (x : Fˣ) : torusChar θ (Pi.mulSingle i x) =\n  θ i x * normAbsChar x ^\n  i.rev.1 := by simp [torusChar, Pi.monoidHomMulEquiv, Pi.mulSingle_apply, apply_ite]\n\nomit [CompactSpace 𝒪[F]] in\nlemma exists_proIwahori_coe_eq (M : Matrix n n F) (a : ∀ i j, v (M i j) ≤ 1) (h :\n  (∀ i j, j < i → v (M i j) < 1) ∧ ∀ i, v (M i i - 1) < 1) : ∃ g ∈ proIwahori, g.1 = M :=\n  ⟨_, ⟨⟨.mk'' (of (⟨_, a · ·⟩)) (.of_map (residue _) _ (by simp_all [RingHom.map_det,\n  det_of_isUpperTriangular, residue_eq_one_iff_lt.2])), rfl⟩, h⟩, rfl⟩\n\nomit [CompactSpace 𝒪[F]] in\n@[local simp] lemma mem_proIwahori : g ∈ proIwahori ↔ (∀ i j, v (g i j) ≤ 1) ∧ (∀ i, ∀ j < i,\n  v (g i j) < 1) ∧ ∀ i, v (g i i - 1) < 1 :=\n  ⟨.imp_left (mem_intGL.1 · |>.1), by simpa using exists_proIwahori_coe_eq g.1⟩\n\nsection\n\nomit [CompactSpace 𝒪[F]]\n\nlemma mem_proIwahori_iff_of_unitriangular (u : g ∈ unitriangular id _) :\n    g ∈ proIwahori ↔ ∀ i j, i < j → v (g i j) ≤ 1 := by simp_all; grind\n\nlemma transvectionGL_mem_proIwahori {a : F} (H : v a < 1 ∨ v a ≤ 1 ∧ i < j) :\n  transvectionGL h a ∈ proIwahori := by simp; grind\n\nomit [LinearOrder n] in\nlemma diagGL_mem_intGL (h : ∀ i, v (t i).1 = 1) : diagGL t ∈ intGL n 𝒪[F] := by aesop\n\nlemma v_diag_eq_one_of_mem_proIwahori (h : g ∈ proIwahori) j :\n  v (g j j) = 1 := by simpa using v.map_one_add_of_lt (h.2.2 j)\n\n/-- Iwasawa and Bruhat decompositions at once: every g in GL_n(F) is u·t·σ·k with u upper\nunitriangular over F, t diagonal, σ a permutation matrix and k in the pro-p Iwahori\nsubgroup.\n\nKnown result: Iwasawa–Bruhat decomposition of GL_n over a local field; Iwahori factorisation. -/\nlemma exists_iwasawa_bruhat (g : GL n F) : ∃ u ∈ unitriangular id F,\n  (∃ t σ, (diagGL t * permGL σ)⁻¹ * (u⁻¹ * g) ∈ proIwahori) ∧\n  (g ∈ proIwahori → u ∈ proIwahori ∧ ∀ i j, i < j → (u⁻¹ * g) i j = 0) := by\n  have ⟨m, u, k, p, h⟩ : ∃ m, g / m ∈ unitriangular id F ∧ (g ∈ proIwahori → m ∈ proIwahori) ∧ ∃ p :\n    Perm n, ∀ i ∈ univ, let x := m i (p i)\n    x ≠ 0 ∧ (∀ l, v (m i l) < v x ∨ v (m i l) = v x ∧ p i ≤ l) ∧ ∀ r < i, m r (p i) = 0 :=\n      univ.induction_on_min ⟨g, by simp⟩ fun a s h ⟨m, u, k, p, _⟩ ↦ by\n    have ⟨j, _⟩ := exists_minimal_of_wellFoundedLT _ (univ.exists_max_image (v ∘ m a) ⟨a, by simp⟩)\n    use .mk'' (updateCol 1 a fun r ↦ ite (r < a) (-m r j / m a j) (diagonal 1 r a)) ?_ * m,\n      div_mul_eq_div_div_swap g .. ▸ div_mem u ?_, (mul_mem ?_ <| k ·), swap (p a) j * p <;>\n      simp [← cramer_apply, updateCol_apply, mul_apply, apply_ite v, sum_ite,\n      filter_eq', swap_apply_def] <;> grind [v_diag_eq_one_of_mem_proIwahori, div_one, Minimal,\n      mem_proIwahori.1 ∘ k, m.det_ne_zero, det_eq_zero_of_row_eq_zero a, le_zero_iff]\n  refine ⟨_, u, ⟨(.mk0 _ <| h · (by simp) |>.1), p⁻¹, ?_⟩, (⟨div_mem · (k ‹_›), ?_⟩)⟩ <;> simp\n    [← map_inv, mul_assoc] <;> grind [inv_mul_le_one₀, inv_mul_lt_one₀,\n    v_diag_eq_one_of_mem_proIwahori, mem_proIwahori]\n\nlemma diagGL_conj_mem_proIwahori (k : g ∈ proIwahori) (h : g.1.BlockTriangular (v <| t · |>.1)) :\n  diagGL t * g * (diagGL t)⁻¹ ∈\n  proIwahori := by simp_all [← map_inv, mul_inv_le_iff₀', mul_inv_lt_iff₀']; grind\n  [mul_le_of_le_of_le_one, mul_lt_of_lt_one_right, mul_zero, Units.ne_zero]\n\nlemma exists_unipotent_conj_mem_proIwahori (ht : t ∈ dominantTorus) (h : g ∈ proIwahori) :\n    ∃ u ∈ unitriangular id F ⊓ proIwahori, (diagGL t)⁻¹ * (u⁻¹ * g) * diagGL t ∈ proIwahori :=\n  (exists_iwasawa_bruhat g).imp fun _ _ ↦ by refine ⟨?_,\n  diagGL_conj_mem_proIwahori (t := t⁻¹) ?_ ?_⟩ <;> simp_all [mul_mem, inv_lt_inv₀, ht.reflect_lt]\n\nlemma conj_unitriangular_mem_proIwahori (ht : t ∈ dominantTorus) (hu :\n  g ∈ unitriangular id F ⊓ proIwahori) : diagGL t * g * (diagGL t)⁻¹ ∈ proIwahori :=\n  diagGL_conj_mem_proIwahori hu.2 (by simp_all; grind [ht.reflect_lt])\n\nend\n\n/-- For a smooth representation of GL_n(F), dominant t, t' and x fixed by the pro-p Iwahori\nsubgroup I₁, the operators U_t = (mean over I₁)∘ρ(diag t) satisfy U_t U_{t'} x = U_{tt'} x. -/\n@[local simp] lemma iwahori_operator_mul {ρ : Rep ℂ (GL n F)} [IsSmoothRep ρ.ρ] {t t' : n → _} {x}\n    (ht : t ∈ dominantTorus) (ht' : t' ∈ dominantTorus) (hx : x ∈ levelSpace ρ.ρ proIwahori) :\n  compactMean ρ.ρ proIwahori (ρ (diagGL t) (compactMean ρ.ρ proIwahori (ρ (diagGL t') x))) =\n  compactMean ρ.ρ proIwahori (ρ (diagGL (t * t')) x) := by rw [map_compactMean_of_factor _ fun _ k ↦\n  (exists_unipotent_conj_mem_proIwahori ht' k).imp fun _ ↦\n  .imp (conj_unitriangular_mem_proIwahori ht) (by simpa using hx ⟨_, ·⟩)] <;> simp_all\n\n/-- The monoid homomorphism t ↦ U_t from dominant torus elements to endomorphisms of the vectors\nfixed by the pro-p Iwahori subgroup. -/\ndef iwahoriHeckeHom : @dominantTorus n F _ _ _ →* Module.End ℂ (levelSpace ρ.ρ proIwahori) :=\n    ⟨⟨fun t ↦ (compactMean .. * ρ (diagGL t)).restrict fun _ _ ↦\n  compactMean_mem_levelSpace _, by aesop⟩, by aesop⟩\n\nend\n\nattribute [-simp] IsUnit.dvd\n\nopen Nat Circle NumberField Ideal Quotient RingOfIntegers Subgroup Kf algebraMap\nvariable {E} [Field E] [NumberField E] {n} [Fintype n] {a b : 𝓞 E} (h : a ≠ 0) {ι} [Fintype ι]\n  {w : ι → FinPlace E}\n\nattribute [local simp] Subtype.ext_iff map_eq_one mem_span_singleton dvd_def principalLevel\n\n/-- A continuous character χ : G → S¹ of a nonarchimedean topological group G is trivial on a\nneighbourhood of 1. -/\nlemma char_eventually_eq_one {G} [Group G] [TopologicalSpace G] [N : NonarchimedeanGroup G] (χ :\n  G →* Circle) (h : Continuous χ) : ∀ᶠ k in nhds 1, χ k = 1 := (N.2 _ (h.tendsto' _ _ χ.map_one\n  (hasBasis_centeredArc_div_two_pow.mem_of_mem (i := 0) ⟨⟩))).rec fun K a ↦ .mono K.mem_nhds_one\n  fun _ b ↦ eq_one_of_forall_pow_mem_centeredArc_pi_div_two (by grind [a <| pow_mem b ·])\n\nlemma card_GL_le R [CommRing R] [Finite R] : Nat.card (GL n R) ≤ .card R ^ Fintype.card n ^ 2 :=\n  (card_le_card_of_injective _ Units.val_injective).trans (by simp [Matrix, card_pi, sq, pow_mul])\n\nlemma dvd_iff_reduceAt_eq_zero (H : ∀ {v : FinPlace E}, a ∈ v.1 → v.intValuation a = .exp (-1)) y :\n    ↑a ∣ y ↔ ∀ w, a ∈ w.1 → _root_.reduceAt w y = 0 := by\n  simpa +contextual [H, ← WithZero.lt_mul_exp_iff_le,\n    ← WithZero.exp_add] using! @mem_span_iff_valuation_le _ _ _ a y.1\n\nlemma mem_prod_finPlace_iff (hw : w.Injective) {x} : x ∈ ∏ i, (w i).1 ↔ ∀ i, x ∈ (w i).1 := by\n  rw [prod_eq_iInf_of_pairwise_isCoprime] <;> simp_all [Set.Pairwise, (w _).isCoprime_of_ne, hw.ne]\n\ninclude h\n\nlemma dvd_iff_Ô : (a : Ô E) ∣ b ↔ a ∣ b := ⟨fun ⟨_, _⟩ ↦ ⟨⟨_, algebraMap_mem_Ô.1 (by simp_all\n  [← mul_assoc, ← map_mul _ _⁻¹])⟩, ext (mul_inv_cancel_left₀ (h <| ext ·) _).symm⟩, map_dvd _⟩\n\n/-- If an ideal I of Ô contracts to the ideal J of 𝓞_E and J contains a nonzero element a, then\n𝓞_E/J → Ô/I is bijective. -/\nlemma bijective_quot_Ô {I J} (k : Ideal.comap (algebraMap _ (Ô E)) I = J) (ha : a ∈ J) :\n    (⇑(quotientMap I _ k.ge)).Bijective := ⟨quotientMap_injective' k.le, Quot.ind\n  (exists_dvd_sub_algebraMap h · |>.rec (⟨·, SModEq.sub_mem.2 <| mem_of_dvd _ · (k.ge ha)⟩))⟩\n\n/-- An ideal I of Ô that contains a nonzero element a of 𝓞_E is generated by its contraction to\n𝓞_E. -/\nlemma map_under_Ô {I} (hI : algebraMap _ (Ô E) a ∈ I) : (under (𝓞 E) I).map (algebraMap ..) = I :=\n  map_comap_le.antisymm fun x ↦ by grind [exists_dvd_sub_algebraMap h x, dvd_def, sub_sub_self,\n    Submodule.sub_mem_iff_left, mul_mem_right, Ideal.mem_map_of_mem, mem_under]\n\nlemma card_Ohat_quot_span : .card (_ ⧸ span {(a : Ô E)}) = (span {a}).absNorm :=\n  (card_eq_of_bijective _ (bijective_quot_Ô h (ext (by simp_all [↓dvd_iff_Ô])) (by simp))).symm\n\n/-- For a nonzero integer a of the CM field E, the index of the principal level K(a) in K₀\n(`Subgroup.relIndex`, 0 if infinite) is at most N(a)^(n²), with N(a) the absolute norm of\n(a) and n the rank. -/\nlemma relIndex_principalLevel_le [IsCMField E] : (principalLevel n a).relIndex (Kf ..) ≤\n  absNorm (span {a}) ^ Fintype.card\n  n ^ 2 := have := finite_of_card_ne_zero ((card_Ohat_quot_span h).trans_ne (by simpa))\n  by grw [← card_Ohat_quot_span h, ← card_GL_le, ← (map n (mk _)).range.card_le_card_group,\n       ← index_ker]\n     exact index_antitone fun _ ↦ by simpa [↓eq_zero_iff_dvd] using! id\n"),("src/Lib/Adelic/Unitary/SpaceBasic.lean","import Lib.Adelic.Reduction.MinkowskiSecond\n\n/-! Supporting lemmas (textbook or folklore).\n\nPart of: Adelic points of unitary groups, levels and Haar measures (known result; see\nLib.Adelic.Reduction.MinkowskiSecond).\n\nThis file: Basic API for rational points, block embeddings and vectors of framed hermitian\nspaces. -/\n\nopen Matrix Topology\n\n\nvariable {E : Type*} [Field E] [NumberField E] [NumberField.IsCMField E] {n m : Type _} [Fintype n]\n  [Fintype m] {s : n → _} {t : m → _}\nattribute [local simp] blockGL U.sum Function.comp_def\n\n/-- Let J'' = diag(J,J') and g ∈ U(J''). For J' invertible, g = diag(a,1) with a ∈ U(J) iff its\nsecond block of columns is that of 1; for J invertible, symmetrically for diag(1,a) and the\nfirst block. -/\nlemma U.mem_range_sum {R} [CommRing R] [StarRing R] {J J' J''} (h : @fromBlocks n m n m R J 0 0 J' =\n  J'') {g} : (IsUnit J' → ((∃ a, sum h (a, 1) = g) ↔ g.1.1.toCols₂ = fromRows 0 1)) ∧ (IsUnit J →\n  ((∃ a, sum h (1, a) = g) ↔ g.1.1.toCols₁ = fromRows 1 0)) := by\n  obtain ⟨e, k, u, ⟨⟩⟩ := g.1.1.fromBlocks_toBlocks, mem_U.1 g.2, g.1.isUnit, h\n  rw [← e] at k u ⊢\n  simp [← fromCols_fromRows_eq_fromBlocks, fromRows_ext_iff]\n  constructor <;> rintro ⟨_, ⟨⟩⟩ <;> use (by aesop) <;> intro <;> simp_all [-e,\n    Matrix.mul_left_eq_iff_eq_invOf_mul] <;> use u.unit <;> aesop\n\n/-- The block diagonal map from the product of the adelic unitary groups of signs s and t to\nthat of the concatenated signs is a closed embedding. -/\n@[fun_prop] lemma G.isClosedEmbedding_sum : IsClosedEmbedding (sum : _ → G E (s ⊕ᵥ t)) := by\n  simp [← isClosedEmbedding_mat.of_comp_iff]\n  apply ((by tauto : (fromBlocks · 0 0 ·).uncurry.RightInverse fun M ↦ (M.onFun .inl, M.onFun .inr)\n    ).isClosedEmbedding ..).comp (isClosedEmbedding_mat.prodMap isClosedEmbedding_mat) <;> fun_prop\n\n@[fun_prop] lemma G.continuous_reindex e h : Continuous (reindex e h : G E s → G E t) := by\n  simp [continuous_iff]; fun_prop\n\n@[fun_prop] lemma G.continuous_neg : Continuous (neg : G E s → _) := continuous_iff.2 continuous_mat\n\nnamespace Space\n\nvariable {E : Type*} [Field E] [CMType E] (V : Space E n s) (W : Space E m t)\nattribute [local simp] fromBlocks_mulVec sum vecAtPoint mat_ratEmbed mul_assoc RingHom.map_mulVec\n  map_J\n\n@[ext] lemma ext {V V' : Space E n s} (h : V.x = V'.x) : V = V' := by\n  simp_all [mk.injEq _, ← (map_injective (@toAdele E ..).injective).eq_iff]\n\n@[local simp] lemma mem_Γ_iff_range {g} : g ∈ V.Γ ↔ ∀ i j, (V.x * g.mat * V.x⁻¹) i j ∈\n  toAdele.range := ⟨.rec (by aesop), fun h ↦\n  .imp (fun _ ↦ V.toRatCoords.symm_apply_eq.2 ∘ And.right)\n  (U.mem_range_map _ (RingHom.injective _) (by simp) rfl (mem_ratMatrices.2 h).choose_spec)⟩\n\n/-- Witt's theorem for a hermitian space V: if X, Y are left invertible n × m matrices over E\nwith XᴴJX = YᴴJY, J the matrix of V, then gX = Y for some g in U(J)(E). -/\nprotected lemma witt {X Y : Matrix n m E} : HasLeftInv X → HasLeftInv Y → Xᴴ * V.J * X = Yᴴ * V.J *\n  Y → ∃ g : U V.J, g.1.1 * X = Y := witt exists_isUnit_sub_star V.conjTranspose_J (by simp)\n\nlemma ratEmbed_mulVec_vecAtPoint γ y : (V.ratEmbed γ).mat *ᵥ V.vecAtPoint y =\n  V.vecAtPoint (γ *ᵥ y) := by simp\n\nlemma stdForm_vecAtPoint y z : star (V.vecAtPoint y) ⬝ᵥ stdForm E s *ᵥ V.vecAtPoint z =\n  star y ⬝ᵥ V.J *ᵥ z := by simp [star_mulVec_dotProduct]; simp [dotProduct]\n\nlemma vecAtPoint_injective : (⇑V.vecAtPoint).Injective :=\n  (MulAction.injective V.x⁻¹).comp (@toAdele E ..).injective.comp_left\n\nlemma sum_ratEmbed γ : (V.sum W).ratEmbed (U.sum rfl γ) = G.sum (V.ratEmbed γ.1, W.ratEmbed γ.2) :=\n  G.ext_mat (by erw [mat_ratEmbed]; simp)\n\nlemma sum_vecAtPoint y z : (V.sum W).vecAtPoint (y ⊕ᵥ z) =\n  V.vecAtPoint y ⊕ᵥ W.vecAtPoint z := by simp\n\nlemma sum_mem_Γ {g} : G.sum g ∈ (V.sum W).Γ ↔ g.1 ∈ V.Γ ∧ g.2 ∈ W.Γ := by simp\n\nlemma signedSpace_eq_reindex [StablyUnram E] {e h} (hV : V.x = (signedSpace E s).x) :\n  signedSpace _ t = V.reindex e h := h ▸ by ext : 2; simp_all [signedSpace, reindex]\n\nlemma mem_move_Γ a {g} : g ∈ (V.move a).Γ ↔ a * g * a⁻¹ ∈ V.Γ := by simp [move, G.mat]\n"),("src/Lib/Adelic/Unitary/SpaceDefs.lean","import Lib.General.Measure.SubgroupIntegral\nimport Lib.Adelic.Adeles.AdditiveCharDefs\nimport Lib.General.LinearAlgebra.ValuedMatrix\n\n/-! Part of: Adelic points of unitary groups, levels and Haar measures (known result; see\nLib.Adelic.Reduction.MinkowskiSecond).\n\nThis file: Adelic unitary groups, split places, compact levels, framed hermitian spaces, lattices,\nmasses. -/\n\nnoncomputable section\n\nopen NumberField MeasureTheory Measure Matrix GeneralLinearGroup WithZero Filter Valued\n\n\nsection\n\nvariable {E : Type*} [Field E] [NumberField E] {n : Type*} [Fintype n] (w : FinPlace E)\n\nlemma matrix_ext_evalAt {m n} {M N : Matrix m n (𝔸f E)} (h : ∀ u, M.map (evalAt u) =\n  N.map (evalAt u)) : M = N := by ext; simp_all [← ext_iff]\n\n/-- The ring homomorphism 𝔸 → ℂ taking an adele of E to its component at the infinite place v. -/\n@[simps!] def evalInf (v : InfinitePlace E) : 𝔸 E →+* ℂ := (Pi.evalRingHom _ v).comp (.fst ..)\n\nlemma matrix_ext_𝔸 {m n} {M N : Matrix m n (𝔸 E)} (h₁ : ∀ w, M.map (evalInf w) = N.map (evalInf w))\n  (h₂ : M.map (RingHom.snd ..) = N.map (RingHom.snd ..)) : M = N := by ext <;> simp_all [← ext_iff]\n\n/-- The homomorphism sending g in GL_n(E_w) to the element of GL_n(𝔸_f) with component g at w\nand 1 at the other places. -/\ndef locGL : GL n (LocField w) →* GL n (𝔸f E) := Units.map ⟨⟨fun g ↦ 1 + (g - 1).map (singleAdele\n  w), by simp⟩, by noncomm_ring [← Matrix.map_mul, ← Matrix.map_add, map_add, implies_true]⟩\n\n@[simp] lemma evalAt_locGL g : (locGL w g : GL n _).map (evalAt w) = g := by\n  ext : 2; simp [locGL, -evalAt_apply]; simp\n\n@[simp] lemma evalAt_locGL_of_ne {u w : FinPlace E} (h : u ≠ w) (g : GL n _) :\n  (locGL w g).map (evalAt u) = 1 := by ext; simp [locGL, -evalAt_apply]; aesop\n\nlemma GL_ext_evalAt {a b : GL n (𝔸f E)} (h : ∀ u, a.map (evalAt u) = b.map (evalAt u)) : a = b :=\n  Units.ext (matrix_ext_evalAt (congr($(h ·))))\n\nvariable {R : Type _} [CommRing R] [TopologicalSpace R] {O : Subring R}\n\nlemma isOpen_intGL (h : @IsOpen R _ O) : (intGL n O).IsOpen :=\n  Eq.subst (by ext; exact mem_intGL.symm) (O.matrix.isOpen_units h.matrix)\n\nvariable [IsTopologicalRing R]\n\nlemma isCompact_intGL [T2Space R] (h : @IsCompact R _ O) : IsCompact (SetLike.coe (intGL n O)) :=\n  Eq.subst (by ext; exact mem_intGL.symm) (O.matrix.units_isCompact h.matrix)\n\n/-- If the subring O and the O-submodule M are open in the topological ring R, the group of\nmatrices in GL_n(O) whose rows e(i), finitely many, are congruent to those of 1 modulo M is\nopen in GL_n(R). -/\nlemma isOpen_congruenceGL {m} {e : m → n} [Finite m] {M : Submodule O R} (h : @IsOpen R _ O) (k :\n  @IsOpen R _ M) : (congruenceGL M e).IsOpen := (isOpen_intGL h).and k.matrix.preimage_of_continuous\n\n/-- If the O-submodules M_i of R shrink to 0 along a filter, then the principal congruence\nsubgroups of level M_i eventually lie in any given neighbourhood of 1 in GL_n(R). -/\nlemma eventually_congruenceGL_subset {ι l s} {M : ι → Submodule O R} (h : @Tendsto _ (Set R) (M ·) l\n  (nhds 0).smallSets) (k : s ∈ nhds (1 : GL n R)) : ∀ᶠ i in l, ∀ g ∈ congruenceGL (M i) id, g ∈ s :=\n  have H : (l.bind fun i ↦ 𝓟 (congruenceGL (M i) id).carrier).Tendsto (·.1) (nhds 1) :=\n    tendsto_sub_nhds_zero_iff.1 (tendsto_pi_nhds.2 fun _ ↦ tendsto_pi_nhds.2 fun _ _ u ↦\n    l.3 (h (mem_lift' u)) fun _ a _ b ↦ a (b.2 ..))\n  (H.prodMk_nhds fun _ u ↦ l.3 (H (MulOpposite.continuous_op.tendsto _ u))\n    fun _ a ↦ (@a ·⁻¹ ∘ by simp)).le_comap ((nhds_induced ..).ge k)\n\nvariable (n)\n\n/-- For a finite place w of E, the subgroup GL_n(O_w) of GL_n(E_w) of matrices that, with their\ninverses, have entries in the local integers. -/\nabbrev Kw : Subgroup (GL n (LocField w)) := intGL n (LocInt w).1\n\n/-- The g in GL_n(E_w) with g and ϖg⁻¹ integral and det g of order j (ϖ a uniformiser); for j ≤\nn, the GL_n(O_w)-double coset of diag(ϖ1_j, 1). -/\ndef basicDoubleCoset (j : ℕ) := {g : GL n (LocField w) | (∀ a b, v (g a b) ≤ 1) ∧\n  (∀ a b, v (g⁻¹ a b) ≤ exp 1) ∧ v g.1.det = exp (-↑j)}\n\nvariable (E) [IsCMField E]\n\n/-- The finite adelic unitary group G_f: matrices g in GL_n(𝔸_f) with gᴴg = 1. -/\n@[instance_reducible] def Gf := ↥(U (1 : Matrix n n (𝔸f E)))\n  deriving Group, TopologicalSpace, MeasurableSpace, DistribMulAction _ (n → 𝔸f E), PolishSpace,\n  CoeOut _ (GL n (𝔸f E)), CoeOut _ (Matrix n n (𝔸f E)), SecondCountableTopology\n\ninstance : ContinuousSMul (Gf E n) (n → 𝔸f E) := ⟨.matrix_mulVec (by fun_prop) continuous_snd⟩\n\nvariable [IsEmpty n] in\nderiving instance Subsingleton for Gf E n\n\n@[simp] lemma Gf.coe_mul (g k : Gf E n) : (g * k).1 = g.1 * k.1 := rfl\n\n@[simp] lemma Gf.coe_mul' (g : Gf E n) (k : U 1) : (g * k).1 = g.1 * k.1 := rfl\n\n@[simp] lemma Gf.coe_inv (g : Gf E n) : g⁻¹.1 = g.1⁻¹ := rfl\n\n@[simp] lemma Gf.coe_one : (1 : Gf E n).1 = 1 := rfl\n\n@[simp] lemma Gf.subtype_apply g : DFunLike.coe (F := Gf E n →* _) (U 1).subtype g = g.1 := rfl\n\n@[simp] lemma Gf.codRestrict_apply {M} [Monoid M] (f : M →* _) h x :\n  DFunLike.coe (F := M →* Gf E n) (f.codRestrict (U 1) h) x = ⟨f x, h x⟩ := rfl\n\n@[ext] lemma Gf.val_ext {g k : Gf E n} : g.1 = k → g = k := by simp\n\n/-- The subgroup K_0 = G_f ∩ GL_n(Ô) of the finite adelic unitary group, the stabiliser of the\nstandard lattice Ô^n. -/\ndef Kf : Subgroup (Gf E n) := (intGL n (Ô E)).subgroupOf _\n\nvariable {n} (s : n → ℤˣ)\n\n/-- The archimedean unitary group G_∞ for signs s: one copy of the complex unitary group U(diag\ns) for each infinite place of E. -/\nabbrev GInf := InfinitePlace E → USign s\n\n/-- The adelic unitary group G = G_∞ × G_f for signs s at the infinite places and the identity\nmatrix at the finite places. -/\nabbrev G := GInf E s × Gf E n\n\n/-- A finite point as an adelic point. -/\ninstance : Coe (Gf E n) (G E s) := ⟨(1, ·)⟩\n\n/-- The diagonal adelic matrix that is diag(s) at every infinite place and the identity at the\nfinite places. -/\ndef stdForm := diagonal (α := 𝔸 E) fun i ↦ (fun _ ↦ s i, 1)\n\nvariable {E s} {u w : FinPlace E} (hw : w.IsSplit)\n\n/-- The function F on G = G_∞ × G_f has level K ⊂ G_f: F(g·(1, k)) = F(g) for all k ∈ K and g ∈\nG. -/\n@[simp] abbrev HasLevel {W S} [Membership _ S] (F : G E s → W) (K : S) :=\n  ∀ k ∈ K, ∀ g, F (g * (1, k)) = F g\n\n/-- The j-th Hecke operator on a representation π of GL_n(E_w): the action (`heckeFun`) of\nthe indicator function of `basicDoubleCoset` j, for K = GL_n(O_w). -/\ndef heckeGL {A W} [CommSemiring A] [AddCommMonoid W] [Module A W] (π : Representation A\n  (GL n (LocField w)) W) j := heckeFun π (Kw ..) ((basicDoubleCoset n w j).indicator 1)\n\nlemma evalAt_star_GL h (g : GL n _) : (map (evalAt w) (star g)).1 =\n  ((map (evalAt u) g).1.map (conjLoc h))ᵀ := by ext1; apply adeleMap_apply\n\n@[local simp] lemma evalAt_star_locGL (h : star u ≠ w) (g : GL n _) :\n    (star (locGL w g)).map (evalAt u) = 1 := by ext1; simp_all [evalAt_star_GL (star_star u)]\n\n/-- The homomorphism G_f → GL_n(E_w) sending an element to its component at w. -/\ndef Gf.atPlace (w : FinPlace E) : Gf E n →* GL n (LocField w) :=\n  .comp (map (evalAt w)) (U 1).subtype\n\n/-- For a split place w, the homomorphism GL_n(E_w) → G_f sending g to the unitary element with\ncomponent g at w and 1 off w, w̄. -/\ndef atSplit : GL n (LocField w) →* Gf E n := by\n  refine .mk' (fun g ↦ ⟨locGL w g * star (locGL w g⁻¹), Units.ext_iff.1 (?_ : star (_ : GL n _) *\n    1 * _ = 1)⟩) fun _ _ ↦ Subtype.ext ?_ <;> exact GL_ext_evalAt (by by_cases · = w <;> aesop)\n\n/-- For a split finite place w (w̄ ≠ w) and g in GL_n(E_w), the element of G_f attached to g by\n`atSplit` has component g at w. -/\n@[simp] lemma atPlace_atSplit (g : GL n _) : (atSplit hw g).atPlace w =\n  g := by simp_all [Gf.atPlace, atSplit]\n\nvariable (n) (S : Set (FinPlace E))\n\n/-- For a ring homomorphism f from the integral finite adeles to S, the homomorphism K_0 →\nGL_n(S) applying f to each entry. -/\ndef Kf.map {S} [CommRing S] (f : Ô E →+* S) : Kf E n →* GL n S :=\n  (intGL.map f).comp ((U 1).subtype.subgroupComap _)\n\n/-- The subgroup of G_f of elements supported on S ∪ S̄, that is, with component 1 at every\nplace outside S ∪ S̄. -/\ndef Gf.supportedOn := ⨅ w, ⨅ _ : w ∉ S ∧ star w ∉ S, (atPlace (n := n) w).ker\n\n/-- The subgroup of G_f of elements whose component at each place w in S lies in K w; by default\nK w is GL_n(O_w). -/\ndef localLevel (K := fun w : FinPlace E ↦ Kw n w) : Subgroup (Gf E n) := by\n  use! {g | ∀ w ∈ S, g.atPlace w ∈ K w} <;> simp_all [mul_mem]\n\n/-- The subgroup of G_f of elements with component 1 at every place in S (hence, being unitary,\nalso at the conjugate places). -/\ndef Gf.trivialOn := ⨅ w ∈ S, (atPlace (n := n) w).ker\n\nvariable {n S} (w) (g k : G E s) {K : Subgroup (Gf E n)}\n\n/-- Reduction modulo w: the homomorphism from K_0 = G_f ∩ GL_n(Ô) to GL_n of the residue field\nat w. -/\ndef Kf.reduceAt := map n (_root_.reduceAt w)\n\nlemma mem_localLevel {K g} : g ∈ localLevel n S K ↔ ∀ w ∈ S, g.atPlace w ∈ K w := .rfl\n\nlemma mem_Kf {g} : g ∈ Kf E n ↔ ∀ i j, g.1 i j ∈ Ô E :=\n  mem_intGL.trans (U.inv_val_eq_conjTranspose g ▸ by simp_all [star_mem_Ô])\n\nlemma isOpen_Kf : (Kf E n).IsOpen := (isOpen_intGL isOpen_Ô).preimage_val\n\n/-- Known result: Adelic points of unitary groups, levels and Haar measures. -/\nlemma isCompact_Kf : IsCompact (SetLike.coe (Kf E n)) :=\n  (isCompact_intGL isCompact_Ô).preimage_val (isClosed_U _)\n\n/-- The subgroup K of the finite adelic unitary group G_f is a level: it is open and contained\nin K_0 = G_f ∩ GL_n(Ô). -/\nclass IsLevel K where\n  le : K ≤ Kf E n\n  isOpen : K.IsOpen\n\ninstance : IsLevel (Kf E n) := ⟨le_rfl, isOpen_Kf⟩\n\n/-- For a subgroup K of G_f, the index [K₀ : K ∩ K₀], where K₀ = `Kf`; it is 0 if the index\nis infinite. -/\nabbrev stdLevelIndex K := Subgroup.relIndex K (Kf E n)\n\n/-- The element of GL_n(𝔸) with components a_w in GL_n(ℂ) at the infinite places and finite part\nb. -/\n@[simps! apply_val] def mkAdelicGL : (InfinitePlace E → GL n ℂ) × GL n (𝔸f E) →* GL n (𝔸 E) :=\n  .toHomUnits (by use! fun g ↦ of fun i j ↦ ((g.1 · i j), g.2 i j) <;>\n    simp_all [entrywise, ← prod_mk_sum, funext_iff, apply_ite])\n\n/-- The isomorphism from G = G_∞ × G_f to the unitary group over the adeles of the standard form\n`stdForm`. -/\ndef G.toUnitary : G E s ≃* U (stdForm E s) where\n  toFun g := ⟨mkAdelicGL (_, g.2), by apply matrix_ext_𝔸 <;> simp [stdForm,\n          ↓Matrix.map_mul, -mul_one, -Matrix.mul_one]; exacts [(g.1 · |>.2), g.2.2]⟩\n  invFun g := by refine (fun w ↦ U.map (evalInf w) ?_ ?_ g, U.map (.snd ..) ?_ ?_ g) <;>\n    simp [stdForm, signMatrix]\n  map_mul' _ _ := Subtype.ext (.symm (map_mul ..).symm)\n\n/-- The n×n matrix over the adeles of an element g of the adelic unitary group G. -/\n@[local simp] def G.mat := g.toUnitary.1.1\n\n@[simp] lemma G.mat_fst i j w : (g.mat i j).1 w = (g.1 w).1 i j := rfl\n\n@[simp] lemma G.mat_snd i j : (g.mat i j).2 = g.2.1 i j := rfl\n\n@[simp] lemma G.mat_one : mat (1 : G E s) = 1 := by simp\n\n@[simp] lemma G.mat_mul : (g * k).mat = g.mat * k.mat := by simp\n\n@[fun_prop] lemma G.continuous_mat : Continuous (mat : G E s → _) := by\n  simp +unfoldPartialApp [toUnitary, mkAdelicGL]; fun_prop\n\ninstance : PolishSpace (GL n (𝔸f E)) where\n\nderiving instance LocallyCompactSpace, BorelSpace, IsTopologicalGroup for Gf E n, G E s\n\nlemma IsLevel.isCompact [h : IsLevel K] : IsCompact K.carrier :=\n  isCompact_Kf.of_isClosed_subset (K.isClosed_of_isOpen h.2) h.1\n\ninstance [h : IsLevel K] : CompactSpace K := h.isCompact.compactSpace\n\n/-- The Haar measure that gives `Kf` mass one. -/\ninstance : MeasureSpace (Gf E n) :=\n  ⟨haarMeasure ⟨⟨_, isCompact_Kf⟩, by simp [isOpen_Kf.interior_eq]⟩⟩\n\ninstance : (@volume (Gf E n) _).IsHaarMeasure := isHaarMeasure_haarMeasure _\n\n/-- For the chosen Haar measure on the finite adelic unitary group G_f, the subgroup K_0 = G_f ∩\nGL_n(Ô) has volume 1. -/\n@[simp] lemma volume_Kf : volume (SetLike.coe (Kf E n)) = 1 := haarMeasure_self\n\nend\n\nattribute [local simp] evalAt_star_locGL\n\nattribute [local simp] G.mat\n\nvariable (E : Type*) [Field E] [CMType E] {n : Type*} [Fintype n] {s : n → ℤˣ}\n\n/-- A hermitian space with a point: a matrix J over E and x in GL_n(𝔸) with xᴴJx equal to\ndiag(s) at the infinite places and 1 at the finite places. -/\nstructure Space n [Fintype n] s where\n  J : Matrix n n E\n  x : GL n (𝔸 E)\n  gram_point : x.1ᴴ * J.map toAdele * x.1 = stdForm E s\n\nnamespace Space\n\nvariable {E} (V : Space E n s)\n\n/-- For a space (J, x), the isomorphism g ↦ x g x⁻¹ from G to the adelic unitary group U(J)(𝔸). -/\ndef toRatCoords := G.toUnitary.trans (U.conj _ V.gram_point)\n\n/-- For a space (J, x), the homomorphism γ ↦ x⁻¹ γ x from the rational unitary group U(J)(E) to\nG. -/\ndef ratEmbed := V.toRatCoords.symm.toMonoidHom.comp (U.map _ (by simp) rfl)\n\n/-- For a space (J, x), the homomorphism U(J)(E) → G_f sending γ to the finite part of x^{-1} γ\nx. -/\ndef embFin := (MonoidHom.snd ..).comp V.ratEmbed\n\n/-- For a space (J, x), the subgroup x^{-1} U(J)(E) x of G, the image of the rational unitary\ngroup. -/\ndef Γ := V.ratEmbed.range\n\n/-- For a space (J, x), the subgroup of G_f formed by the finite parts of the elements x^{-1} γ\nx, γ in U(J)(E). -/\nabbrev Γf := V.embFin.range\n\n/-- For a space (J, x), the adelic vector x⁻¹y attached to a rational vector y in E^n. -/\ndef vecAtPoint :=\n  V.x⁻¹.1.mulVecLin ∘ₛₗ .mk (σ := toAdele) ⟨(toAdele ∘ ·), by simp⟩ (by simp [funext_iff])\n\n/-- For a space V = (J, x), the lattice E^n ∩ x_f Ô^n of rational vectors y with x⁻¹y integral\nat all finite places, as an additive subgroup. -/\ndef baseLattice :\n  AddSubgroup (n → E) := by use! {y | ∀ i, (V.vecAtPoint y i).2 ∈ Ô E} <;> simp_all [add_mem]\n\nend Space\n\nvariable (n)\n\n/-- The definite space I_n with J = 1 and x = 1: the sum of n norms with its standard lattice. -/\n@[simps] def stdSpace : Space E n 1 := ⟨1, 1, by simp [stdForm]; rfl⟩\n\n/-- The mass of the genus of O_E^l: the sum of 1/#Aut over the classes Γ\\G_f/K_0 for the space\nI_l. -/\ndef mass l := (classSum (stdSpace E (Fin l)).Γf (Kf ..) 1 : ℝ)\n\nvariable {E n}\n\n/-- The homomorphism U_n(E) → G_f sending a matrix γ over E with γᴴγ = 1 to its image over the\nfinite adeles. -/\nabbrev stdEmbFin := (stdSpace E n).embFin\n\n/-- The image of U_n(E), the matrices γ over E with γᴴγ = 1, in the finite adelic unitary group\nG_f. -/\nabbrev stdRatPoints := (stdSpace E n).Γf\n"),("src/Lib/Adelic/Unitary/SpaceGram.lean","import Lib.Weil.GaussSum.LocalHomUnit\nimport Lib.Adelic.Unitary.SpaceDefs\n\n/-! Part of: Adelic points of unitary groups, levels and Haar measures (known result; see\nLib.Adelic.Reduction.MinkowskiSecond).\n\nThis file: Gram matrix of an adelically framed hermitian space is invertible and hermitian. -/\n\nopen Matrix\n\nsection\n\nvariable {E : Type*} [Field E] [NumberField E] {n : Type _} [Fintype n] {s : n → ℤˣ}\n\n@[simp] lemma stdForm_mul_self : stdForm E s * stdForm E s = 1 := by\n    simp [stdForm, funext_iff, ← Int.cast_mul]\n\nomit [Fintype n] in\n@[simp] lemma stdForm_one : stdForm (n := n) E 1 = 1 := congr(diagonal $(by aesop))\n\n@[simp] lemma isUnit_stdForm : IsUnit (stdForm E s) := .of_mul_eq_one _ stdForm_mul_self\n\nend\n\nvariable {E : Type*} [Field E] [CMType E] {n : Type _} [Fintype n] {s : n → ℤˣ} (V : Space E n s)\n\nomit [Fintype n] in\n@[simp] lemma stdForm_conjTranspose : (stdForm E s)ᴴ = stdForm E s := by aesop (add simp stdForm)\n\n@[simp] lemma conjTranspose_map_toAdele {m k} (a : Matrix m k E) : (a.map toAdele)ᴴ =\n  aᴴ.map toAdele := by aesop\n\nlemma Space.map_J : V.J.map toAdele = V.x⁻¹.1ᴴ * stdForm E s * V.x⁻¹ :=\n  (gram_inv_of_gram_eq V.gram_point).symm\n\n/-- The matrix J over E of a space (J, x) is invertible. -/\n@[simp] lemma Space.isUnit_J : IsUnit V.J := isUnit_of_mapMatrix toAdele (by simp [map_J])\n\nlemma Space.map_J_inv_mul_map_J : V.J⁻¹.map toAdele * V.J.map toAdele = 1 :=\n  GeneralLinearGroup.coe_map_inv_mul_map _ V.isUnit_J.unit\n\nlemma Space.map_J_inv : V.J⁻¹.map toAdele = V.x * stdForm E s * V.x.1ᴴ := left_inv_eq_right_inv\n    V.map_J_inv_mul_map_J (by simp [← mul_assoc, mul_eq_one_comm, gram_point])\n\n/-- The matrix J over E of a space (J, x) is hermitian: Jᴴ = J. -/\nlemma Space.isHermitian_J : V.J.IsHermitian := map_injective toAdele.injective (by\n  simp [← conjTranspose_map_toAdele, map_J, mul_assoc])\n\nlemma Space.conjTranspose_J : V.Jᴴ = V.J := V.isHermitian_J\n"),("src/Lib/Adelic/Witt/FrameAction.lean","import Lib.General.LinearAlgebra.ColumnLattices\n\n/-! General lemmas of linear algebra and matrices (textbook or folklore).\n\nPart of: Witt's extension theorem for hermitian forms; unimodular lattices; Iwasawa decomposition\n(known result; see Lib.SiegelWeil.SingularForms.AdaptedHom).\n\nThis file: Left invertible and primitive matrices, hermitian symmetry, quasi-reflections. Hermite\nnormal form over valuation-like pairs of rings; primitive bases of flags. Witt's extension theorem\nfor hermitian forms over a field, by quasi-reflections. Action of the unipotent subgroups on the\nframe; transformation of the Gram matrix. -/\n\nsection\n\nopen IsLocalRing Matrix Finset ValuationRing MatMul\n\nsection\n\nvariable {R n k} [CommRing R] [Fintype n] (O : Subring R) (X : Matrix n k R) [StarRing R]\n  {J : Matrix n n R} (hJ : Jᴴ = J)\n\n/-- The n × k matrix X over R has a left inverse over R. -/\nabbrev HasLeftInv := ∃ L : Matrix k n R, L * X = 1\n\n/-- The submodule of R^n spanned by the columns of the matrix X. -/\nabbrev colSpan [Fintype k] := X.mulVecLin.range\n\n/-- The matrix X has entries in the subring O and a left inverse with entries in O. -/\ndef IsPrimitiveMatrix := IsIntMatrix O X ∧ ∃ L : Matrix k n R, IsIntMatrix O L ∧ L * X = 1\n\nnoncomputable instance [IsLocalRing R] : StarRing (ResidueField R) := by refine' { star :=\n  (.mapEquiv starRingAut), .. } <;> simp [Function.Involutive, residue_surjective.forall, mul_comm]\n\nlemma star_form (hJ : Jᴴ = J) u v : star (star u ⬝ᵥ J *ᵥ v) = star v ⬝ᵥ J *ᵥ u := by\n  grind [star_dotProduct, star_mulVec_dotProduct]\n\n/-- The quasi-reflection x ↦ x − v σ⁻¹ h(v, x) in U(J), where h(v, x) = vᴴJx, J is hermitian,\nand σ is a unit with σ + σ̄ = h(v, v). -/\nnoncomputable def quasiReflection (hJ' : IsUnit J) v (σ : Rˣ) (h : σ + star ↑σ =\n  star v ⬝ᵥ J *ᵥ v) := U.of hJ' (1 - σ⁻¹.1 • vecMulVec v (star v ᵥ* J)) (by\n  simp [sub_mul, mul_sub, vecMulVec_mul, mul_vecMulVec, star_vecMul, vecMulVec_mulVec, ← ext_iff]\n  grind [Units.mul_inv, star_mul, star_one, dotProduct_mulVec])\n\nvariable {A} {n k : _} [CommRing A] {R : _} [Fintype n] [Fintype k] (val :\n  @IsValuationPair A _ R) (M : Matrix k n A) (ι : k ↪ n)\n\nlemma transvectionGL_mem_intGL {i j a} (h : i ≠ j) : a ∈ R → transvectionGL h a ∈ intGL n R := by\n  aesop (add simp [mem_intGL, single, transvection, transvectionGL])\n\nlemma isValuationPair_top [IsDomain A] [ValuationRing A] : @IsValuationPair A _ ⊤ := by\n  simp [IsValuationPair, mul_left_eq_self₀, ← dvd_def, dvd_total]\n\ninclude val\n\n/-- Hermite form: if (A, R) satisfies `IsValuationPair` and ι embeds k in n, an n × k matrix y over\nA is U_ι D with U ∈ GL_n(R), U_ι its columns at ι, and D = (rows ι of U⁻¹)·y block upper\ntriangular for wt. -/\nlemma IsValuationPair.hermite y (wt : k → ℕ := 0) : ∃ᵉ (U ∈ intGL n R) (D : Matrix k k A),\n    D.BlockTriangular wt ∧ y = U.1.submatrix id ι * D ∧ U⁻¹.1.submatrix ι id * y = D :=\n  let P s U := U ∈ intGL .. ∧ ∀ j ∈ s, ∀ i ∉ (filter (wt · ≤ wt j) s).map ι, (U.1 * y) i j = 0\n  have ⟨U, u, e⟩ : Exists (P univ) := univ.induction_on_max_value wt (by aesop) fun a s _ _ h ↦\n    (((insert a s).map ι)ᶜ.induction_on' (motive := (∃ U, P s U ∧ ∀ i ∈ ·, (U.1 * y) i a = 0))\n    (by simpa) fun i _ _ _ _ ⟨U, ⟨u, h⟩, _⟩ ↦ by\n  obtain ⟨_, _, ⟨_, x, _⟩, _, _, z, _⟩ := by simpa using val ((-U.1 * y) (ι a) a) ((-U.1 * y) i a)\n  exists _, ⟨mul_mem (transvectionGL_mem_intGL (.symm ?x) z) (mul_mem (transvectionGL_mem_intGL\n    (?x : ι a ≠ i) (add_mem R.one_mem x)) u), ?_⟩ <;> simp at h ⊢ <;> grind +splitImp\n    [mem_compl, transvection_mul_apply_same, transvection_mul_apply_of_ne]).imp (by aesop)\n  ⟨_, inv_mem u, _, fun _ _ _ ↦ by apply e <;> simp [*], .symm (.trans (ext fun _ _ ↦ by\n    apply sum_of_injOn _ ι.2.injOn <;> aesop) (U.1.invOf_mul_cancel_left y)), rfl⟩\n\n/-- If (A, R) satisfies `IsValuationPair` and the n × k matrix X over A has a left inverse, there is\nan invertible b, block upper triangular for wt, such that X b has entries in R and a left\ninverse with entries in R. -/\nlemma IsValuationPair.exists_isPrimitiveMatrix_mul {X : Matrix n k A} (h : HasLeftInv X) (wt :\n  k → ℕ := 0) : ∃ b : GL k A, b.1.BlockTriangular wt ∧ IsPrimitiveMatrix R (X * b.1) := by\n  obtain ⟨⟨L, _⟩, U, _, D, _, e, f⟩ := h, val.hermite .inr (X.fromRows 0) wt\n  cases (congr(toRows₁ $e) : X = U.1.toBlocks₁₂ * D)\n  obtain ⟨b, ⟨⟩⟩ := IsUnit.of_mul_eq_one_right _ (by rwa [L.mul_assoc])\n  refine ⟨b⁻¹, ?_, ?_, _, ?_, by simpa [← ext_iff, mul_apply] using congr($f * b⁻¹)⟩\n    <;> simp_all [IsIntMatrix, mem_intGL, toBlocks₁₂, blockTriangular_inv_of_blockTriangular]\n\n/-- Hermite form: if the subring R of A satisfies `IsValuationPair`, then for a k×n matrix M over A\nand an injection ι: k → n, some V in GL_n(R) makes the columns of MV outside the image of ι\nvanish. -/\nlemma IsValuationPair.exists_mul_clear_cols : ∃ V ∈ intGL n R, ∀ᵉ (a) (j ∉ Set.range ι),\n  (M * V.1) a j = 0 := have ⟨k, _, D, _, h, _⟩ := val.hermite ι Mᵀ\n  have := h ▸ (k.2.mul_assoc ..).symm.trans congr(submatrix $k.inv_mul _ ι * D)\n  ⟨transposeGL k⁻¹, by simp_all [← ext_iff, mul_apply, ne_comm, mul_comm, mem_intGL, transposeGL]⟩\n\nend\n\nvariable {R n k} [Field R] [Fintype n] [Fintype k] {X Y : Matrix n k R}\n\nlemma HasLeftInv.mulVec_injective : HasLeftInv X →\n  X.mulVec.Injective | ⟨l, _⟩ => .of_comp (f := l.mulVec) (by aesop_cat)\n\nlemma HasLeftInv.of_ker_le_bot : X.mulVecLin.ker ≤ ⊥ → HasLeftInv X := by\n  simpa using exists_mul_add_mul_eq (y := diagonal 0) (x := X)\n\nlemma HasLeftInv.of_ne_zero {x : n → R} (h : x ≠ 0) : HasLeftInv (replicateCol Unit x) :=\n  .of_ker_le_bot (by simp_all [LE.le, mulVec, funext_iff]; grind)\n\nlemma Filling.exists_basis_matrix (L : Submodule R _) : ∃ x : Matrix n (Fin (Module.finrank R L)) R,\n  HasLeftInv x ∧ colSpan x = L := ⟨(L.subtype ∘ₗ (LinearEquiv.ofFinrankEq _ _\n  (by simp)).1).toMatrix', by simp [← toLin'_apply', LE.le, colSpan, HasLeftInv.of_ker_le_bot]⟩\n\nvariable [StarRing R] (hz : ∃ z : R, IsUnit (z - star z)) {J : Matrix n n R} (hJ : Jᴴ = J)\n  (hJ' : IsUnit J) (hX : HasLeftInv X) (hY : HasLeftInv Y) (h : Xᴴ * J * X = Yᴴ * J * Y)\n\nlemma HasLeftInv.of_isUnit_gram : IsUnit (Xᴴ * J * X) → HasLeftInv X :=\n  (⟨_, (Matrix.mul_assoc ..).trans ·.unit.4⟩)\n\ninclude hz hJ hJ' hX hY h\n\n/-- Witt's theorem by quasi-reflections: over a field with involution having some z ≠ z̄, for\ninvertible hermitian J and a subgroup H of U(J) containing all quasi-reflections, left\ninvertible X, Y with XᴴJX = YᴴJY satisfy gX = Y for some g in H. -/\nlemma witt_of_quasiReflection_mem (H : Subgroup _) (hH : ∀ v σ h,\n  quasiReflection hJ hJ' v σ h ∈ H) : ∃ g ∈ H,\n  g.1.1 * X = Y := have t : ∀ i j, star _ ᵥ* J ⬝ᵥ Xᵀ j = star _ ᵥ* J ⬝ᵥ Yᵀ j := congrFun₂ h\n  (univ.induction ⟨1, by simp⟩ fun j s _ ⟨g, hg, e⟩ ↦ by\n  wlog σ : star (Yᵀ j) ⬝ᵥ J *ᵥ (Yᵀ j - g *ᵥ Xᵀ j) ≠ 0 generalizing g\n  any_goals refine ⟨_, mul_mem (hH (g *ᵥ Xᵀ j - Yᵀ j) (.mk0 _ σ) ?_) hg, ?_⟩\n  have d {X} : HasLeftInv X → ∃ a : n → R, ∀ i, a ⬝ᵥ Xᵀ i = ite (j = i) 1 0 :=\n    (⟨_, congrFun₂ ·.choose_spec j⟩)\n  obtain ⟨⟨z, ζ⟩, ⟨a, p⟩, b, q⟩ := hz, (vecMul_surjective_of_invertible g).exists.1 (d hX), d hY\n  refine ((vecMul_surjective_iff_isUnit.2 hJ').exists.1 (by simp [add_vecMul]; grind : ∃ u ∈\n    [a, b, a + b], u ⬝ᵥ Yᵀ j * u ᵥ* g ⬝ᵥ Xᵀ j ≠ 0)).rec fun u _ ↦ this _ (mul_mem\n    (hH (star u) (.mk0 (z * (u ⬝ᵥ J *ᵥ star u - star z) / ζ.unit) ?_) ?_) hg) ?_ ?_\n  all_goals revert σ t; simp +contextual [← mulVec_mulVec, *, quasiReflection,\n    U.form_mulVec_mulVec, vecMulVec_mulVec, ← dotProduct_mulVec, ↓op_smul_eq_smul, mulVec_sub] <;>\n    grind [add_dotProduct, star_star, IsUnit.ne_zero, star_form, star_eq_zero, dotProduct_mulVec] :\n    ∃ g ∈ H, ∀ i ∈ univ, g *ᵥ Xᵀ i = Yᵀ i).imp fun _ ↦ .imp_right (by simpa using! ext_col)\n\n/-- Witt's theorem: over a field with involution having some z − z̄ ≠ 0, for invertible\nhermitian J, left invertible X, Y with XᴴJX = YᴴJY satisfy g X = Y for some g in U(J).\n\nKnown result: Witt's extension theorem for hermitian forms; unimodular lattices; Iwasawa\ndecomposition. -/\nlemma witt : ∃ g : U J, g.1.1 * X =\n  Y := by simpa using witt_of_quasiReflection_mem hz hJ hJ' hX hY h ⊤\n\nend\n\nopen Matrix Fin Sum Function FI\nvariable {A} [CommRing A] {𝔰 : Shape} {T : 𝔰.Form A} [StarRing A] {x x' γ : T.G} {m n}\n  (hx' : x' ∈ besselU)\n\nattribute [local simp] forall_fin_succ' level frameMatrix mem_besselU Matrix.mul_apply frameGram\n\n@[simp] lemma besselFrame_castSucc a : 𝔰.besselFrame a.castSucc = inl a := by simp [besselFrame]\n\n@[simp] lemma besselFrame_last : 𝔰.besselFrame 𝔰.top = 𝔰.z := snoc_last ..\n\nlemma level_besselFrame : ∀ a, level (𝔰.besselFrame a) = a := by simp\n\nlemma besselFrame_injective : 𝔰.besselFrame.Injective := by simp [Injective]\n\nlemma frameMatrix_unitriangular : x ∈ besselU → ∀ a, ∀ b ≤ a, frameMatrix x a b =\n  (1 : Matrix ..) a b := by simp; grind\n\nlemma mem_besselU0_iff : x ∈ besselU0 ↔ x ∈ besselU ∧\n  frameMatrix x = 1 := by simp [besselU0, ← ext_iff]; grind\n\ninclude hx'\n\n/-- For x' in 𝖴, the entries in rows outside the first block and columns outside the last block\nare those of the identity: x' keeps the span X of the e_a and is trivial on X^⊥/X. -/\nlemma apply_inr_of_mem_besselU i j : (∀ a, j ≠ eStar a) → x'.1 (inr i) j = ite (inr i = j) 1 0 := by\n  simp_all; grind\n\n/-- An element of the unipotent group 𝖴 that fixes ϱ vectors whose coordinates at e*₁, …, e*_ϱ\nform the identity matrix is 1. -/\nlemma eq_one_of_mem_besselU