= weylNormSq v ∧ ∀ u, u ⬝ᵥ A.map (↑) *ᵥ v = gramForm v' u := by\n  choose p q using (exists_equiv_decrPosition <| h · |>.1)\n  obtain ⟨N, Q⟩ := h.exists_decrPosition_eq, by simpa using h'.eq_hcParameter\n  obtain ⟨J, K, -, b, hJ, H⟩ := exists_dual_isometry (κ := κ') (κ' := κ) p _ rfl fun w j _ ↦ by\n    grind [hcParameter, @N w j (by grind), @N w (j - 1) (by grind)]\n  refine have L R [Field R] [CharZero R] g := ?_; have s v u := ?_; ⟨weylGram n κ' * J, L,\n    fun _ _ _ _ ↦ .trans (by rw [algFormCoeff_apply, ← star_highestVector]; simp [*, highestVector])\n        ((L ..).symm.trans congr($((conjWeylRep ..).self_inv_apply ..) ⬝ᵥ _)),\n        ⟨_, fun v ↦ by simpa [↓← map_intCast_mul_mulVec, b, ↓Jᵀ.mul_smul,\n        weylGram_isSymm.eq, ← Matrix.mul_assoc, ← diagonal_intCast] using\n        (congr((Jᵀ * $(weylGram_mul_fockPairing (n := n) (κ := κ')) * Kᵀ)ᵀ.map (↑) *ᵥ v))⟩,\n    fun v ↦ ⟨star (J.map (↑) *ᵥ v), congrArg _ ((s ..).symm.trans ?_), s v⟩⟩\n  simp [-smul_mulVec, ↓map_intCast_mul_mulVec, weylRep, weylGram_mul_schur, dotProduct_mulVec,\n    vecMul_mulVec, ← transpose_mul, ← by simpa [weylRep, ← inv_smul_eq_iff, mul_smul,\n    _root_.zpow_add] using (((H R).2 g).trans congr(_ * weylRep κ $(funext fun τ ↦ show _ =\n    e' τ + e τ by grind [Ico_self, hcParameter, diagramWeight_apply,\n    N τ (Nat.sub_one_lt card_ne_zero), _=_ Ico_add_one_left_eq_Ioo]) g)), ← Matrix.mul_assoc]\n  rw [map_intCast_mul_mulVec, gramForm_apply, star_star, ← dotProduct_transpose_mulVec,\n    weylGram_isSymm.map]\n  simp [← hJ, ↓map_intCast_mul_mulVec, star_mulVec_dotProduct, conjTranspose, transpose_map,\n    Function.comp_def]\n"),("src/Lib/GLn/Dual/MixedCartan.lean","import Lib.Adelic.CuspForms.DeltaForms\nimport Lib.GLn.Branching.Branching\n\n/-! Part of: Dual of a Weyl module by Jacobi's complementary minors; Cartan component (known result;\nsee Lib.GLn.Branching.Branching).\n\nThis file: Integral isometric Cartan component of a Weyl module tensor a dual Weyl module. -/\n\n\nopen Finset Matrix Kronecker Fintype PolyRep MatMul\nvariable {Φ} (n) [Fintype Φ] [Fintype n] (kp km l : Φ → ℕ → ℕ)\n\n/-- The column multiplicity function sending (τ,i) to kp_τ(i) + km_τ(|n|−i), with truncated\nsubtraction of natural numbers. -/\nabbrev mixedWeight τ i := kp τ i + km τ (card n - i)\n\n/-- An integral isometry Δ_l → Δ_kp ⊗ Δ_km of Weyl lattices with integral left inverse, sending\nev₁ to ev₁ ⊗ ev_{w₀} (w₀ the reversal) and intertwining ∏_τ det(g_τ)^{−∑_{0<i<|n|}\nkm_τ(i)}·S_l(g) with S_kp(g) ⊗ S_km(g⁻ᵀ) in characteristic 0. -/\nstructure PolyRep.MixedCartanEmbedding where\n  matrix : Matrix (WeylIndex n kp × WeylIndex n km) (WeylIndex n l) ℤ\n  hasLeftInv : HasLeftInv matrix\n  gram_eq : matrixᵀ * weylGram n kp ⊗ₖ weylGram n km * matrix = weylGram _ _\n  top R [Field R] [CharZero R] : let v {κ} p := weylEval (R := R) _ κ (permArray fun _ a ↦\n      p (equivFin n a))\n    matrix.map (↑) *ᵥ v Fin.val = (vecMulVec (v (·.rev)) (v Fin.val)).vec\n  intertwines {R} [Field R] [CharZero R] (g : Φ → GL n R) v :\n    matrix.map (↑) *ᵥ weylRep l (-∑ i ∈ Ico 1 (card n),\n    km · i) g *ᵥ v = schur kp (g ·) ⊗ₖ schur _ (fun τ ↦ (g τ)⁻¹.1ᵀ) *ᵥ matrix.map (↑) *ᵥ v\n\n/-- Duality for Weyl lattices: for all column counts kp and km, a map `PolyRep.MixedCartanEmbedding`\nexists from the lattice with column counts kp_τ(i) + km_τ(|n| − i) to Δ_kp ⊗ Δ_km, that is, an\nequivariant integral isometry with integral left inverse sending ev₁ to ev₁ ⊗ ev_{w₀}. -/\nlemma nonempty_mixedCartanEmbedding :\n  Nonempty (MixedCartanEmbedding n kp km (mixedWeight n kp km)) := by\n  obtain ⟨J, J', _⟩ := exists_dual_isometry (κ := km) (rowPos n) _ rfl (by tauto)\n  let K R [CommRing R] := mulLinearMap R (kronecker (diagonal 1) (J.map (↑))) (comulMatrix R _ kp _)\n  have _ R [CommRing R] : (K ℤ).map (↑) = K R := by aesop (add simp mul_apply)\n  refine ⟨.mk (l := _ + _) (K ℤ) (hasLeftInv_comulMatrix.imp' (mulLinearMap ℤ · (1 ⊗ₖ J')) ?_)\n    (.trans ?_ (comulMatrix_isometry_and_equivariant 1).1) ?_ ?_⟩ <;> simp_all [K, weylRep,\n    ← (_ ⊗ₖ _).mul_assoc, ← mul_kronecker_mul, ← comulMatrix_isometry_and_equivariant,\n  ← kroneckerMap_transpose, kronecker_smul, funext @Int.cast_id, cm_mulVec_weylEval,\n    ← mulVec_mulVec (weylEval _ _ _)]\n\n/-- A chosen element of `PolyRep.MixedCartanEmbedding` for l = `mixedWeight` n kp km: an integral\nmap Δ_l → Δ_kp ⊗ Δ_km together with its laws. -/\nnoncomputable def mixedCartan := (nonempty_mixedCartanEmbedding n kp km).some\n"),("src/Lib/GLn/SchurModule/Bordering.lean","import Lib.GLn.SchurModule.Nabla\n\n/-! Part of: Standard basis theorem for Schur (dual Weyl) modules over any ring, with character\n(known result; see Lib.GLn.SchurModule.MinorBasis).\n\nPart of: Weyl character and dimension formulas for U(n) and products of unitary groups (known\nresult; see Lib.DiscreteSeries.Character.KTypeMultiplicity).\n\nThis file: Leading terms in one row, bordering of minors, recursion for alternants. -/\n\nnoncomputable section\n\nopen MvPolynomial Finset MonomialOrder Finsupp Matrix Fin\n\nnamespace PolyRep\n\nvariable {Φ J m R ι : Type} [CommRing R] {F δ G : ι → _} {t : Finset ι} {γ} {a : R}\n\n/-- The lexicographic monomial order on variables indexed by ℕ that compares exponents at the\nhighest index first, so that x₀ ≺ x₁ ≺ …. -/\ndef columnOrder : MonomialOrder ℕ := @lex ℕᵒᵈ _ _\n\nlemma columnOrder_lt_of_eq_above i δ : (∀ j > i, γ j = δ j) → γ i < δ i → γ ≺[columnOrder] δ :=\n  (⟨_, ·, ·⟩)\n\n/-- No monomial of F exceeds x^γ in the order `PolyRep.columnOrder`, and the coefficient of x^γ in F\nis G (G = 0 is allowed). -/\nabbrev HasLeadingTerm F γ (G : R) := columnOrder.degree F ≼[columnOrder] γ ∧ F.coeff γ = G\n\nlemma HasLeadingTerm.mul {F F' γ' a'} : HasLeadingTerm F γ a → HasLeadingTerm F' γ' a' →\n  HasLeadingTerm (F * F') (γ + γ') (a * a') := by\n    grind [degree_mul_le, coeff_mul_of_add_of_degree_le]\n\nlemma HasLeadingTerm.of_monomial : HasLeadingTerm (monomial γ a) γ a :=\n  ⟨degree_monomial_le _, by simp⟩\n\nlemma HasLeadingTerm.prod (h : ∀ i, HasLeadingTerm (F i) (δ i) (G i : R)) :\n  HasLeadingTerm (t.prod F) (t.sum δ) (t.prod G) := t.induction (by bound) (by grind [mul])\n\nlemma HasLeadingTerm.sum (h : ∀ i, HasLeadingTerm (F i) (δ i) (G i : R)) j (H : ∀ i ∈ t, i ≠ j →\n  δ i ≺[columnOrder] δ j) (hj : j ∉ t → G j = 0 := by simp) :\n  HasLeadingTerm (t.sum F) (δ j) (G j) := by grw [HasLeadingTerm, degree_sum_le,\n  coeff_sum, sum_eq_ite j, t.sup_le_iff] <;> grind [coeff_eq_zero_of_lt]\n\nvariable [Fintype J] (c : m → Φ) (τ h : J → _) (x : m) (l : ℕ →₀ ℕ)\n\n/-- For a row x, the R-algebra isomorphism writing a polynomial in the y_{a,i} as a polynomial\nin the y_{x,i}, i ∈ ℕ, over the polynomials in the other rows. -/\ndef rowExpansion : MatrixPoly m R ≃ₐ[R] MvPolynomial ℕ (MatrixPoly {a // a ≠ x} R) := (renameEquiv R\n  (((Equiv.optionSubtypeNe x).symm.prodCongr 1).trans optionProdEquiv)).trans (sumAlgEquiv ..)\n\n/-- For a finitely supported l : ℕ → ℕ, the finite set of finitely supported γ with γ(i) ≤ l(i)\n− l(i+1) for all i, the subtraction truncated at 0. -/\ndef interlacing := Icc 0 (l - l.comapDomain .succ (by simp))\n\n/-- For finitely many columns j with colour τ_j and height h_j, the weight whose value at (τ,i)\ncounts the columns of colour τ with height exceeding i. -/\ndef columnWeight := ∑ j, ∑ i ∈ range (h j), single ((τ j : Φ), i) 1\n\n/-- The type of assignments giving each column j an h_j-tuple of rows, all of colour τ_j. -/\nabbrev ColouredTableau := ∀ j, Fin (h j) → {a // c a = τ j}\n\nvariable {c τ h x} (S) [CommRing S] (I : ColouredTableau c τ h)\n\n/-- For a coloured column filling I, the polynomial over S that is the product over columns j of\nthe minor with rows I_j on the first h_j columns. -/\ndef minorProduct := ∏ j, minor S (I j · |>.1)\n\nattribute [local simp] columnWeight minor Finsupp.le_def sum_range_succ det_apply'\n  prod_pow_eq_pow_sum\n\n/-- The weight `diagramWeight` of N and κ equals the weight `PolyRep.columnWeight` of the family\nhaving κ_τ(h) columns of colour τ and height h, for every τ and h < N_τ. -/\nlemma diagramWeight_eq_columnWeight [Fintype Φ] N κ : diagramWeight N κ =\n  @columnWeight Φ (Σ τ, Σ h : Fin (N τ), Fin (κ τ h)) _ (·.1)\n  (·.2.1) := by simp [↓Fintype.sum_sigma, diagramWeight, sum_range]\n\n/-- For an assignment I of h_j rows of colour τ_j to each column j, the product of minors\n`PolyRep.minorProduct` of I is a Borel semi-invariant: it lies in `nabla` for the weight\n`PolyRep.columnWeight` of τ, h. -/\nlemma minorProduct_mem_nabla : minorProduct R I ∈ nabla R c (columnWeight τ h) :=\n  SetLike.prod_mem_graded _ _ _ fun _ _ ↦ minor_mem_nabla (by grind)\n\n/-- Bordering: if γ interlaces the columns' weight at x's colour, some heights k have weight\nsmaller by γ, and each filling I avoiding row x lifts to K, with |γ| more entries x, whose\nminor product has leading term y_x^γ times I's over every ring. -/\nlemma exists_bordering h (H : γ ∈ interlacing ((columnWeight τ h).curry (c x))) : ∃ k,\n  columnWeight τ h = γ.mapDomain (c x, ·) + columnWeight τ k ∧ ∀ I : ColouredTableau (c ∘ (↑)) τ k,\n  ∃ K : ColouredTableau c τ h, (∀ R [CommRing R], HasLeadingTerm (rowExpansion x (minorProduct R\n  K)) γ (minorProduct R I)) ∧ ∀ y : m → ℂ, ∏ j, ∏ s, y (K j s) = y x ^ degree γ * ∏ j, ∏ s,\n  y (I j s) := by\n  simp [interlacing, Finsupp.single_apply, sum_ite, ite_and] at H\n  choose S _ a using (exists_subset_card_eq <| H · |>.trans (le_card_sdiff ..))\n  let e j := ite (∀ i, j ∉ S i) 0 1\n  choose k K using fun j ↦ le_iff_exists_add'.1 (by grind : e j ≤ h j)\n  cases funext K; cases show γ = ∑ j, single (k j) (e j) by\n    ext; simp [← a, card_eq_sum_ones, ← sum_ite_mem_eq]; grind\n  use k, by simp [mapDomain_finsetSum, ← sum_add_distrib, e]; congr!; split <;> simp; grind, fun I ↦\n    ⟨(⟨if h : _ then I · ⟨·, h⟩ else x, by grind⟩), fun R _ ↦ ?_, by simp [prod_univ_add]; grind⟩\n  erw [map_prod]; refine .prod fun j ↦ ?_; dsimp +instances; rcases h : e j with _ | ⟨⟨⟩⟩ <;>\n    [convert HasLeadingTerm.of_monomial; convert HasLeadingTerm.sum (t := univ) (fun s ↦\n    @.of_monomial (MatrixPoly _ R) _ (single s.1 1) ((-1) ^ (k j + s.1) * det\n    (of (X ⟨I j · |>.1, s.succAbove ·⟩)))) (last _) (by grind [columnOrder_lt_of_eq_above (k\n    j)]); lia] <;> simp [rowExpansion, (I ..).1.2, ↓det_succ_row' _ (last _), monomial_eq]; ac_rfl\n\nlemma alternant_succ {N} (A : Antitone l) i x : @alternant (N + 1) x l = (-1) ^ i.1 * (∏ a, (x\n  (i.succAbove a) - x i)) * ∑ γ ∈ interlacing l,\n  x i ^ degree γ * alternant (x ∘ i.succAbove) (l - γ) := by\n  have := @A (N + 1); erw [alternant, interlacing, ← det_classical,\n    det_eq_of_forall_col_eq_smul_add_pred (B := fun _ ↦ vecCons _ _) _ (by tauto) fun _ _ ↦ by erw\n    [← sub_eq_iff_eq_add, mul_comm, ← mul_geom_sum₂_Ico _ (x i)\n    (by gcongr <;> first | exact A (by grind) | grind),\n    cons_val_succ], det_classical, det_succ_row' _ i, sum_univ_succ, det_mul_column, det_apply']\n  simp [alternant, prod_univ_sum, Finset.mul_sum, -val_rev]\n  rw [univ.sum_comm, ite_sum_zero, ← sum_filter, ← sum_filter]\n  refine' sum_bij' (fun g _ ↦ onFinset (range (N + 1)) (fun n ↦ l n - (List.ofFn ((g - (↑)) ∘\n    rev))[n]!) _) (fun γ _ j ↦ (l - γ) j.rev + j) .. <;> simp [degree_eq_weight_one, -val_rev,\n    sum_range, weight_apply, le_tsub_iff_left (A _), ← rev_bijective.sum_comp (l · - _)] <;> grind\n"),("src/Lib/GLn/SchurModule/Gram.lean","import Lib.GLn.SchurModule.Hook\n\n/-! Part of: Contravariant form on Weyl's lattice, Fischer product, irreducibility under U(n) (known\nresult; see Lib.Adelic.CuspForms.DeltaForms).\n\nThis file: Contravariant form on Weyl's lattice: symmetric, positive, invariant, inverse to the\nFischer product up to the hook number. -/\nseal Finset.univ Finset.sum Finset.prod\n\nopen MvPolynomial Module PolyRep ComplexOrder Sigma Function Fintype Equiv Finset Matrix\nvariable {Φ R S} [CommRing R] [CommRing S] [Fintype Φ] {n n'} [∀ τ : Φ, Fintype (n τ)]\n  [∀ τ, Fintype (n' τ)] {κ} (e : ∀ τ, n τ ≃ Fin (rankAt n τ)) (φ : R →+* S) (N)\n  (ι : ∀ τ, n τ ⊕ Unit ≃ n' τ) (g : ∀ τ, Matrix (n τ) (n τ) R) (ξ η s : _ → R)\n  (y : (Σ τ, n τ) × ℕ → R) (h : FitsRanks n n' κ) (z : ∀ τ, Matrix (n' τ) (n τ) R)\nattribute [local simp] comp_def weylEval Fin.val_inj ite_and permArray Matrix.mul_apply mul_sum\n  minor linearCombination_apply dotProduct Matrix.map mulVec RingHom.map_det detPow tableauPoly\n  AlgHom.map_det\n\nnamespace PolyRep\n\n/-- For an array y and enumerations e_τ of the rows, the square matrices with (a,b) entry\ny((τ,a), e_τ(b)): the first |n_τ| columns of block τ. -/\ndef squarePart τ := of (y ⟨⟨τ, ·⟩, e τ ·⟩)\n\nlemma schur_squarePart_mulVec : schur κ (squarePart e y) *ᵥ weylEval n κ (permArray e) =\n  weylEval n κ y := by simp [funext_iff, ↓schur_mulVec_weylEval_of_detExp_zero, nablaBasis,\n  squarePart, -Fin.val_castLE, ← Fin.val_castLE Fin.is_le', ← eq_symm_apply]\n\n/-- Over an infinite domain R, two linear maps L, L' from coordinate vectors of weight κ to a\nfree module are equal if D(y)L(ev_y) = D(y)L'(ev_y) for all arrays y, where D = ∏_τ\ndet_τ^{e_τ}. -/\nlemma ext_weylEval [IsDomain R] {M} [AddCommGroup M] [Module R M] [Free R M] {L L' : _ →ₗ[R] M} {s}\n  e (h : ∀ y ∈ Set.univ.pi fun _ ↦ s, eval y (detPow R n e) ≠ 0 → L (weylEval n κ y) =\n  L' (weylEval n κ y)) (hs : s.Infinite := by exact Set.infinite_univ) : L = L' := by\n  ext i; exact eval_apply_injective R (LinearMap.ext fun φ ↦\n    (linearIndependent_nablaBasis_mul_detPow e).eq_coords_of_eq\n    (funext_set _ (by tauto) fun y k ↦ by simpa [← mul_assoc, ← sum_mul, mul_comm _ (φ _),\n    imp_iff_or_not] using (congrArg φ <| pi_eq_sum_univ' (weylEval n κ y) ▸ h y k · :)) i)\n\nlemma map_weylKernel : map φ (weylKernel n κ y) =\n  weylKernel n κ (φ ∘ y) := by simp [weylKernel, rowSubst, map_bind₁, ← C_mul']\n\nlemma rowSubst_highestPoly : rowSubst (fun τ ↦ of fun i a ↦ y (⟨τ, a⟩, i.1)) (highestPoly R κ N) =\n  ∏ τ, ∏ h ∈ range (N τ), (of fun s t : Fin h ↦ ∑ a,\n  y (⟨τ, a⟩, s) • X (⟨τ, a⟩, ↑t)).det ^ κ τ h := by simp [highestPoly, prod_range, rowSubst]\n\n/-- The kernel K(x, y) = f(yᵀx) of `weylKernel` is symmetric: K(x, y) = K(y, x) for all arrays x,\ny over a commutative ring. -/\nlemma weylKernel_symm : weylKernel n κ y = eval (C ∘ y) (weylKernel n κ X) := by\n  simp [weylKernel, rowSubst_highestPoly, ← C_mul', mul_comm]; congr! 3; apply det_transpose\n\nlemma weylKernel_borelMul b : weylKernel n κ (borelMul fst b y) =\n  ((diagramWeight (rankAt n) κ).prod fun p ↦ (b (p.1, p.2, p.2) ^ ·))\n  • weylKernel n κ y := by simpa [← C_mul', map_finsuppProd, borelMul, @weylKernel_symm _ R] using!\n  (mem_nabla.1 (weylKernel_mem_nablaFam X) _ (C ∘ b) (C ∘ y))\n\n/-- Over any commutative ring, the value at an array y of the polynomial Σ_i (Gξ)_i b_i attached\nto ξ equals ev_yᵀ G ξ, where G is the Gram matrix and ev_y the vector of values b_i(y). -/\n@[simp ←] lemma eval_toPoly : eval y (toPoly n κ ξ) = weylEval n κ y ⬝ᵥ weylGramOver *ᵥ ξ := by\n  simp [toPoly, mul_comm]\n\nlemma nablaCombination_weylGramOver_mulVec : nablaCombination κ (weylGramOver *ᵥ ξ) =\n  toPoly n κ ξ := rfl\n\n/-- For square matrices g_τ and scalars s_τ, the block diagonal matrix diag(g_τ,s_τ), reindexed\nby n'_τ through the bijection n_τ ⊔ {point} ≅ n'_τ. -/\nnoncomputable def blockScalar τ := ((g τ).fromBlocks 0 0 (diagonal fun _ ↦ s τ)).reindex (ι τ) (ι τ)\n\n@[grind] lemma diagramWeight_eq_succ_add τ i : diagramWeight N κ (τ, i) = diagramWeight N κ (τ,\n  i + 1) + ite (i + 1 < N τ) (κ τ (i + 1)) 0 := by grind [diagramWeight_apply,\n  sum_Ioo_add_eq_sum_Ico, =_ Ico_add_one_left_eq_Ioo, Ico_eq_empty]\n\nlemma rowSubst_weylKernel_permArray (hg : ∀ τ, (g τ)ᵀ.BlockTriangular (e τ)) :\n  rowSubst g (weylKernel n κ (permArray e)) =\n  (∏ τ, ∏ a, g τ a a ^ diagramWeight (rankAt n) κ (τ, e τ a)) • weylKernel n κ (permArray e) := by\n  convert weylKernel_borelMul _ (∏ τ, ∏ a, ∏ b, if · = ⟨τ, e τ a, e τ b⟩ then g τ b a else 1)\n  erw [rowSubst_rowSubst]; congr\n  simp +instances [funext_iff, ← ext_iff, reindex_equiv (e _), borelMul]; tauto\n  simp [← prod_pow, Finsupp.prod_finsetProd_comm, ← and_assoc, ← Prod.ext_iff (y := (_, _))]\n  congr!; aesop\n\ninclude ι\n\nomit [Fintype Φ] in\nlemma rankAt_eq_succ τ : rankAt n' τ = rankAt n τ + 1 := by simp [← card_congr (ι _)]\n\nend PolyRep\n\n/-- The polynomial attached by the Gram matrix to the evaluation vector ev_y is the kernel x ↦\nf(yᵀx), f the highest weight product of leading minors. -/\n@[simp] lemma toPoly_weylEval : toPoly n κ (weylEval n κ y) = weylKernel n κ\n  y := by simpa [map_weylKernel, toPoly, weylGram, ← eval_map, aeval_def, ← C_mul'] using\n  (congr(mapAlgHom (aeval y) $(congr(∑ i, $(sum_coords_nablaBasis (coord_mem_of_coeff_mem\n  (nablaFam ℤ ..).toAddSubgroup 0 rfl (by simp [mem_nabla, aeval_eq_eval₂Hom, ← coeff_map,\n  sum_coords_nablaBasis (weylKernel_mem_nablaFam X), map_weylKernel, weylKernel_borelMul]) i)) •\n  _).trans (sum_coords_nablaBasis (weylKernel_mem_nablaFam X)))))\n\n/-- The Gram matrix `weylGram` does not depend on the labelling of the places: for a bijection p\nfrom Φ to Ψ, that of (n, κ) is that of the data transported to Ψ, with rows and columns\nreindexed along p. -/\nlemma PolyRep.weylGram_eq_submatrix {Ψ} [Fintype Ψ] κ (p : Φ ≃ Ψ) : weylGram n κ = (weylGram _\n  _).submatrix (p.piCongrLeft' _) (p.piCongrLeft' _) := let e := Prod.map p.symm.sigmaCongrLeft id\n  toLin'.injective (ext_weylEval 0 fun y _ _ ↦ nablaCombination_injective (.trans (toPoly_weylEval\n    _) (by simpa [toPoly, rowSubst, nablaBasis, e, weylKernel, highestPoly, reindex_equiv p.symm,\n    reindex_equiv (p.piCongrLeft' _).symm] using congr(rename e $(toPoly_weylEval (y ∘ e))).symm)))\n\n@[simp] lemma map_toPoly : map φ (toPoly n κ ξ) = toPoly n κ (φ ∘ ξ) := by simp [toPoly, ← C_mul']\n\ninclude h\n\nlemma PolyRep.vecMul_schur_eq_iff {c x} : c ᵥ* schur κ z = x ↔ rowSubst z (nablaCombination κ c) =\n  nablaCombination κ x * detPow R n (schurDetExp n n' κ) := (isRegular_detPow.2.comp\n  nablaCombination_