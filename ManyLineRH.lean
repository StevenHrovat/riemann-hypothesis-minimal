  simp [homHeisOp, homAtPoint, sum]
  congr; erw [flipCoords_apply (x := matToVec (toRows₁ _)), vecToMat_matToVec, toRows₁_fromRows]
  simp [formAdjoint, map_J_inv, V'.map_J]

