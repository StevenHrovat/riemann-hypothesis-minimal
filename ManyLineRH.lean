  l ↦ by simpa [pairWeil, ← e, ← d, ← G.sum.map_mul] using (pairThetaKer _ _ 1 1).4 (γ' := .sum
  (γ.neg, 1)) k (by simpa [↓sum_mem_Γ, mem_Gamma_iff_ratCoordMatrix] using h) g' (.sum (g.neg, l)) f
end

