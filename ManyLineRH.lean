lemma exists_repr_cech m : ∃ D z, AllBijective (@pointMap _ _ (cech (reprMap φ) m) D z ·) :=
  have := @PerfectAlg.closed_under_widePushoutShape p S _ _ p_eq_zero_of_algebra_oFlat; ⟨_,
