      (levelSpace_anti (kv e.1) (tw _ ψ.2)) fun k h ↦ by simp [Gf.eq_of_supportedOn h (one_mem _)
      fun v ⟨a, b⟩ ↦ b.elim (v.ext (Ideal.comap_injective_of_surjective _ (MulAction.surjective σ)
