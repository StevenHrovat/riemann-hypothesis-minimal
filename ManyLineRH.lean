attribute [-instance] QuadField.instNeZeroNat QuadField.instFactEqNatHModOfNatOfPrimeSevenModEight PrimeSevenModEight.toFact instFactPrimeValNat_lib  -- single-file: instances of Lib.General.NumberTheory.QuadField, not imported here
