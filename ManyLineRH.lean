    ZMod (l ^ n))) (∏ q ∈ S, ∑ u, .single (.mk (ofAdd (ofZMod _ u.1))) ((L q u).toAdd - d q))
  have Λ1 {q S} (h : q ∉ S) d F : Λ (insert q S) d F = Λ S d fun x ↦ ∑ u, ((L q u).toAdd - d q) * F
