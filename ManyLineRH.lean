attribute [local simp] Real.log_mul Real.log_div Real.log_rpow Real.log_sqrt DirichletCharacter.norm_le_one NeZero.ne NeZero.pos Complex.norm_cpow_eq_rpow_re_of_pos  -- from Lib.Analytic.PolyaVinogradov.PolyaVinogradov
attribute [-instance] instStarRingRingOfIntegers_lib CMType.toNumberField CMType.toIsCMField  -- single-file: instances of Lib.Adelic.Adeles.CoprimeValuation, not imported here
attribute [-simp] map_star_complex  -- single-file: simp lemmas of Lib.Adelic.Adeles.CoprimeValuation, not imported here
