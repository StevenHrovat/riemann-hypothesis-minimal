  let π := localFormRep V κ (Q.apart.2 j j); let ρ' := ρ.comp K.subtype; let G :=
    p.comp (C (a θ.frob) * X)
  have act {k} (m : k ∈ blockParahoric _) y : π k _ = (ρ' ⟨_, (hK ⟨k, m.1⟩).1.2 m⟩).1 y :=
    (residueRep_mulSingle hQ ⟨k, _⟩ y).symm
