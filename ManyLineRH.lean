  Fintype (n i)] {S₀ S : Finset (FinPlace E)} {z M} {γ β : ι → _} (hS : S ⊆ S₀) (hz :
  z ∈ inertiaAbove (S₀ \ placesDividing E ℓ))
include hS hz
attribute [-simp] Set.insert_eq_of_mem

