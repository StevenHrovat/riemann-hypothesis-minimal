  exact ⟨_, (b.2 u rfl).1 ▸ _root_.funext ((((bijective_pow_gal hσ).2.exists.1
    (FinPlace.exists_gal_comap_eq (hU x))).rec fun i ↦ (· ▸ i.1.rec (fun _ i ↦ congr($t₂
