lemma Space.mem_ratVectors_hom {x} : x ∈ (S.hom T).ratVectors ↔
  T.x.1 * vecToMat x * S.x⁻¹.1 ∈ ratMatrices .. := by simp [mem_ratVectors_iff, hom,
  kronecker_mulVec_eq_matToVec, mem_ratVectors, mem_ratMatrices, matToVec]

