    any_goals simp [D, -squarePart, det_permute', ← zsmul_eq_mul, AlgHom.map_det, -fromCols_toCols]
    any_goals ext ⟨⟩ ⟨⟩ <;> simp [*, -squarePart, -q, ← DFunLike.congr_fun (q I)] <;> rfl
    all_goals congr 2 with; simp [ρ, mul_apply, ← w, *] <;> grind
