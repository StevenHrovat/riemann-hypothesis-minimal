      ▸ by rw [pow_mul, h, one_pow])) (s := s ∪ image (withConjInv τ) univ) fun e Z H ↦ (fun N ↦
    ⟨hasTriangleCost_tateTwist tri N (H · · |>.2.2) (add_le_add (relLength_mono (H · · |>.1) le_rfl)
