    have ⟨μ, _, Z, P⟩ := (exists_inertia_eigenvalues n hc b a V.rankDiff).choose_spec.2 _ s
    convert ((hu x).1.local_conditions v (·.2 (.inr ⟨i, b⟩)) a).1.aeval_eq_zero_of_roots
