    G i) → ∫ x, ∫ y, ∑ i, c i • F i (x, y) ∂A.quotMeasure ∂μ = ∑ i, c i • G i := fun _ ↦ by
  rw [integral_integral, integral_finsetSum] <;> (try apply integrable_finsetSum) <;>
    congr! <;> by_cases c ‹_› = 0 <;> simp [Integrable.const_mul, *]

