lemma AuxPair.exists_atPlace_eq {m} [Fintype m] g : g ∈ (supportedOn m O.places).map (.pi fun i ↦
  atPlace (O.placeAt i)) := Subgroup.pi_mem_of_mulSingle_mem g fun i ↦
