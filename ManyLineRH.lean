    .trans ⟨_, rfl⟩ (h2 _ e.2)), fun z k K ↦ ?_⟩⟩, s⟩
  choose m u _ c
    using by simpa [mem_selmerModule_iff, tateTwist, -Pi.add_apply] using add_mem k.1 k.1
