    erw [mul_pow, mul_mul_mul_comm, key, pow_right_comm, pow_sub_one_mul l.1.ne_zero, ← pow_succ,
    eS, ← pow_succ, eT, relIndex_ker, Nat.card_congr (.subtypeUnivEquiv fun a ↦
