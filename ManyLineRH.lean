    arrow_ι fun _ ↦ φ]⟩, fun _ ↦ bijective_iff_has_inverse.2 ⟨fun e ↦ ⟨desc _ _ (congr($(e.2 ·
  0).1))⟩, by constructor <;> intro <;> solve_by_elim [Subtype.ext, funext,
    ULift.ext, ι_desc fun _ ↦ φ, (eq_desc_of_comp_eq ..).symm, (arrow_ι_assoc ..).symm]⟩⟩

