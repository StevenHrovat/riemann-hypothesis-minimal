  erw [Θ.sliceEquiv_mulClass, map_homClass_comp, comp_assoc, ← (t _ (restrictAlong _ ⋙ _) ..).1 _
    (tensorPoint (𝟙 _) _), Θ.onElements.tateGen_comp_tateAction]
