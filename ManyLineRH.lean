  _ →* EllAdicIntegers} (hN : ∀ x g, (N x g).1 = algebraMap EllAdicIntegers (PadicAlgCl ℓ) (a g) •
  (x.galRep g).1) (ha : ∀ j, a (Q.frobData j).isPlaceOver.tameGenerator = 1)

