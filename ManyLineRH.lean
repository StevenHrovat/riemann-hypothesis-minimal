    fun _ ↦ by simp).choose_spec (reduceGL_surjective.forall.2 fun k m ↦ by
    ext y : 3; simpa [eB, ρ, residueRep_mulSingle hQ k] using! (aeval_apply_smul_mem_of_le_comap (by
