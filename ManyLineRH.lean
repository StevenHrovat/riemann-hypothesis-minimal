section
run_cmd Lean.Elab.Command.liftCoreM RHSingleFile.freshCaches  -- single-file: fresh caches, as in a separate file
/-! General lemmas (textbook or folklore) of algebraic number theory, commutative algebra and
analysis.

This file: General facts on differents, root discriminants; ramified ideals divide the different.
One-dimensional Sobolev trace inequality, iterated at a cube corner for families. -/

open Ideal Set ENNReal Fintype Function MeasureTheory Module NumberField MeasureTheory.Measure

open scoped _root_.Algebra Polynomial

variable (K) {L} [Field K] [Field L] [NumberField K] [NumberField L] [IsTotallyComplex K] {x : 𝓞 L}

lemma differentIdeal_eq_span_of_dvd K {A} [Field K] [NumberField K] [Algebra K L] [CommRing A]
  [IsDedekindDomain A]
  [Algebra A K] [IsFractionRing A K] [Algebra A (𝓞 L)] [IsTorsionFree A (𝓞 L)] [Module.Finite A (𝓞
  L)] [CharZero A] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A (𝓞 L) L] {x y : 𝓞 L} (hx :
  K[x.val] = ⊤) (f : A[X]) (hf : Polynomial.aeval x f = 0) (e : Polynomial.aeval x f.derivative =
  y) (h : span {y} ∣ differentIdeal A _) : differentIdeal A _ = span {y} ∧ A[x] = ⊤ := by
  obtain ⟨⟨⟩, C⟩ := minpoly.isIntegrallyClosed_dvd (.of_finite ..) hf,
    (conductor_mul_differentIdeal A K L x hx).dvd
  have t H := ((C.trans H).trans h).antisymm
  rw [h.antisymm] <;>
    simp_all [← conductor_eq_top_iff_adjoin_eq_top, differentIdeal_ne_bot, ← e, mul_mem_right]

/-- If x generates the different of the ring of integers of a number field L over ℤ, then x ≠ 0. -/
lemma ne_zero_of_differentIdeal_eq_span : differentIdeal ℤ _ = span {x} →
  x ≠ 0 := by aesop (add simp differentIdeal_ne_bot)

/-- The number of infinite places of the number field K. -/
noncomputable abbrev numInfPlaces := card (InfinitePlace K)

/-- The degree over ℚ of a totally complex number field is twice its number of infinite places. -/
lemma finrank_eq_two_mul_card_infinitePlace :
  finrank ℚ K = 2 * numInfPlaces K := by simp +arith [← InfinitePlace.sum_mult_eq]

omit [IsTotallyComplex K] in
lemma rootDiscr_pos : 0 < rootDiscr K := Real.rpow_pos_of_pos (by simp [discr_ne_zero]) _

lemma abs_discr_eq_rootDiscr_pow : (|discr K| : ℝ) = (rootDiscr K ^ numInfPlaces K) ^ 2 := by
  simp [← pow_mul', finrank_eq_two_mul_card_infinitePlace, rootDiscr,
    Real.rpow_inv_natCast_pow, -Nat.cast_mul]

/-- An ideal P of the integers of a number field L whose square contains a rational prime
divides the different of L over ℚ. -/
lemma dvd_differentIdeal_of_mem_sq {P : Ideal (𝓞 L)} {p} [Fact (Nat.Prime p)] (h : ↑p ∈ P ^ 2) :
  P ∣ differentIdeal
  ℤ _ := by simpa [NeZero.ne, h] using pow_sub_one_dvd_differentIdeal ℤ (p := span {↑p}) P 2

/-- One-dimensional Sobolev trace inequality: for g differentiable at every point of [0, ε], 0 <
ε ≤ 1, with values in a real inner product space, ‖g(0)‖² ≤ (2/ε) ∫₀^ε (‖g‖² + ‖g'‖²). -/
lemma sobolev_trace {E} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {g : ℝ → E} {b : ℝ → _} {ε}
    (hε : 0 < ε) (hε' : ε ≤ 1) (h : ∀ t ∈ Icc 0 ε, ∃ c, HasDerivAt g c t ∧ ‖c‖ ≤ b t) :
    ‖g 0‖ₑ ^ 2 ≤ ∫⁻ t in Icc 0 ε, .ofReal (2 / ε * (‖g t‖ ^ 2 + b t ^ 2)) := by
  choose! g' h k using h; let := HasDerivAt.continuousOn h
  grw [← setLIntegral_mono', ← addHaar_image_le_lintegral_abs_det_fderiv _ _ (h · · |>.norm_sq.mul
    ((hasDerivAt_id _).sub_const ε) |>.hasDerivWithinAt.mul_const ε⁻¹), ← intermediate_value_Icc
    hε.le (by fun_prop)] <;> simp [↓ofReal_le_ofReal_iff', ne_of_gt, abs_of_pos, field, *]
  grw [← k, abs_add_le, (abs_mul ..).le, mul_le_of_le_one_right, ← add_sq_le] <;>
    grind [abs_sq, abs_real_inner_le_norm]

/-- Let measurable f_i(x, ω), i words in L, have ‖∂_d f_i‖ ≤ Λ∑_l ‖f_{li}‖ on the cube [0, ε]^D,
0 < ε ≤ 1, for almost all ω. If ∬‖f_i‖² ≤ K on the cube for |i| ≤ |D|, then ∫‖f_∅(0, ω)‖² ≤
(2(1+(|L|Λ)²)/ε)^{|D|}K. -/
lemma sobolev_chain {Ω I L D} [MeasurableSpace Ω] {σ : Measure Ω} [SFinite σ] [Fintype L] [Fintype
    I] [Fintype D] (f : _ → (D → ℝ) → Ω → EuclideanSpace ℂ I) (hm : ∀ i, Measurable ↿(f i)) {ε Λ K}
    (hε : 0 < ε) (hε' : ε ≤ 1) (hd : ∀ᵐ ω ∂σ, ∀ i d x t, update x d t ∈ Icc 0 (fun _ ↦ ε) → ∃ c,
    HasDerivAt (update x d · |> f i <| ω) c t ∧ ‖c‖ ≤ ∑ l : L, Λ * ‖f (l :: i) (update x d t) ω‖) :
    (∀ i, i.length ≤ card D → ∫⁻ x in Icc 0 fun _ ↦ ε, ∫⁻ ω, ‖f i x ω‖ₑ ^ 2 ∂σ ≤ K) → ∫⁻ ω, ‖f [] 0
    ω‖ₑ ^ 2 ∂σ ≤ .ofReal ((2 / ε * (1 + (card L * Λ) ^ 2)) ^ card D) * K := by
  simp_rw [volume_pi, ← pi_univ_Icc, restrict_pi_pi, lintegral_eq_lmarginal_univ 0, card]
  refine' Finset.univ.induction (by simp) (fun d s e ih K h ↦ (ih (id ..) fun i _ ↦ _).trans_eq _) K
  grw [lmarginal, ← restrict_pi_pi, setLIntegral_mono' _ fun y _ ↦ (lintegral_mono_ae (hd.mono
    fun ω hd ↦ (sobolev_trace hε hε' (hd i d (updateFinset 0 _ y) · ∘ by
    simp_all [Pi.le_def, updateFinset_def]; grind)).trans_eq' (by congr; simp [e, updateFinset]))
    ).trans_eq (lintegral_lintegral_swap (by fun_prop)), restrict_pi_pi, sq_sum_le_card_mul_sum_sq]
  any_goals simp (disch := intros; with_unfolding_all first | positivity | fun_prop) [lmarginal,
    mul_pow, ↓lmarginal_insert' _ _ e, lintegral_finsetSum, ofReal_add, ofReal_sum_of_nonneg] at h ⊢
  grw [h, h] <;> grind; simp [*]; ring

/-- Weak Nullstellensatz: a proper ideal J of a finitely generated algebra A over an
algebraically closed field k lies in the kernel of some k-algebra homomorphism A → k. -/
lemma nullstellensatz_exists_le_ker {k A} [Field k] [IsAlgClosed k] [CommRing A] [Algebra k A]
    [f : Algebra.FiniteType k A] {J} (n : J ≠ ⊤)
    : ∃ o : A →ₐ[k] k, J ≤ RingHom.ker o := have ⟨m, _, j⟩ := J.exists_le_maximal n
  have := @finite_of_finite_type_of_isJacobsonRing k _ _ (Quotient.field m) _ _ _
  ⟨IsAlgClosed.lift.comp (Quotient.mkₐ k m), (by simp [Quotient.eq_zero_iff_mem.2, @j · ·])⟩

lemma zpow_sum_of_ne_zero {ι K} [Field K] {s : K} (hs : s ≠ 0) t (f : ι → ℤ) :
    s ^ ∑ i ∈ t, f i = t.prod (s ^ f ·) := t.induction (by simp) (by simp_all [zpow_add₀])
end

-- ═══ src/Lib/Adelic/Adeles/CoprimeValuation.lean ═══
section
run_cmd Lean.Elab.Command.liftCoreM RHSingleFile.freshCaches  -- single-file: fresh caches, as in a separate file
/-! Part of: Adeles of a number field: base change, discreteness and compact quotient, modulus
(known result; see Lib.Adelic.Adeles.IdeleHilbert90).

This file: Places, completions, adeles, integral adeles, maps under field embeddings, CM
conjugation. -/

noncomputable section

open Ideal _root_.IsDedekindDomain Set Classical Filter IsLocalRing NumberField RestrictedProduct
  Valued WithZero WithZeroTopology Ideal.IsDedekindDomain IsDedekindDomain.HeightOneSpectrum
  UniformSpace.Completion adicCompletion

/-- A choice, for each infinite place w of E, of a complex embedding Φ w of E that induces w. -/
class PlaceEmbedding (E : Type*) [Field E] where
  Φ : _ → E →+* ℂ
  mk_Φ w : InfinitePlace.mk (Φ w) = w

export PlaceEmbedding (Φ mk_Φ)

attribute [simp] mk_Φ

instance (priority := low) (E : Type*) [Field E] : PlaceEmbedding E :=
  ⟨_, InfinitePlace.mk_embedding⟩

/-- E is a CM number field equipped with a CM type: for each infinite place w of E, a chosen
complex embedding of E that induces w. -/
class CMType (E : Type*) [Field E] extends NumberField E, IsCMField E, PlaceEmbedding E

/-- The set of finite places of E, that is, nonzero prime ideals of its ring of integers. -/
abbrev FinPlace (E : Type*) [Field E] := HeightOneSpectrum (𝓞 E)

/-- The ring of finite adeles of the number field E. -/
abbrev 𝔸f (E : Type*) [Field E] [NumberField E] := FiniteAdeleRing (𝓞 E) E

/-- The ring ℂ^f × 𝔸_f, one copy of ℂ for each infinite place of E times the finite adeles: the
adele ring of E when E is totally complex. -/
abbrev 𝔸 (E : Type*) [Field E] [NumberField E] := (InfinitePlace E → ℂ) × 𝔸f E

variable {E : Type*} [Field E] [NumberField E] (w : FinPlace E) {K L : Type*} [Field K]
  [NumberField K] [Field L] [NumberField L] (f : K →+* L) {w' : FinPlace K} (x : 𝓞 K) (x : K)

/-- The diagonal embedding of E in its adeles, given at the infinite places by the chosen embeddings
Φ w. -/
@[simps! apply_fst apply_snd] def toAdele [PlaceEmbedding E] : E →+* 𝔸 E :=
  .prod (.pi Φ) (algebraMap ..)

instance [PlaceEmbedding E] : Coe E (𝔸 E) := ⟨toAdele⟩

instance : Coe E (𝔸f E) := ⟨algebraMap ..⟩

/-- The completion E_w of E at the finite place w. -/
abbrev LocField := w.adicCompletion E

/-- The ring of integers of the completion E_w of E at the finite place w. -/
abbrev LocInt := w.adicCompletionIntegers E

instance : CommSemiring (LocInt w) := CommRing.toCommSemiring

instance : @IsLocalRing (LocInt w) CommRing.toCommSemiring.toSemiring := inferInstance

/-- The residue field of the completion E_w of E at the finite place w. -/
@[instance_reducible] def ResField := ResidueField (LocInt w) deriving Field, Algebra (𝓞 E)

/-- The absolute norm of the prime ideal w, that is, the order of its residue field. -/
abbrev FinPlace.q := w.1.absNorm

@[simp] lemma FinPlace.one_lt_q : 1 < w.q := HeightOneSpectrum.one_lt_absNorm w

@[simp] lemma FinPlace.q_bounds : 0 < w.q - 1 ∧ w.q ≠ 0 ∧ 1 ≤ w.q ∧ 0 < w.q := by grind [one_lt_q]

/-- A chosen uniformiser of the completion of E at the finite place w. -/
def uniformizer :=
  Units.mk0 (w.valuedAdicCompletion_surjective E (exp (-1))).choose (by grind [exp_pos])

@[simp] lemma v_uniformizer : v (uniformizer w).1 = exp (-1) := by grind [uniformizer, Units.mk0]

/-- The ring homomorphism sending a finite adele to its component in E_w. -/
def evalAt : 𝔸f E →+* LocField w := evalRingHom (fun v ↦ LocField v) w

@[simp] lemma evalAt_apply x : evalAt w x = x w := rfl

set_option synthInstance.maxHeartbeats 200000 in
/-- The map sending a in E_w to the finite adele with component a at w and 0 elsewhere, a ring
homomorphism that does not preserve 1. -/
def singleAdele : LocField w →ₙ+* 𝔸f E :=
    ⟨⟨.single LocInt w, (Subtype.ext <| Pi.single_mul w · ·)⟩, single_zero .., single_add _ _⟩

@[simp] lemma singleAdele_same x : singleAdele w x w = x := dite_eq_left rfl

@[simp] lemma singleAdele_of_ne {v w : FinPlace E} (h : v ≠ w) x : singleAdele w x v = 0 :=
  dite_eq_right h

/-- The subring Ô of finite adeles of E that are integral at every finite place. -/
def Ô (E : Type*) [Field E] [NumberField E] := ⨅ w : FinPlace E, (LocInt w).1.comap (evalAt w)

lemma mem_Ô {x} : x ∈ Ô E ↔ ∀ w, v (x w) ≤ 1 := Subring.mem_iInf

/-- Reduction modulo w: the ring homomorphism from the integral finite adeles to the residue
field at w. -/
def reduceAt : Ô E →+* ResField w :=
  (residue _).comp (((evalAt w).domRestrict _).codRestrict _ (mem_Ô.1 ·.2 w))

instance : MeasurableSpace (LocField w) := borel _

instance : BorelSpace (LocField w) := ⟨rfl⟩

instance : MeasurableSpace (𝔸f E) := borel _

instance : BorelSpace (𝔸f E) := ⟨rfl⟩

/-- The structure of ring with involution on a commutative ring R given by a ring endomorphism
whose square is the identity. -/
abbrev starRingOfInvolution {R} [CommRing R] (star : R →+* R) (star_involutive :
  (⇑star).Involutive) : StarRing R := by refine' { star, .. } <;> grind

@[local simp] lemma v_algebraMap_eq_valuation : v (algebraMap K (LocField w') x) =
  w'.valuation K x := valued_coe ..

lemma mem_LocInt {x} : x ∈ LocInt w' ↔ v x ≤ 1 := .rfl

variable {w : FinPlace K} (x : 𝓞 K)

lemma v_algebraMap_eq_intValuation : v (algebraMap K (LocField w) x) =
  w.intValuation x := by simp [valuation_of_algebraMap]

lemma v_algebraMap_eq_one {x} (h : x ∉ w.1) : v (algebraMap K (LocField w) x) = 1 := by simpa

section

@[local fun_prop] lemma continuous_v : Continuous (v : LocField w → _) :=
    continuous_valuation_of_surjective (w.valuedAdicCompletion_surjective K)

lemma finite_natCast_mem n [NeZero n] : {v : FinPlace K | Nat.cast n ∈ v.1}.Finite := by
  simp [← dvd_span_singleton, finite_factors, NeZero.ne]

/-- For f: K → L and a finite place w of L, the finite place of K below w: the preimage under f
of the prime ideal w. -/
def FinPlace.comap (w : FinPlace L) : FinPlace K := let := f.toAlgebra; w.under _

variable {u} {w : FinPlace L} (h : w.comap f = u) (x : K) [IsCMField E]

/-- For an extension L/K, the finite place of K below the finite place w of L. -/
abbrev FinPlace.below K [Field K] [Algebra K L] w := comap (algebraMap K L) w

/-- Two continuous maps to a Hausdorff space that agree on the image of a map with dense range
are equal. -/
lemma DenseRange.eq {X Y ι} [TopologicalSpace X] [TopologicalSpace Y] [T2Space Y] {e : ι → X}
  (D : DenseRange e) {f g : X → Y} (h : ∀ a, f (e a) = g (e a) := by aesop) (a : Continuous f := by
  fun_prop) (b : Continuous g := by fun_prop) x : f x = g x := D.induction_on x (isClosed_eq a b) h

/-- For f: K → L and a finite place w of L above u, the continuous ring homomorphism K_u → L_w
extending f. -/
def locMap := let := f.toAlgebra; have := LiesOver.mk congr($h.1).symm
  (equiv L w).symm.toRingHom.comp ((mapRingHom _ (uniformContinuous_algebraMap_liesOver K L
    ..).continuous).comp (equiv K u).toRingHom)

@[fun_prop] lemma continuous_locMap :
    Continuous (locMap f h) := continuous_induced_rng.2 (continuous_map.comp (by fun_prop))

@[simp] lemma locMap_algebraMap : locMap f h (algebraMap K _ x) = algebraMap L _ (f x) := by
  simp [locMap, -mapRingHom_apply]; erw [mapRingHom_coe]; rfl

attribute [irreducible] locMap

lemma exists_v_locMap_eq_pow : ∃ e ≠ 0, ∀ x, v (locMap f h x) = v x ^ e := let := f.toAlgebra
            have := LiesOver.mk congr($h.1).symm; ⟨_, (w.1.ramificationIdx_pos (𝓞 K)).ne',
              (u.denseRange_algebraMap K).eq (by simp [valuation_liesOver L]; tauto)⟩

@[simp] lemma v_locMap_le_one {x} : v (locMap f h x) ≤ 1 ↔ v x ≤ 1 := by
  grind [exists_v_locMap_eq_pow f h, pow_le_one_iff]

lemma isEquiv_comap_locMap : (v.comap (locMap f h)).IsEquiv v :=
  Valuation.isEquiv_of_val_le_one (by simp)

lemma v_locMap_eq_of_isUnit_log (s : ∃ z, IsUnit (v (locMap f h z)).log) x : v (locMap f h x) =
  v x := by cases exists_v_locMap_eq_pow f h; simp_all [Int.isUnit_iff]

lemma v_locMap_eq_of_surjective (s : (⇑f).Surjective) : ∀ x, v (locMap f h x) = v x :=
  v_locMap_eq_of_isUnit_log f h
  (((w.valuation_surjective L).comp s (exp 1)).imp' (algebraMap ..) (by aesop))

lemma tendsto_place_comap_cofinite :
  Tendsto (FinPlace.comap f) cofinite cofinite := let := f.toAlgebra
  .cofinite_of_finite_preimage_singleton (map_ne_bot_of_ne_bot ·.3 |> finite_factors |>.subset
                           fun _ ↦ (· ▸ dvd_iff_le.2 map_comap_le))

/-- For an embedding f: K → L of number fields, the induced ring homomorphism from the finite
adeles of K to those of L; it gives base change and the Galois action. -/
def adeleMap : 𝔸f K →+* 𝔸f L := mapAlongRingHom LocField LocField _ (tendsto_place_comap_cofinite f)
  (fun _ ↦ locMap f rfl) (by simp [MapsTo, mem_LocInt])

variable (K L) in
/-- For an extension of number fields L over K, the inclusion of the finite adeles of K in those
of L. -/
abbrev finAdeleIncl [Algebra K L] := adeleMap (algebraMap K L)

lemma adeleMap_apply x : adeleMap f x w = locMap f h (x u) := by aesop

@[fun_prop] lemma continuous_adeleMap : Continuous (adeleMap f) := by apply
  mapAlong_continuous <;> simp [tendsto_place_comap_cofinite, MapsTo, mem_LocInt, continuous_locMap]

@[simp] lemma adeleMap_algebraMap : adeleMap f x = f x := by ext1; apply locMap_algebraMap

instance instStarRingRingOfIntegers_lib : StarRing (𝓞 E) :=
  starRingOfInvolution (IsCMField.ringOfIntegersComplexConj E) (by aesop_cat)

@[simp, norm_cast] lemma coe_star_ringOfIntegers (x : 𝓞 E) : star x = star x.val := rfl

@[simp] lemma map_star_complex (φ : E →+* ℂ) x :
    φ (star x) = star (φ x) := IsCMField.complexEmbedding_complexConj ..

lemma map_star_CM [IsCMField K] [IsCMField L] x : f (star x) = star (f x) :=
    (Φ ofNonempty).injective ((map_star_complex (.comp ..) x).trans (by simp))

instance : InvolutiveStar (FinPlace E) :=
    { star := comap (starRingEnd _) star_involutive.surjective, star_involutive w := by aesop }

/-- The finite place w of the CM field E is split over the maximal real subfield: it differs
from its complex conjugate. -/
abbrev FinPlace.IsSplit (w : FinPlace E) := star w ≠ w

variable {u w : FinPlace E} (h : star u = w)

@[simp] lemma mem_star_place {x} : x ∈ (star w).1 ↔ star x ∈ w.1 := .rfl

variable (E) in
/-- The hypothesis on a CM field E, called stably unramified, that E contains a primitive root
of unity of order 5040 = 7!. -/
class StablyUnram [IsCMField E] where exists_primitive_root : ∃ ζ : E, IsPrimitiveRoot ζ 5040

/-- If the CM field E contains a primitive 5040-th root of unity, then O_E contains i with i² =
−1, ī = −i, and ω with ω + ω̄ = 1, ωω̄ = 2. -/
lemma StablyUnram.exists_i_c₀ [h : StablyUnram E] : ∃ i ω : 𝓞 E, i * i = -1 ∧ star i = -i ∧
  ω + star ω = 1 ∧ ω * star ω = 2 := have ⟨y, z⟩ : ∃ y, IsPrimitiveRoot y 28 :=
    ⟨_ ^ 180, h.1.choose_spec.toInteger_isPrimitiveRoot.pow (by simp) rfl⟩
  have g a := (z.pow_of_dvd (p := a) · · |>.geom_sum_eq_zero)
  ⟨y ^ 7, y ^ 2 - y ^ 4 - y ^ 8, by
  obtain := g 14, g 4, (congr($(IsCMField.unitsComplexConj_torsion E
    ⟨_, (z.isUnit_unit (by simp)).isOfFinOrder nofun⟩).1 * y) : star y * y = _)
  simp [Finset.sum_range_succ] at *
  grind⟩

lemma StablyUnram.exists_isUnit_sub_star [StablyUnram E] : ∃ y : 𝓞 E, IsUnit (y - star y) :=
  exists_i_c₀.elim fun i ⟨ω, _⟩ ↦ ⟨i * ω, .of_mul_eq_one (-i) (by grind [star_mul])⟩

/-- For finite places u, w with ū = w, the homomorphism E_u → E_w of completions induced by
complex conjugation. -/
def conjLoc := locMap (starRingEnd E) (star_eq_iff_star_eq.1 h)

@[simp] lemma v_conjLoc x : v (conjLoc h x) = v x :=
  v_locMap_eq_of_surjective _ _ starRingAut.surjective x

@[simp] lemma valuation_star (w : FinPlace E) x : (star w).valuation E (star x) = w.valuation E
  x := by erw [← v_algebraMap_eq_valuation x, ← v_conjLoc rfl, locMap_algebraMap]; aesop

end

lemma Nat.Coprime.valuation_eq_one {Ω} [Field Ω] {B : ValuationSubring Ω} {p q : ℕ} (hq :
  p.Coprime q) (h : B.valuation p < 1) : B.valuation q = 1 := (B.valuation_eq_one_iff q).1
  (by_contra (IsPrime.notMem_of_isCoprime_of_mem hq.cast (B.coe_mem_nonunits_iff.1 h)))
end
end

-- ═══ src/Lib/General/NumberTheory/Embeddings.lean ═══
section
run_cmd Lean.Elab.Command.liftCoreM RHSingleFile.freshCaches  -- single-file: fresh caches, as in a separate file
/-! General lemmas of algebraic number theory (textbook or folklore).

This file: Complex embeddings of a totally complex field come in conjugate pairs. -/

open NumberField Polynomial ComplexEmbedding InfinitePlace Finset IsTotallyComplex


variable {E} [Field E] [IsTotallyComplex E]

@[simp, grind] lemma conjugate_ne_self σ : @conjugate E _ σ ≠ σ := complexEmbedding_not_isReal _

@[to_additive] lemma prod_embeddings_eq_prod_pairs [NumberField E]
  [PlaceEmbedding E] {M} [CommMonoid M] (F : (E →+* ℂ) → M) : ∏ σ, F σ = ∏ v, F (Φ v) * F (conjugate
  (Φ v)) := prod_fiberwise _ mk F ▸ by congr!; apply prod_eq_mul <;> grind [mk_Φ, mk_eq_iff]

omit [IsTotallyComplex E] in
lemma roots_map_conjugate (P : E[X]) σ : (P.map (conjugate σ)).roots = (P.map σ).roots.map star :=
  (P.map_map ..).rec ((IsAlgClosed.splits _).roots_map _)
end

-- ═══ src/Lib/General/NumberTheory/QuadField.lean ═══
section
run_cmd Lean.Elab.Command.liftCoreM RHSingleFile.freshCaches  -- single-file: fresh caches, as in a separate file
/-! General lemmas of algebraic number theory (textbook or folklore).

This file: Imaginary quadratic field Q(√-d): degree, CM structure, integers, different, quadratic
character. -/

noncomputable section

open NumberField Complex Polynomial InfinitePlace Module IntermediateField AddChar


instance instFactPrimeValNat_lib (d : Nat.Primes) : Fact d.1.Prime := ⟨d.2⟩

variable {N} [NeZero N] (χ : DirichletCharacter ℂ N) (d : ℕ) [Fact d.Prime]

/-- The Legendre symbol (·/d) as an integer-valued Dirichlet character modulo the prime d; for d
≡ 3 mod 4 it is the character χ_K of K = ℚ(√−d). -/
def chiK : DirichletCharacter ℤ d := open Calc in quadraticChar _

lemma chiK_eq_legendreSym (n : ℕ) : chiK d n = legendreSym d n := by simp [chiK, legendreSym]

/-- For a Dirichlet character χ mod N and a prime d, the character mod Nd that is the product of
χ and the Legendre symbol (·/d). -/
def quadTwist :=
  χ.changeLevel ⟨d, rfl⟩ * .changeLevel (by simp) ((chiK d).ringHomComp (algebraMap ..))

/-- The entire function equal to L(s, χ) if χ is not principal, and to the continuation of (s −
1)L(s, χ) if χ is principal. -/
def entireL := ite (χ = 1) (DirichletCharacter.LFunctionTrivChar₁ N) χ.LFunction

/-- For an odd prime d, the number γ − Re L'/L(1, χ), with γ Euler's constant and χ the Legendre
symbol modulo d. -/
def chowlaSelbergConst := .eulerMascheroniConstant - (logDeriv (entireL (@quadTwist 1 1 d _)) 1).re

variable (d n : ℕ) [NeZero n] {M : Type} [Field M] [CharZero M] {x y : M}

/-- The natural number d is a prime congruent to 7 modulo 8. -/
class PrimeSevenModEight extends Fact d.Prime where mod_eight : d % 8 = 7

attribute [local simp] neg_eq_self NeZero.ne NeZero.pos mul_pow RingOfIntegers.ext_iff
attribute [local simp ←] ofReal_pow

/-- If a number field M contains primitive roots of unity of coprime orders n and d, then its
degree over ℚ is at least φ(d)φ(n). -/
lemma totient_mul_totient_le_finrank [NeZero d] [NumberField M] (c : n.Coprime d) (hx :
  IsPrimitiveRoot x n) (hy : IsPrimitiveRoot y d) : d.totient * n.totient ≤ finrank ℚ M := by grind
  [n.totient_mul, c.lcm_eq_mul, hx.lcm_totient_le_finrank hy (cyclotomic.irreducible_rat (by simp))]

/-- The subfield K = ℚ(i√d) of ℂ. -/
def QuadField := ℚ⟮I * √d⟯

namespace QuadField

/-- The generator √−d = i√d of K = ℚ(i√d). -/
@[simps! coe] def sqrtNegD : QuadField d := AdjoinSimple.gen ..

@[local simp] lemma sqrtNegD_sq : sqrtNegD d ^ 2 = -d := by aesop

lemma isIntegral_sqrtNegD : IsIntegral ℚ (I * √d) := .of_pow two_pos (by simp [isIntegral_natCast])

instance : NumberField (QuadField d) where
  to_finiteDimensional := adjoin.finiteDimensional (isIntegral_sqrtNegD d)

instance [PrimeSevenModEight d] : Fact (d % 4 = 3) := ⟨by grind [PrimeSevenModEight]⟩

variable [h : Fact (d % 4 = 3)]

instance : NeZero d := ⟨by grind [Fact]⟩

lemma minpoly_sqrtNegD : X ^ 2 - C (-d : ℚ) = minpoly ℚ (I * √d) :=
  minpoly.eq_of_irreducible_of_monic (X_pow_sub_C_irreducible_of_prime Fact.out
  (sq_nonneg · |>.not_gt <| by simp [·])) (by simp) (by monicity!)

lemma finrank_K : finrank ℚ (QuadField d) = 2 :=
  adjoin.finrank (isIntegral_sqrtNegD d) ▸ minpoly_sqrtNegD d ▸ natDegree_X_pow_sub_C

instance : IsTotallyComplex (QuadField d) := ⟨fun _ ↦ not_isReal_iff_isComplex.1
  (by simpa [← map_pow] using sq_nonneg <| embedding_of_isReal · (sqrtNegD d))⟩

instance : Unique (InfinitePlace (QuadField d)) := ⟨⟨mk (val _).1⟩,
  (Fintype.card_le_one_iff.1 (by grind [finrank_eq_two_mul_card_infinitePlace, finrank_K]) · _)⟩

/-- For d ≡ 3 mod 4 and y with y² = −d in a field M of characteristic zero, the embedding of K =
ℚ(i√d) into M sending i√d to y. -/
def embOfSqrt (e : y ^ 2 = -d) : QuadField d →ₐ[ℚ] M :=
  (adjoin.powerBasis (isIntegral_sqrtNegD d)).lift y (by simp [minpoly_gen, ← minpoly_sqrtNegD, e])

open Subalgebra Int Algebra Ideal ZMod

/-- For a prime d ≡ 3 mod 4, the field ℚ(√−d) embeds in every field M of characteristic zero
that contains a primitive d-th root of unity (quadratic Gauss sum). -/
def nonempty_algHom_of_isPrimitiveRoot [Fact d.Prime] (hx : IsPrimitiveRoot x d) : QuadField d →ₐ[ℚ]
  M := embOfSqrt d (by rw [gaussSum_sq (MulChar.ne_one_iff.2 ⟨-1, _⟩) ((quadraticChar_isQuadratic
  _).comp (castRingHom _)) (zmodChar_primitive_of_primitive_root _ hx)] <;>
  simp [quadraticCharFun, exists_sq_eq_neg_one_iff, h.1])

@[simp] lemma four_dvd_d_add_one : 4 ∣ d + 1 := by grind [Fact]

instance : IsQuadraticExtension ℚ (QuadField d) := ⟨finrank_K d⟩

instance : IsCMField (QuadField d) := .ofCMExtension ℚ _

@[simp] lemma coe_star_eq_conj (y : QuadField d) : star y = starRingEnd ℂ y :=
  map_star_complex (QuadField d).val y

@[simp] lemma star_sqrtNegD : star (sqrtNegD d) = -sqrtNegD d := by aesop

lemma abs_norm_eq_norm_sq (x : QuadField d) : |(norm ℚ x : ℝ)| = ‖x.1‖ ^ 2 := by simpa using!
  (prod_eq_abs_norm x).symm

lemma absNorm_span_eq_mul_star (y : 𝓞 (QuadField d)) : (span {y}).absNorm = y * star y := by
  ext; simp [← coe_norm_int, ← abs_norm_eq_norm_sq, ← cast_abs, mul_conj']

/-- For d ≡ 3 mod 4, the algebraic integer (1 + √−d)/2 of K = ℚ(√−d). -/
def c₀ : 𝓞 (QuadField d) := ⟨(1 + sqrtNegD d) / 2, X ^ 2 - X + (d.succ / 4).cast, by monicity!,
  by simp; grind [sqrtNegD_sq]⟩

@[simp] lemma coe_c₀ : c₀ d = (1 + sqrtNegD d) / 2 := rfl

@[simp] lemma star_c₀ : star (c₀ d) = 1 - c₀ d := by simp; ring

lemma c₀_mul_one_sub : c₀ d * (1 - c₀ d) = ↑((d + 1) / 4) := by simp; grind [sqrtNegD_sq]

/-- For d ≡ 3 mod 4, the element √−d = i√d of the ring of integers of K = ℚ(√−d), defined as
2·(1 + √−d)/2 − 1. -/
abbrev sqrtNegDInt := 2 * c₀ d - 1

lemma sqrtNegDInt_sq : sqrtNegDInt d ^ 2 = -d := by simp [two_mul]

/-- For a prime d ≡ 7 mod 8, K = ℚ(√−d) and c₀ = (1 + √−d)/2, the different of K over ℚ is
generated by 2c₀ − 1, and ℤ[c₀] is the whole ring of integers of K. -/
lemma different_eq_span_and_adjoin_c₀ [PrimeSevenModEight d] : differentIdeal ℤ _ =
  span {sqrtNegDInt d} ∧ ℤ[c₀ d] = ⊤ := differentIdeal_eq_span_of_dvd ℚ (((
  isSimpleOrder_of_finrank (finrank_K d)).2 _).resolve_left ((·.le (subset_adjoin rfl)).mt fun ⟨_,
  e⟩ ↦ by simpa using congr(-($e + $e).1.im))) ((d.succ / 4).cast - X * (1 - X)) (by simp [
  c₀_mul_one_sub]) (by simp [two_mul, add_sub]) (dvd_differentIdeal_of_mem_sq (p :=
  d) (by simp [span_singleton_pow, sqrtNegDInt_sq]))
end QuadField
end
end

-- ═══ src/Lib/General/NumberTheory/QuadFieldSplitting.lean ═══
section
run_cmd Lean.Elab.Command.liftCoreM RHSingleFile.freshCaches  -- single-file: fresh caches, as in a separate file
/-! General lemmas of algebraic number theory (textbook or folklore).

This file: Primes and residue degrees, Frobenius on quadratic integers, lifting the exponent at 2.
Decomposition of rational primes in Q(√-d) by the Legendre symbol. -/

open Ideal FiniteField Int NumberField ZMod legendreSym Ideal.Quotient
  IsDedekindDomain.HeightOneSpectrum

variable {F} [Field F] [NumberField F] {d p : ℕ} [hp : Fact p.Prime] {R} [CommRing R] [CharP R p]
  [PrimeSevenModEight d] (h2 : p ≠ 2) (φ : 𝓞 (QuadField d) →+* R) (w : FinPlace F)

variable (F p) in
lemma FinPlace.exists_natCast_mem : ∃ w : FinPlace F, ↑p ∈ w.1 :=
  (span {(p : ℤ)}).nonempty_primesOver (S := 𝓞 F).elim
  fun ⟨P, i, ⟨e⟩⟩ ↦ ⟨⟨P, i, (by simp [·, NeZero.ne] at e)⟩, by simpa using e.le⟩

attribute [local instance] Quotient.field

lemma FinPlace.charP_quotient (h : ↑p ∈ w.1) : CharP (_ ⧸ w.1) p :=
  .of_eq_zero hp.1 (eq_zero_iff_mem.2 h)

protected lemma FinPlace.natCast_mem_iff_dvd (h : ↑p ∈ w.1) {n} :
    ↑n ∈ w.1 ↔ p ∣ n := by erw [← (w.charP_quotient h).1, eq_zero_iff_mem]

attribute [local instance] ZMod.algebra

/-- For a finite place w of a number field F above the prime p there is f with Nw = p^f, such
that x^{pⁿ} ≡ x mod w holds for all integers x of F if and only if f divides n. -/
lemma FinPlace.exists_q_eq_pow (h : ↑p ∈ w.1) : ∃ f, w.q = p ^ f ∧ ∀ n, f ∣ n ↔ ∀ x,
  Ideal.Quotient.mk w.1 x ^ p ^ n = Ideal.Quotient.mk _ x := have := w.charP_quotient h
  ⟨_, .symm (pow_finrank_eq_natCard p (_ ⧸ w.1)), by simp [AlgHom.ext_iff, mk_surjective.forall,
    ← orderOf_frobeniusAlgHom, coe_frobeniusAlgHom, orderOf_dvd_iff_pow_eq_one]⟩

lemma QuadField.map_sqrtNegDInt_sq :
  φ (sqrtNegDInt d) ^ 2 = -d := by simp [↓← map_pow, sqrtNegDInt_sq]

omit [Fact p.Prime] in
/-- For a prime d ≡ 7 mod 8, χ_K(p) = 1 when p = 2: the Legendre symbol (2/d) is 1, that is, 2
splits in K = ℚ(√−d). -/
lemma QuadField.chiK_two : p = 2 →
  chiK d p = 1 := by grind [chiK_eq_legendreSym, PrimeSevenModEight, at_two, χ₈_nat_eq_if_mod_eight]

lemma QuadField.legendreSym_eq_pow_of_sq_eq_neg (h2 : p ≠ 2) {x : R} (e : x ^ 2 = -d) : chiK d p =
  x ^ (p - 1) := by simpa [*, chiK_eq_legendreSym, neg_one_pow_eq_ite,
  quadratic_reciprocity' h2, neg_pow (d : R), pow_mul, ← p.two_mul_odd_div_two,
  hp.1.mod_two_eq_one_iff_ne_two, (by grind [PrimeSevenModEight] : d ≠ 2 ∧ Odd (d / 2))
  ] using congr((-1) ^ (p / 2) * (cast $(eq_pow p d) : R))

include h2 in
/-- Let d be a prime ≡ 7 mod 8, p an odd prime, φ : 𝓞_K → R a ring map to characteristic p, ε =
(1 + √−d)/2. Then x = φ(ε)^{p^n} if and only if 2x − 1 = (p/d)^n (2φ(ε) − 1). -/
lemma QuadField.eq_map_c₀_pow_iff n x : x = φ (c₀ d) ^ p ^ n ↔ 2 * x - 1 =
  chiK d p ^ n * φ (sqrtNegDInt d) := by
  rw [show _ * φ _ = φ (sqrtNegDInt d) ^ p ^ n by induction n <;> simp_all [pow_succ', pow_mul,
    mul_assoc, ← iterateFrobenius_def, ← pow_sub_one_mul hp.1.ne_zero,
    ← legendreSym_eq_pow_of_sq_eq_neg h2 (map_sqrtNegDInt_sq φ), -map_sub]]
  simp [← iterateFrobenius_def, IsUnit.mul_right_inj, map_ofNat, *, CharP.isUnit_ofNat_iff,
    p.prime_dvd_prime_iff_eq, Fact.out]

/-- The number q: p² if (p/d) = −1, and p otherwise. -/
abbrev primeNorm (d p : ℕ) [Fact d.Prime] := ite (chiK d p = -1) (p ^ 2) p

/-- The number ρ_p: 1/(p² − 1) if (p/d) = −1, 1/(2(p − 1)) if p = d, and 1/(p − 1) otherwise. -/
noncomputable def nonsplitWeight (d p : ℕ) [Fact d.Prime] : ℝ :=
  (1 + chiK d p ^ 2) / 2 / (primeNorm d p - 1)

lemma chiK_cases (d p : ℕ) [hp : Fact p.Prime] [Fact d.Prime] :
    p = d ∧ chiK d p = 0 ∨ p ≠ d ∧ (chiK d p = 1 ∨ chiK d p = -1) := by
  simp [chiK, quadraticCharFun]; grind [prime_ne_zero, natCast_self d]

variable {q : ℤ} {o s d p : ℕ} [Fact (d % 4 = 3)] [hp : Fact p.Prime] (w : FinPlace (QuadField d))

/-- If q is an integer, o is a nonzero natural number and q^o ≡ 1 mod 2^(s+1), then 2^s divides
(q − 1)o or (q + 1)o. -/
lemma two_pow_dvd_or_of_pow_eq_one (ho : 0 < o) (h : (q : ZMod (2 ^ (s + 1))) ^ o = 1) :
    2 ^ s ∣ (q - 1) * o ∨ 2 ^ s ∣ (q + 1) * o := by
  have := (intCast_eq_intCast_iff_dvd_sub 1 (q ^ (o * 2)) (2 ^ s.succ)).1 (by simp [h, pow_mul])
  cases (by grind [even_pow, → Even.trans_dvd] : 4 ∣ q - 1 ∨ 4 ∣ q - -1) <;>
    have := two_pow_sub_pow' (o * 2) ‹_› (by lia) <;> simp_all [pow_dvd_iff_le_emultiplicity,
    emultiplicity_mul prime_two, ← add_assoc, finiteMultiplicity_iff]

/-- If q is an integer with |q| > 1, o is a nonzero natural number and q^o ≡ 1 mod 2^(s+1), then
2^s ≤ (|q| + 1)·o. -/
lemma two_pow_le_of_pow_eq_one (h1 : 1 < q.natAbs) {o s} (ho : 0 < o) (h : (q : ZMod (2 ^ (s + 1)))
  ^ o = 1) : 2 ^ s ≤ (q.natAbs + 1) * o := by cases two_pow_dvd_or_of_pow_eq_one ho h <;> zify <;>
  apply (le_abs_of_dvd _ ‹_›).trans <;> simp [*] <;> grind

/-- Let d be a prime ≡ 7 mod 8 and w a prime of K = ℚ(√−d) above the rational prime p. Then w
has absolute norm p if and only if the Legendre symbol (p/d) is not −1. -/
lemma QuadField.q_eq_iff_legendreSym_ne_neg_one (hw : ↑p ∈ w.1) [PrimeSevenModEight d] : w.q = p ↔
  chiK d p ≠ -1 := by
  obtain ⟨c, ⟨⟩⟩ := w.charP_quotient hw, w.exists_q_eq_pow hw, chiK_cases d p
  simp [*, hp.1.pow_eq_iff, ← Nat.dvd_one]
  apply Iff.trans ⟨(· (c₀ d)), fun _ ↦
    (by induction (different_eq_span_and_adjoin_c₀ d).2.ge (x := ·) ⟨⟩ using
    Algebra.adjoin_induction <;> simp_all [← frobenius_def])⟩
  obtain rfl | h := eq_or_ne p 2
  grind [chiK_two rfl, PrimeSevenModEight, c.1, congr(Ideal.Quotient.mk w $(c₀_mul_one_sub d)),
    map_natCast]
  erw [← pow_one p, eq_comm, eq_map_c₀_pow_iff h, eq_comm, mul_left_eq_self₀, ← sq_eq_zero_iff,
    map_sqrtNegDInt_sq]
  aesop (add simp [_root_.neg_one_eq_one_iff, ringChar.eq, (c.1), Nat.dvd_prime, Fact.out])

/-- Let d ≡ 3 mod 4 and let w lie above the prime p in K = ℚ(√−d). For some J the primes above p
are w and J, and either J = w, Nw = p², or Nw = NJ = p, (p) = wJ. -/
lemma QuadField.prime_inert_or_eq_mul (hw : ↑p ∈ w.1) : ∃ J, (∀ u, ↑p ∈ u.1 ↔ u = w ∨ u = J) ∧
    (w = J ∧ w.q = p ^ 2 ∨ w.q = p ∧ J.q = p ∧ span {↑p} = w.1 * J.1) :=
    (dvd_span_singleton.2 hw).elim fun J _ ↦ by by_cases J = ⊤
  <;> (have := by simpa [*, ← Nat.cast_mul, sq p ▸ hp.1.mul_eq_prime_sq_iff, w.2.1]
    using absNorm_span_eq_mul_star d p) <;> [use w; use (ofPrime (irreducible_of_irreducible_absNorm
  (this.2 ▸ hp.1)).prime)] <;> generalize_proofs <;> simp_all [← dvd_span_singleton, prime, ofPrime,
  sq, Prime.dvd_mul, prime_dvd_prime_iff_eq, IsDedekindDomain.HeightOneSpectrum.ext_iff]
end

-- ═══ src/Lib/Analytic/Landau/PolarLandau.lean ═══
section
run_cmd Lean.Elab.Command.liftCoreM RHSingleFile.freshCaches  -- single-file: fresh caches, as in a separate file
/-! Known result: Landau's lemma on Dirichlet integrals of one sign. The form here allows real
simple poles of non-negative residue. It concludes that no pole lies right of the exponent of the
one-sided bound. Source: Montgomery and Vaughan, Multiplicative Number Theory I, 2007, Lemma 15.1
(Widder, The Laplace Transform, 1941, II Thm 5b).

This file: Landau's lemma for one-sided bounds; Laplace transforms of
powers; logarithmic derivatives of
L-functions. -/

open ArithmeticFunction DirichletCharacter Complex Set Filter MeasureTheory Metric ProbabilityTheory
  Nat Topology ComplexOrder AnalyticOnNhd Real Calc


variable {N} (χ : DirichletCharacter ℂ N) (d : ℕ) [Fact d.Prime]

/-- For a Dirichlet character χ mod N, a prime d and every integer n, the character `quadTwist` χ d
mod Nd takes at n the value χ(n)·(n/d), where (n/d) is the Legendre symbol. -/
lemma quadTwist_apply (n : ℤ) : quadTwist χ d n = χ n * legendreSym d n :=
  show _ = _ * (chiK d).ringHomComp (algebraMap ..) n by  grind [quadTwist, MulChar.mul_apply,
  changeLevel_eq_cast_of_dvd', apply_eq_zero_iff, IsCoprime.mul_right]

/-- For a Dirichlet character χ mod N and an odd prime d coprime to N, the twist of χ by the
Legendre symbol (·/d), a character mod Nd, is not principal. -/
lemma quadTwist_ne_one (hd : d ≠ 2) (h : N.Coprime d) : quadTwist χ d ≠ 1 :=
  (quadraticChar_exists_neg_one (ZMod.ringChar_zmod_n d ▸ hd)).elim fun a _ e ↦ (chineseRemainder
  h 1 a.val).rec fun n _ ↦ by obtain := quadTwist_apply χ d n, (quadTwist χ d).mul_apply 1 n
                              simp_all [legendreSym, ← ZMod.natCast_eq_natCast_iff, neg_eq_self]

/-- E is measurable, O(e^v) on v ≥ 0; ∫₀^∞ E(v)e^{(1−s)v} dv continues from re s > 2 to a
meromorphic Φ with (s − 1)Φ(s) analytic on re s ≥ 1 and at most simple poles, of residue r(ρ), in re
ρ > 0. As (s − 1)Φ(s) takes the value 0 at s = 1, this allows no pole of Φ at 1. -/
def IsPolar (E : ℝ → ℝ) (r : ℂ → ℂ) := Measurable E ∧ ∃ C Φ, Meromorphic Φ ∧ (∀ v ≥ 0, |E v| ≤ C *
  v.exp) ∧ (∀ s, 2 < re s → Φ s = ∫ v in Ioi 0, E v * ((1 - s) * v).exp) ∧ AnalyticOnNhd ℂ (fun s ↦
  (s - 1) * Φ s) {s | 1 ≤ s.re} ∧ ∀ ρ, 0 < ρ.re → (𝓝[≠] ρ).Tendsto (fun z ↦ (z - ρ) * Φ z) (𝓝 (r ρ))

variable {E : ℝ → ℝ} [NeZero N] {s : ℂ}

lemma integrableOn_laplace_of_abs_le {C} (m : Measurable E) (h : ∀ v ≥ 0, |E v| ≤ C * v.exp) (hs :
  2 < s.re) : IntegrableOn (fun v ↦ E v * ((1 - s) * v).exp) (Ioi 0) := ((integrableOn_exp_mul_Ioi
  (sub_neg.2 hs) 0).const_mul C).mono' (by fun_prop) (ae_restrict_of_forall_mem (by simp) (by
  simp_intro ..; grw [h, mul_assoc, ← Real.exp_add] <;> grind))

/-- Laplace transform of a power: for complex s with re s > 0 and every natural number k, ∫₀^∞
t^k e^{−st} dt = k!/s^{k+1}. -/
lemma laplace_pow (h : (-s).re < 0) k : ∫ t : ℝ in Ioi 0, t ^ k * exp (-s * t) = k ! / s ^ (k + 1)
  := (iteratedDeriv_complexMGF (interior_maximal (@integrableOn_exp_mul_Ioi · · 0) isOpen_Iio h) _ ▸
  EqOn.iteratedDeriv_of_isOpen (@integral_exp_mul_complex_Ioi · · 0) (isOpen_re_lt 0) k h).trans (by
 simp [neg_div, iteratedDeriv_eq_iterate, zpow_sub₀ (h.ne ∘ congr rfl), neg_pow s, pow_succ, field])

@[fun_prop] lemma analyticAt_entireL s : AnalyticAt ℂ (entireL χ) s := Differentiable.analyticAt (by
  grind [entireL, differentiable_LFunctionTrivChar₁, differentiable_LFunction]) s

lemma entireL_ne_zero (hs : 1 ≤ s.re) : entireL χ s ≠ 0 := by
  rw [entireL]; grind [LFunction_ne_zero_of_one_le_re, LFunctionTrivChar₁_apply_one_ne_zero]

lemma LSeriesHasSum_mul_vonMangoldt (hs : 1 < s.re) :
  LSeriesHasSum (fun n ↦ χ n * Λ n) s (ite (χ = 1) 1 0 / (s - 1) - logDeriv (entireL χ) s) :=
  LSeriesHasSum_iff.2 ⟨χ.LSeriesSummable_twist_vonMangoldt hs, by erw [entireL,
  logDeriv_apply, LSeries_twist_vonMangoldt_eq] <;> grind [LFunction_ne_zero_of_one_le_re, one_re,
  deriv_LFunctionTrivChar₁_apply_of_ne_one, LFunction_eq_LSeries, deriv_LFunction_eq_deriv_LSeries]⟩

lemma tendsto_sub_mul_logDeriv_entireL : (analyticOrderNatAt (entireL χ) s = 0 ↔ entireL χ s ≠ 0) ∧
  Tendsto (fun z ↦ (z - s) * logDeriv (entireL χ) z) (𝓝[≠] s) (𝓝 (analyticOrderNatAt (entireL χ)
  s + 0)) := have ⟨g, a, b, e⟩ := (analyticAt_entireL ..).analyticOrderAt_ne_top.1 (entireL_ne_zero
    χ le_rfl congr($((analyticOrderAt_eq_top_iff_eq_zero s (by fun_prop)).1 ·) 1))
  ⟨by simp [e.eq_of_nhds, b], .congr' (mem_inf_principal.2 (by
    filter_upwards [e.deriv, e, a.continuousAt.eventually_ne b, a.eventually_analyticAt]
    cases analyticOrderNatAt (entireL χ) s <;> simp +contextual (disch := fun_prop) [logDeriv,
      field]
    grind)) (.const_add _ (.trans_eq (tendsto_inf_left (.mul (.sub_const le_rfl s)
  (a.deriv.div a b).continuousAt)) (by simp)))⟩

/-- Removable singularity: if s ↦ (s − a)Ψ(s), with value 0 at a, is analytic on the disc of
radius ε about z, a ≠ z, and a, σ lie in that disc, then the Taylor series of Ψ at z
converges at σ. -/
lemma summable_taylor_of_removable {Ψ ε} {a z : ℂ} σ (D :
  AnalyticOnNhd ℂ (fun z ↦ (z - a) * Ψ z) (ball z ε)) (u : z ≠ a ∧ a ∈ ball z ε ∧ σ ∈ ball z ε) :
  Summable fun k ↦ (k ! : ℂ)⁻¹ • (σ - z) ^ k • iteratedDeriv k Ψ z := (hasSum_taylorSeries_on_ball
  ((differentiableOn_dslope (isOpen_ball.mem_nhds u.2.1)).2 D.differentiableOn) u.2.2
  ).summable.congr (by erw [(eqOn_dslope_sub_smul ..).iteratedDeriv_of_isOpen isOpen_ne · u.1])

/-- Landau's lemma. Let E satisfy `IsPolar` with residues r, and let β > 0. If re r(x) ≥ 0 for
all real x > β and E(v) ≤ e^{(β−1)v} for large v, then r(ρ) = 0 whenever re ρ > β.

Known result: Landau's lemma on Dirichlet integrals of one sign. -/
lemma IsPolar.landau {r} (h : IsPolar E r) {β : ℝ} (hβ : 0 < β) (hr : ∀ x, β < x → 0 ≤ (r x).re)
    (hw : ∀ᶠ v in atTop, E v ≤ ((β - 1) * v).exp) {ρ} (hρ : β < ρ.re) : r ρ = 0 := by
  obtain ⟨⟨m, C, Φ, M, hC, e, -, h⟩, Y, hY⟩ := h, eventually_atTop.1 hw
  let K := 1 ⊔ |C| * Y.exp ^ 2
  let μ := (volume.restrict (Ioi 0)).withDensity fun v ↦ (K * (β * v).exp - E v * v.exp).toNNReal
  let S := integrableExpSet (-|·|) μ; let Ψ s := K / (s - β) - Φ s
  have e s (u : 2 < s.re) (w : β - s.re < 0) : s.re ∈ S ∧ complexMGF (-|·|) μ s = Ψ s := by
    obtain ⟨i, j⟩ := (@integrableOn_exp_mul_complex_Ioi (β - s) w 0).const_mul K,
      integrableOn_laplace_of_abs_le m hC u
    refine ⟨((integrable_withDensity_iff_integrable_coe_smul (by fun_prop)).2 ((i.sub j).congr ?q)
      ).norm.congr (by simp), (integral_withDensity_eq_integral_smul (by fun_prop) _).trans (
      integral_congr_ae ?q ▸ by simp [integral_sub i j, integral_exp_mul_complex_Ioi, w]; grind)⟩
    filter_upwards [ae_restrict_mem (by simp)] with v u
    rw [coe_toNNReal, abs_of_pos u]
    simp [sub_mul, mul_assoc, ← Complex.exp_add]; rfl
    cases le_total Y v <;> [grw [hY, sub_mul, Real.exp_sub]; grw [le_of_abs_le (hC ..),
      ← one_le_exp]] <;> simp [field, *, u.out.le] <;> bound
  have H ρ u := ((ContinuousWithinAt.tendsto (by fun_prop (disch := aesop))).sub (h ρ
    (hβ.trans u))).congr fun z ↦ (.symm (mul_sub ..) : _ = _ * Ψ z)
  obtain ⟨a, ha⟩ := exists_isLUB (Sᶜ.insert_nonempty β) ⟨2 + β, (by grind [e ⟨·, 0⟩])⟩
  obtain ⟨A, T⟩ := interior_maximal (fun x ↦ (·.not_ge.imp_symm (ha.1 <| .inr ·))) isOpen_Ioi,
    ((hasDerivAt_id' a).ofReal_comp.tendsto_nhdsNE one_ne_zero).mono_left (nhdsGT_le_nhdsNE a)
  obtain ⟨N : Meromorphic Ψ, G⟩ := fun _ ↦ by fun_prop, analyticOnNhd_complexMGF.mono (@A ·.re)
  have I {ρ} hρ := eventuallyEq_iff_sub.2 <| meromorphicOrderAt_eq_top_iff.1 <| ((
   N.meromorphicOn.fun_sub G.meromorphicOn).meromorphicOrderAt_ne_top_of_isPreconnected (x := ρ)
   (convex_halfSpace_re_gt a).isPreconnected hρ (by grind : a < re ⟨a ⊔ β + 3, 0⟩)).mtr <|
   meromorphicOrderAt_eq_top_iff.2 (mem_nhdsWithin.2 ⟨_, isOpen_re_gt (2 + β), by clear hr; grind⟩)
  obtain rfl | p := (ha.1 (.inl rfl)).eq_or_lt
  simpa using tendsto_nhds_unique ((H ρ hρ).congr' (I hρ).mul_left)
    (tendsto_inf_left (.mul (.sub_const le_rfl ρ) (G _ hρ).continuousAt))
  have J := (T.eventually (N a).eventually_analyticAt).mp (mem_inf_of_right
    fun z u B ↦ (B.frequently_eq_iff_eventually_eq (G _ u)).1 (I u).frequently)
  obtain ⟨ε, o, D⟩ := (MeromorphicAt.analyticAt (by fun_prop) (continuousWithinAt_compl_self.1
    ((H a p).trans_eq congr(𝓝 $((ge_of_tendsto ((H a p).comp T) (J.mp (mem_inf_of_right fun z u B ↦
    by simp [B.self_of_nhds, complexMGF_ofReal, mul_nonneg, u.out.le, mgf_nonneg]))).eq_of_not_lt'
    (·.1.not_ge (by simp_all))))))).exists_ball_analyticOnNhd
  obtain ⟨z, J, w, g⟩ := (J.and (Ioo_mem_nhdsGT (by bound : a < ε / 2 + a))).exists
  obtain ⟨⟨σ, n, v⟩, _⟩ := ha.exists_between (max_lt p (sub_left_lt_of_lt_add g)),
    integrable_pow_mul_exp_of_mem_interior_integrableExpSet (A w)
  use n.elim (by order) <| absurd ⟨by fun_prop, (((lintegral_tsum (by fun_prop)).trans (tsum_congr
   fun k ↦ ?_)).trans_lt
    ((summable_taylor_of_removable σ (D.mono (ball_half_subset ↑z ?_)) ?_).mapL reCLM
   ).tsum_ofReal_lt_top).trans_le' <| lintegral_mono fun y ↦ ((NormedSpace.exp_series_hasSum_exp'
   (𝕂 := ℝ) ((σ - z) * -|y|)).mul_right (z * -|y|).exp).tsum_eq.trans ?_ ▸ enorm_tsum_le_tsum_enorm⟩
  rw [EventuallyEq.iteratedDeriv_eq k J, iteratedDeriv_complexMGF]
  simp_rw [← integral_smul, smul_eq_mul, ← ofReal_natCast, mul_pow, mul_assoc]
  rw_mod_cast [← ofReal_integral_norm_eq_lintegral_enorm (by fun_prop)]
  all_goals simp [← mul_pow, ← mul_assoc, ← neg_mul, dist_eq_norm, ← ofReal_sub,
    ← exp_eq_exp_ℝ, ← Real.exp_add]; clear e H; grind
end

-- ═══ src/New/Endgame/PrimeError.lean ═══
section
run_cmd Lean.Elab.Command.liftCoreM RHSingleFile.freshCaches  -- single-file: fresh caches, as in a separate file
/-! The remainder `primeError` written as an exact finite prime sum. For an integer a and 0 < z ≤ a,
the normalised error at z in the class 1 mod M equals the sum over ν ≤ a, ν ≡ 1, of
Λ(ν)(1−χ_K(ν))(a/ν − a/z)₊, divided by a, less log z/φ(M) and a constant. This standard rewriting of
a weighted prime sum in a residue class as an exact finite identity turns the divisibility sums
∑ λ(ν)(a/ν − a/z)₊ over ν ≤ a into `primeError` at a single z ≤ a. Related work: Davenport,
Multiplicative Number Theory.

Part of: One-sided bound for non-split primes gives a zero-free half-plane (see
New.Endgame.OneSidedCriterion).

This file: Weighted non-split prime sums; their Mellin transform has poles at zeros of
L-functions. -/

noncomputable section

open ArithmeticFunction DirichletCharacter Complex Finset Filter MeasureTheory Nat Real vonMangoldt


variable (d : ℕ) [Fact d.Prime] (M : ℕ)

/-- The weight λ(ν) = Λ(ν)(1 − (ν/d)) for ν ≡ 1 mod M, and 0 otherwise; Λ is von Mangoldt's
function and (ν/d) the Legendre symbol. -/
def lambdaClass ν := @residueClass M 1 ν * (1 - chiK d ν)

/-- The sum y^{−r} ∑_{1≤ν≤y} λ(ν) ν^{r−1}, with λ = `lambdaClass`: for r = 0 it is ∑ λ(ν)/ν, for r
= 1 it is y⁻¹ ∑ λ(ν). -/
def lambdaSum r y := (∑ k ∈ Icc 1 ⌊y⌋₊, lambdaClass d M k / k * k ^ r) / y ^ r

/-- The function φ(M)⁻¹(∑_ξ (L̃′/L̃(s, ξ·(·/d)) − L̃′/L̃(s, ξ)) − 1), summed over the characters
ξ mod M, where L̃ is `entireL`. -/
def logDerivMean [NeZero M] s :=
  (∑ ξ, (logDeriv (entireL (quadTwist ξ d)) s - logDeriv (@entireL M _ ξ) s) - 1) / φ M

/-- The remainder R_M(x) = ∑_{ν≤x} λ(ν)(1/ν − 1/x) − log x/φ(M) − Re `logDerivMean`(1), where λ(ν)
= Λ(ν)(1 − (ν/d)) for ν ≡ 1 mod M, else 0. -/
def primeError [NeZero M]
    x := lambdaSum d M 0 x - lambdaSum d M 1 x - x.log / φ M - (logDerivMean d M 1).re

lemma lambdaClass_nonneg_and_abs_le ν : 0 ≤ lambdaClass d M ν ∧ |lambdaClass d M ν| ≤ 2 * ν := by
  simp [lambdaClass, chiK, Set.indicator, quadraticCharFun, sub_ite]
  grind [vonMangoldt_nonneg, vonMangoldt_le_log, Real.log_le_self]

lemma abs_lambdaSum_exp_le r v : |lambdaSum d M r (rexp v)| ≤ 2 * rexp v := by
  grw [lambdaSum, abs_div, abs_sum_le_sum_abs, sum_le_card_nsmul _ _ (2 * v.exp ^ r)] <;> simp
    +contextual [abs_div, le_floor_iff, exp_nonneg, mul_le_mul, div_le_of_le_mul₀, field,
    lambdaClass_nonneg_and_abs_le, pow_le_pow_left₀, floor_le]

/-- For a prime d, the real part of `logDerivMean` for modulus M = 1 at s = 1 is −1 − ℓ, where ℓ =
`chowlaSelbergConst` d = γ − Re L′/L(1, (·/d)) and γ is Euler's constant. -/
lemma re_logDerivMean_one : (logDerivMean d 1 1).re = -1 - chowlaSelbergConst d := by
  simp [logDerivMean, chowlaSelbergConst, logDeriv, level_one, show @entireL 1 _ 1 = riemannZeta₁ by
    simp_all [entireL, Function.update_eq_iff, riemannZeta_eq_inv_sub_mul]]; ring

variable [NeZero M] {d M}

/-- For 0 < z ≤ A, `primeError d M z` in terms of the sum ∑_{ν ≤ A} λ(ν)(A/ν − A/z)⁺, where λ is
`lambdaClass d M`. -/
lemma primeError_eq_sum (A : ℕ) {z : ℝ} (u : 0 < z) (h : z ≤ A) : primeError d M z = ∑ ν ∈ Icc 1 A,
  lambdaClass d M ν * (A / ν - A / z)⁺ / A - z.log / φ M - re (logDerivMean d M 1) := by
  have := u.trans_le h
  simp [primeError, lambdaSum, sum_div, ← sum_sub_distrib]; apply sum_congr_of_eq_on_inter <;>
    simp +contextual [le_floor_iff u.le, field] <;> rify <;> grind

/-- For d ≡ 7 mod 8 prime to M, v ↦ R_M(e^v) is polar (`IsPolar`) with residue at s equal to
∑_ξ (ord_s L̃(ξ) − ord_s L̃(ξ(·/d))) / (φ(M) s(1 − s)), ξ over the characters mod M, L̃ =
`entireL`. -/
lemma isPolar_primeError (hd : d % 8 = 7) (h : M.Coprime d) : IsPolar (primeError d M ·.exp) fun s ↦
    (∑ ξ, (analyticOrderNatAt (@entireL M _ ξ) s - analyticOrderNatAt (entireL (quadTwist ξ d))
  s : ℂ)) / φ M / (s * (1 - s)) := by
  let κ := (logDerivMean d M 1).re
  have A : AnalyticOnNhd ℂ (fun s ↦ logDerivMean d M s / s - κ) {s | 1 ≤ s.re} := fun _ _ ↦ by
    fun_prop (disch := grind [entireL_ne_zero, zero_re]) [logDerivMean, logDeriv]
  refine ⟨by fun_prop [primeError, lambdaSum], |κ| + 5, fun s ↦ (logDerivMean d M s / s - κ) /
    (s - 1), fun _ ↦ by fun_prop [logDerivMean], fun v a ↦ (abs_sub ..).trans ?_, ?q,
  -- real on `(2, ∞)`, hence at `1`
  have := @ext _ 0 (by simp [κ]) ((A.mono (by aesop)
    ).im_ofReal.eqOn_zero_of_preconnected_of_eventuallyEq_zero isPreconnected_Ici (by simp) (.mono
    (lt_mem_nhds (lt_add_one _)) fun x u ↦ congr(im $((div_eq_iff (by aesop)).1 (?q x u))).trans
    (by norm_cast)) (le_refl (1 : ℝ)))
  ⟨?B, fun ρ _ ↦ have I := (@continuousWithinAt_id _ _ {ρ}ᶜ ρ).sub_const
    if e : 1 = ρ then e ▸ .trans_eq (tendsto_inf_left (?B 1 (by simp)).continuousAt) (by simp) else
    by convert ((((((tendsto_finsetSum ⊤ fun ξ _ ↦ (tendsto_sub_mul_logDeriv_entireL (@quadTwist M ξ
      d _)).2.sub (tendsto_sub_mul_logDeriv_entireL ξ).2).sub (I ρ)).div_const (φ M)).div
      (I 0) ?_).sub ((I ρ).mul_const ↑κ)).div
      (I 1) ?_) using 2 <;> simp [logDerivMean, ← mul_sum] <;> grind [zero_re]⟩⟩
  grw [abs_sub, v.log_exp, ← @NeZero.one_le (φ _), add_mul,
    ← le_mul_of_one_le_right] <;> grind [add_one_le_exp, abs_lambdaSum_exp_le]
  intro s u
  have L := @laplace_pow (s - 1) (by simp [u.trans'])
  have e r : (s + r - 1) * ∫ v in _, lambdaSum d M r (rexp v) * (v - s * v).exp = _ := .trans (by
    congr 1; convert integral_comp_exp_Ioi _ 0 <;> simp [lambdaSum, field, cpow_add, cpow_neg,
      le_of_lt,
    Complex.exp_sub, cpow_def _ s, Complex.log_exp, mul_comm s, pi_pos]) ((@LSeries_eq_mul_integral'
    _ (1 + r) (by bound) _ (by simp; bound) (.of_bound 2 (.mono (Ioi_mem_atTop 0) fun n _ ↦ by
    simpa [lambdaSum, *, div_le_iff₀, abs_div, rpow_add, field, lambdaClass_nonneg_and_abs_le,
      Real.exp_log, abs_of_nonneg] using abs_lambdaSum_exp_le d M r (.log n)))).symm.trans
    (((LSeriesHasSum.sum (S := ⊤) fun ξ _ ↦ (@LSeriesHasSum_mul_vonMangoldt M ξ _ s (by bound)).sub
    (LSeriesHasSum_mul_vonMangoldt (quadTwist ξ d) (by bound))).div_const (φ M)).congr_fun
    fun n ↦ by by_cases n = 0 <;> simp [*, cpow_sub, field, cpow_add, lambdaClass,
    chiK_eq_legendreSym, residueClass_apply, mod_cast (quadTwist_apply · d n), ← sum_mul]).tsum_eq)
  obtain := L 0, L 1, Integrable.of_integral_ne_zero ((L 0).trans_ne (by aesop)),
    Integrable.of_integral_ne_zero ((L 1).trans_ne (by aesop)),
    fun r ↦ integrableOn_laplace_of_abs_le
    (by fun_prop [lambdaSum]) (fun v _ ↦ abs_lambdaSum_exp_le d M r _) u
  simp [primeError, κ, IntegrableOn, sub_mul, div_eq_inv_mul, logDerivMean, mul_assoc,
    quadTwist_ne_one _ d (by lia) h] at *
  simp (disch := fun_prop) [integral_sub, *]
  linear_combination (norm := field (disch := grind [zero_re, one_re])) e 1 / s - e 0 / (s - 1)
  grind [ofReal_one]
end
end

