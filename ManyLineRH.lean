section
run_cmd Lean.Elab.Command.liftCoreM RHSingleFile.freshCaches  -- single-file: fresh caches, as in a separate file
attribute [local simp] Matrix.one_apply Matrix.conjTranspose_fromCols_eq_fromRows_conjTranspose Matrix.conjTranspose_fromRows_eq_fromCols_conjTranspose Matrix.fromCols_mul_fromRows Matrix.fromCols_mul_fromBlocks Matrix.fromBlocks_mul_fromRows Matrix.fromCols_map Matrix.fromRows_map Matrix.fromBlocks_multiply Matrix.fromBlocks_conjTranspose Matrix.fromBlocks_map  -- from Lib.General.Groups.ValuationPair
