H^n(Q, V⊗Φ). -/
lemma one_tmul_eq_zero_of_tensorPush {Φ : _ ⥤ ModuleCat S} [Algebra S V] [Algebra V A] [Algebra S A]
  [IsScalarTower S V A] [Flat V A] (x : H (relFreeAbOfHom φ) (moduleCoeff (Φ ⋙ tensorWith V V)) n)
