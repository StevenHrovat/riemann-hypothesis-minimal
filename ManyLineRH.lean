  stdLattice.semichar (fun q ↦ y (.inl q.2, Prod.fst q)) ^ 2 • arrowProduct (finHeisOp _ (fun q ↦
  normNegOne.1.1 * star (y (.inl q.2, q.1))) f) (finHeisOp _ (fun q ↦ y (.inr q.1, q.2)) f') := by
  simp [finHeisOp]; erw [Std.apply_finVec]; congr
