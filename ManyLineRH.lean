  have K := AgreeModEps.ringChar_smul_and_smul_eq_zero hq (y := z₀.levelPoints l ≫ μ - z.levelPoints
    l) fun _ _ t ↦ by simp [hq.levelPoints_eq_pullSection, ← hq₀.levelPoints_eq_pullSection,
