variable {E r n N m a l} [Field E] [CMType E] [Fintype r] [Fintype n] [Fintype N] [Fintype m]
  [Fintype a] [Fintype l] {O : AuxPair E r n} {z} (V : DividedSplitting N m a O z) {p}
